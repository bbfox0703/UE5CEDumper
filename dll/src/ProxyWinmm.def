    auxGetNumDevs                 = f14 @17
    auxGetVolume                  = f15 @18
    auxOutMessage                 = f16 @19
    auxSetVolume                  = f17 @20
    joyConfigChanged              = f18 @21
    joyGetDevCapsA                = f19 @22
    joyGetDevCapsW                = f20 @23
    joyGetNumDevs                 = f21 @24
    joyGetPos                     = f22 @25
    joyGetPosEx                   = f23 @26
    joyGetThreshold               = f24 @27
    joyReleaseCapture             = f25 @28
    joySetCapture                 = f26 @29
    joySetThreshold               = f27 @30
    mciDriverNotify               = f28 @31
