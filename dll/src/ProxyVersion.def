; ============================================================
; ProxyVersion.def — Module definition for version.dll proxy
;
; Maps exported names to internal Proxy_* implementations.
; This avoids compile-time conflicts with winver.h declarations
; while still exporting the correct symbols for DLL hijacking.
;
; UE5_* exports are listed explicitly so CE's getAddress() finds
; them by name.  (They are ALSO reachable because /DEF: merges
; with __declspec(dllexport) rather than suppressing it -- the
; shipped binary exports ~76 names while this file lists 49.)
;
; THE @ORDINALS ARE MANDATORY, NOT DECORATION. link.exe hands
; unpinned exports out in name-sorted order starting at
; (highest PINNED ordinal + 1) -- so with nothing pinned, the
; nine GetFileVersionInfo* names took @1..@9 alphabetically by
; luck and our UE5_* block took @10..@17, sitting exactly on
; VerFindFileA/W, VerInstallFileA/W, VerLanguageNameA/W and
; VerQueryValueA/W.  An ordinal import of any of those eight did
; not fail; it called one of ours, with the wrong signature.
;
; Name coverage here was already complete, so only the pins are
; new.  The source order below is NOT ordinal order -- these are
; the measured real ordinals, deliberately not renumbered into
; sequence, so this list stays diffable against the .cpp.
; tools/check_proxy_exports.py re-derives every one of them
; against the real System32 export table.  (Audit PX1.)
; ============================================================

LIBRARY version
EXPORTS
    ; --- Windows version.dll forwarding (export = impl @ real-ordinal) ---
    GetFileVersionInfoA         = Proxy_GetFileVersionInfoA         @1
    GetFileVersionInfoW         = Proxy_GetFileVersionInfoW         @9
    GetFileVersionInfoSizeA     = Proxy_GetFileVersionInfoSizeA     @5
    GetFileVersionInfoSizeW     = Proxy_GetFileVersionInfoSizeW     @8
    GetFileVersionInfoExA       = Proxy_GetFileVersionInfoExA       @3
    GetFileVersionInfoExW       = Proxy_GetFileVersionInfoExW       @4
    GetFileVersionInfoSizeExA   = Proxy_GetFileVersionInfoSizeExA   @6
    GetFileVersionInfoSizeExW   = Proxy_GetFileVersionInfoSizeExW   @7
    GetFileVersionInfoByHandle  = Proxy_GetFileVersionInfoByHandle  @2
    VerQueryValueA              = Proxy_VerQueryValueA              @16
    VerQueryValueW              = Proxy_VerQueryValueW              @17
    VerFindFileA                = Proxy_VerFindFileA                @10
    VerFindFileW                = Proxy_VerFindFileW                @11
    VerInstallFileA             = Proxy_VerInstallFileA             @12
    VerInstallFileW             = Proxy_VerInstallFileW             @13
    VerLanguageNameA            = Proxy_VerLanguageNameA            @14
    VerLanguageNameW            = Proxy_VerLanguageNameW            @15

    ; --- UE5 Dumper C ABI exports (for CE Lua getAddress) ---
    UE5_Init
    UE5_Shutdown
    UE5_GetVersion
    UE5_AutoStart
    UE5_GetGObjectsAddr
    UE5_GetGNamesAddr
    UE5_GetObjectCount
    UE5_GetObjectByIndex
    UE5_GetObjectName
    UE5_GetObjectFullName
    UE5_GetObjectClass
    UE5_GetObjectOuter
    UE5_FindObject
    UE5_FindClass
    UE5_WalkClassBegin
    UE5_WalkClassGetField
    UE5_WalkClassEnd
    UE5_ResolveFName
    UE5_SetObjectDecryption
    UE5_GetFieldBoolMask
    UE5_GetFieldStructClass
    UE5_GetFieldPropertyClass
    UE5_GetClassPropsSize
    UE5_FindInstanceOfClass
    UE5_FindFunctionByName
    UE5_CallProcessEvent
    UE5_CallProcessEventDirect
    UE5_GetMailboxAddr
    g_invokeMailbox DATA
    UE5_StartPipeServer
    UE5_StopPipeServer
    UE5_IsPipeConnected
