<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>100</ID>
      <Description>"=== UE5 CEDumper v1.0 — bbfox / UE5CEDumper ==="</Description>
      <Color>00BB5E</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>102</ID>
      <Description>"init &lt;== enable after process attached"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- ============================================================
-- UE5CEDumper — Table Script
-- Runs when the 'init' record is ticked (this is that record's [ENABLE]).
--
-- Quiet by default: set UE5_DEBUG=1 (a global, e.g. typed once in CE's Lua
-- console) to echo progress to the Lua Engine console. Errors always show and
-- keep the window open; file logging under %LOCALAPPDATA%\UE5CEDumper\Logs is
-- unaffected by this flag.
-- ============================================================

-- Remember a folder that WORKED, so neither the console-spawning registry read
-- nor the file picker is ever needed twice.
--
-- Written back from exactly TWO places, both of which have PROVEN the folder is
-- this table's own: a manual pick, and the recent-files entry matched by this
-- table's filename. Never from a folder that merely happened to win the probe --
-- pinning, say, a stale copy left in CE's install folder would silently load a
-- mismatched build on every future run, which is worse than failing loudly.
function ue5_recordDllDir(dir)
    if type(dir) ~= "string" or dir == "" then return end
    dir = dir:gsub("[\\/]+$", "")
    pcall(function()
        local ad = os.getenv("LOCALAPPDATA") or ""
        if ad == "" then return end
        local p = ad .. "\\UE5CEDumper\\dll-path.txt"

        local keep = {}
        local h = io.open(p, "r")
        if h then
            for line in h:lines() do
                line = line:gsub("^\239\187\191", ""):gsub("^%s+", ""):gsub("%s+$", "")
                if line ~= "" and line:sub(1, 1) ~= "#"
                   and line:lower() ~= dir:lower() and #keep &lt; 3 then
                    keep[#keep + 1] = line
                end
            end
            h:close()
        end

        local w = io.open(p, "w")
        if not w then return end
        w:write("# UE5CEDumper - folders that have held UE5Dumper.dll, newest first.\n")
        w:write("# Written by UE5DumpUI at startup and by UE5CEDumper.CT after a manual pick.\n")
        w:write(dir .. "\n")
        for _, l in ipairs(keep) do w:write(l .. "\n") end
        w:close()
    end)
end

-- Report the RESOLVED DLL's size beside the path it chose, so a stale build is
-- visible. This table cannot read the DLL's real build stamp here: it is not a C ABI
-- export (only logged to init-0.log and carried on the pipe), the DLL is not injected
-- yet at path-report time, and CE Lua has no stat-by-path API. The file SIZE is the
-- cheap signal that separates a current build (several MB) from an old one -- the
-- Feb-2026 build in CE's install folder was ~0.5 MB. See docs/todo.md
-- [STALEDLL-2026-08-18]. A global so both the inject [ENABLE] chunk and the startup
-- replay (different Lua chunks) can call it.
function ue5_dllFileSize(path)
    if type(path) ~= "string" or path == "" then return nil end
    local f = io.open(path, "rb")
    if not f then return nil end
    local ok, sz = pcall(function() return f:seek("end") end)
    f:close()
    if not ok then return nil end
    return sz
end

-- Human-readable size, e.g. "2,857,472 bytes (2.7 MB)". Never throws.
function ue5_dllSizeText(path)
    local sz = ue5_dllFileSize(path)
    if not sz then return "unknown (could not read the file)" end
    return string.format("%d bytes (%.1f MB)", sz, sz / (1024 * 1024))
end

-- ============================================================
-- Locate UE5Dumper.dll
-- ============================================================
-- A CE table script cannot ask Cheat Engine where its own .CT file lives -- no
-- such API exists -- so the folder next to this file has to be INFERRED. Every
-- source below is best-effort and pcall'd: one that is missing, empty or throws
-- contributes no folder and SAYS SO in the failure report, instead of breaking
-- the table or vanishing silently from the list.
--
-- The order is a CONFIDENCE ranking, because the probe takes the FIRST folder
-- that actually contains the DLL. Slots are declared even when they have nothing
-- to offer, so the report can tell "checked, no DLL there" apart from "there was
-- nothing to check" -- exactly the confusion that made this bug hard to read.
-- ============================================================

local _slots, _seen = {}, {}

local function _slot(label, dir, why)
    if type(dir) ~= "string" then dir = "" end
    dir = dir:gsub("^%s+", ""):gsub("%s+$", "")
    if dir ~= "" then
        local last = dir:sub(-1)
        if last ~= "\\" and last ~= "/" then dir = dir .. "\\" end
        local key = dir:lower()
        if _seen[key] then
            _slots[#_slots + 1] = { label = label, dir = "",
                                    why = "same folder as slot " .. _seen[key] }
            return
        end
        _seen[key] = #_slots + 1
    end
    _slots[#_slots + 1] = { label = label, dir = dir, why = why }
end

-- 1. Trainer mode. Documented as THE path of the trainer that launched CE.
local _trainerDir = ""
pcall(function() _trainerDir = extractFilePath(TrainerOrigin or "") or "" end)
_slot("trainer folder (only set in trainer mode)", _trainerDir,
      "Cheat Engine was not launched as a trainer")

-- 2/3. CE's file dialogs. Both are undocumented published components of CE's
--      main form, so both are guarded (the Save read used to be bare: a throw
--      there aborted the chunk before the log was even open).
--
--      MEASURED 2026-08-22 on CE 7.7.0.10568, correcting what this comment used
--      to claim. File &gt; Load Recent DOES fill both dialogs: on a freshly
--      launched CE they read "", and immediately after picking this table from
--      Load Recent they both read its full path. So the recent-files menu is NOT
--      a channel that leaves these empty.
--
--      What DOES empty them is openProcess(): attaching writes the bare process
--      name ("DumperTest-Win64-Shipping") over the path, and extractFilePath of
--      a name with no separator is "". That is why the order matters --
--        attach then load  -> dialogs hold the .CT path  -> slot 2 answers
--        load then attach  -> dialogs hold a bare name   -> falls through to the
--                             recent-files slot below
--      Both resolve to the table's own folder, so the chain is correct either
--      way; do not "fix" one of them into the other.
local _openPath, _savePath = "", ""
pcall(function() _openPath = getMainForm().OpenDialog1.FileName or "" end)
pcall(function() _savePath = getMainForm().SaveDialog1.FileName or "" end)

local _openDir, _saveDir = "", ""
pcall(function() _openDir = extractFilePath(_openPath) or "" end)
pcall(function() _saveDir = extractFilePath(_savePath) or "" end)
_slot("folder of CE's last File &gt; Open", _openDir,
      "CE's Open dialog is empty - this table was not opened via File &gt; Open")
_slot("folder of CE's last File &gt; Save", _saveDir,
      "CE's Save dialog is empty - this table has not been saved this session")

-- 4. Documented as "the path of the currently executing code, if it was loaded
--    as a file" (celua.txt). This chunk is parsed out of the .CT's XML rather
--    than loaded from a .lua, so expect nothing -- but it costs one pcall and it
--    would be exactly right if any CE build ever populated it.
local _scriptDir = ""
pcall(function() _scriptDir = extractFilePath(getCurrentScriptPath() or "") or "" end)
_slot("folder of the running script", _scriptDir,
      "CE does not report a script file for a table script")

-- Slots 5/6 used to read CE's recent-files list here via getSettings(). MEASURED
-- DEAD on this CE build (2026-08-04): "Recent Files" is REG_MULTI_SZ, and both
-- documented accessors refuse that type -- Value["Recent Files"] returns an EMPTY
-- string and getBinaryValue("Recent Files") returns nil, even though celua.txt:3516
-- advertises it as returning a bytetable. A control read in the same session proved
-- the API itself is fine: getSettings("Plugins64").Value["00000000 A"] returned the
-- plugin path. So it is the TYPE that is unreadable, not the call.
--
-- The list is still the best answer -- it records a table's absolute path however it
-- was opened -- so it IS read, but further down and via reg.exe, after the cheap
-- slots have missed. Deferred on purpose: shelling out flashes a console window, and
-- a hit writes the folder to the breadcrumb so the next run never needs it again.

-- 7. Breadcrumb written by UE5DumpUI at startup: the folder UE5DumpUI.exe was
--    launched from, which is where UE5Dumper.dll ships beside it. Plain file
--    I/O, so it depends on nothing Cheat Engine does or does not expose.
local _appData = ""
pcall(function() _appData = os.getenv("LOCALAPPDATA") or "" end)

local _crumbs = {}
if _appData ~= "" then
    pcall(function()
        local h = io.open(_appData .. "\\UE5CEDumper\\dll-path.txt", "r")
        if not h then return end
        for line in h:lines() do
            line = line:gsub("^\239\187\191", "")            -- UTF-8 BOM, if an editor added one
            line = line:gsub("^%s+", ""):gsub("%s+$", "")    -- also eats the CR of a CRLF
            if line ~= "" and line:sub(1, 1) ~= "#" then _crumbs[#_crumbs + 1] = line end
        end
        h:close()
    end)
end
if #_crumbs == 0 then
    _slot("folder recorded by UE5DumpUI", "",
          "no folder recorded yet - UE5DumpUI writes this file at startup")
else
    for i = 1, #_crumbs do
        _slot(i == 1 and "folder recorded by UE5DumpUI"
                      or "folder recorded by UE5DumpUI (older entry)",
              _crumbs[i], "")
    end
end

-- 8. CE's own folder. Unrelated to this table: a DLL here can only have been
--    hand-placed, so it must stay below every table-derived slot above --
--    silently loading a stale build is worse than failing.
local _ceDir = ""
pcall(function() _ceDir = getCheatEngineDir() or "" end)
_slot("Cheat Engine install folder", _ceDir, "CE did not report its own folder")

-- 9. Kept only because a past session may have hand-placed a DLL here. Nothing
--    in this project ever writes UE5Dumper.dll to the app-data folder.
_slot("app data folder (state only - not a DLL location)",
      (_appData ~= "") and (_appData .. "\\UE5CEDumper\\") or "",
      "LOCALAPPDATA is not set")

-- Take the FIRST folder that actually holds the DLL. io.open is the primary
-- probe; fileExists is a second opinion for non-ASCII paths, where Lua's fopen
-- goes through the process ANSI codepage and CE's own file API does not.
local function _dllAt(dir)
    if dir == "" then return nil end
    local p = dir .. "UE5Dumper.dll"
    local f = io.open(p, "rb")
    if f then f:close() return p end
    local ok, hit = pcall(fileExists, p)
    if ok and hit then return p end
    return nil
end

DLL_PATH = nil
_DLL_FOUND_SLOT = nil
local _dllFoundIn = nil
local _dllFoundLabel = ""

local function _probeSlots(from)
    for i = from, #_slots do
        local s = _slots[i]
        if s.dir == "" then
            s.state = "NOT SEARCHED"
        else
            local hit = _dllAt(s.dir)
            if hit then
                DLL_PATH, _dllFoundIn, _DLL_FOUND_SLOT = hit, s.dir, i
                _dllFoundLabel = s.label
                s.state = "FOUND"
                return true
            end
            s.state = "no DLL"
        end
    end
    return false
end

_probeSlots(1)

-- ------------------------------------------------------------
-- Deferred: CE's recent-files list, read through reg.exe
-- ------------------------------------------------------------
-- Only when everything cheap has missed, because this spawns a console window.
-- It is the one source that records this .CT's absolute path NO MATTER HOW the
-- table was opened -- double-click and the File &gt; Load Recent menu both update
-- it while touching no dialog, which is exactly the case that failed. CE's own
-- Settings API cannot read it (see the note at slot 5/6 above), and CE's File
-- menu does not carry the paths either: "Load Recent" is a submenu, so the
-- entries are not reachable as File-menu children.
--
-- reg.exe renders a REG_MULTI_SZ with the LITERAL two characters \0 between
-- entries, so the split is on that, not on a real NUL.
if not DLL_PATH then
    local _mruFirst = #_slots + 1
    local _mru = {}
    pcall(function()
        local h = io.popen('reg query "HKCU\\Software\\Cheat Engine" /v "Recent Files" 2&gt;nul')
        if not h then return end
        local out = h:read("*a") or ""
        h:close()
        local data = out:match("REG_MULTI_SZ%s+([^\r\n]*)")
        if not data or data == "" then return end
        for entry in (data .. "\\0"):gmatch("(.-)\\0") do
            entry = entry:gsub("^%s+", ""):gsub("%s+$", "")
            if entry ~= "" then _mru[#_mru + 1] = entry end
        end
    end)

    -- The entry whose FILENAME is this table's own name. That check is what makes
    -- the list safe to trust: it cannot bind to a stale UE5Dumper.dll sitting
    -- beside some unrelated game's table. (Measured: this .CT has been seen at
    -- both position 1 and position 2 of that list, so never take entry 1 blindly.)
    local _mruSelf = ""
    for i = 1, #_mru do
        local leaf = ""
        pcall(function() leaf = (extractFileName(_mru[i]) or ""):lower() end)
        if leaf == "ue5cedumper.ct" then
            pcall(function() _mruSelf = extractFilePath(_mru[i]) or "" end)
            break
        end
    end
    _slot("folder of the most recent UE5CEDumper.CT in CE's recent-files list", _mruSelf,
          (#_mru == 0) and "could not read CE's recent-files list"
                        or "CE's recent-files list has no UE5CEDumper.CT in it")

    -- The single most recently opened table, whatever it is called -- the same
    -- answer when the user has RENAMED this .CT. Entry 1 only: the rest of the
    -- list is other games' tables, and probing those invites a stale hit.
    local _mruTop = ""
    if _mru[1] then pcall(function() _mruTop = extractFilePath(_mru[1]) or "" end) end
    _slot("folder of the most recently opened cheat table", _mruTop,
          "CE reported no recent files")

    if _probeSlots(_mruFirst) and _dllFoundLabel:find("UE5CEDumper.CT", 1, true) then
        -- Self-heal: this folder was proven to hold the DLL *and* proven to be
        -- this table's own folder, so record it and no later run has to shell
        -- out again. Only the name-matched slot earns this -- "most recently
        -- opened table" could be any game's folder.
        pcall(function() ue5_recordDllDir(_dllFoundIn) end)
    end
end

-- Rendered on demand so the failure dialog, the log file and the debug dump all
-- show the SAME list -- a user's screenshot can never disagree with the log.
function ue5_renderDllSearch()
    local out = "Folders, in the order tried:\n"
    for i, s in ipairs(_slots) do
        local detail = (s.dir ~= "" and s.dir ~= nil) and s.dir or (s.why or "no path available")
        if detail == "" then detail = s.dir end
        out = out .. string.format("  %d. [%s] %s - %s\n",
                                   i, s.state or "not reached", s.label, detail)
    end
    return out
end

-- Seed for the last-resort file picker in ue5_inject(): the best folder we did
-- look in, so the dialog opens somewhere plausible rather than at CE's root.
DLL_PICK_HINT = ""
for _, s in ipairs(_slots) do
    if s.dir ~= "" then
        DLL_PICK_HINT = s.dir
        break
    end
end

-- A miss is NOT fatal here. The old code returned out of this chunk, which left
-- ue5_inject / ue5_shutdown / ue5_log undefined -- so the next tick died with
-- "attempt to call a nil value (global 'ue5_inject')", turning one missing DLL
-- into a second, unrelated-looking error. Enforcement now lives in ue5_inject(),
-- where the DLL is actually needed and where returning false unticks the record.
if (UE5_DEBUG or 0) ~= 0 then
    print(string.format("[UE5Dump] OpenDialog1 = '%s'", _openPath))
    print(string.format("[UE5Dump] SaveDialog1 = '%s'", _savePath))
    if DLL_PATH then
        print(string.format("[UE5Dump] DLL found in slot %d: '%s'", _DLL_FOUND_SLOT, _dllFoundIn))
    else
        print("[UE5Dump] WARNING: UE5Dumper.dll not found in any searchable folder.")
    end
    for line in ue5_renderDllSearch():gmatch("[^\n]+") do print("[UE5Dump]   " .. line) end
end

-- ============================================================
-- File Logging (to %LOCALAPPDATA%\UE5CEDumper\Logs)
-- ============================================================

local _logHandle = nil

local function ue5_logInit()
    local localAppData = os.getenv("LOCALAPPDATA") or ""
    if localAppData == "" then return end

    local logDir = localAppData .. "\\UE5CEDumper\\Logs\\"
    os.execute('mkdir "' .. logDir .. '" 2&gt;nul')

    local logFile = logDir .. "UE5Dumper-lua.log"
    local h = io.open(logFile, "w")  -- overwrite each session
    if h then
        _logHandle = h
        h:write(string.format("[%s] [UE5Dump] Log file opened: %s\n", os.date("%H:%M:%S"), logFile))
        h:flush()
    end
    -- If io.open fails, silently skip
end

ue5_logInit()

-- ============================================================
-- Logging helpers (CE console + file)
-- ============================================================

function ue5_log(fmt, ...)
    local msg = string.format("[%s] [UE5Dump] " .. fmt, os.date("%H:%M:%S"), ...)
    -- Console echo gated on UE5_DEBUG (quiet by default); file logging always runs.
    if (UE5_DEBUG or 0) ~= 0 then print(msg) end
    if _logHandle then
        _logHandle:write(msg .. "\n")
        _logHandle:flush()
    end
end

function ue5_logError(fmt, ...)
    local msg = string.format("[%s] [UE5Dump ERROR] " .. fmt, os.date("%H:%M:%S"), ...)
    print(msg)
    if _logHandle then
        _logHandle:write(msg .. "\n")
        _logHandle:flush()
    end
end

-- ============================================================
-- DLL call wrapper
--
-- executeCodeEx(callmethod, timeout, address, params...) -- CE's celua.txt:
--   callmethod : 0 = stdcall, 1 = cdecl   (NOT a return type; the old comment
--                here said "retType 0=void, 1=integer" and that misreading is
--                what shipped the bug below)
--   timeout    : milliseconds. nil / -1 = wait forever (hangs CE's UI on a
--                stalled game thread); 0 = do not wait AND never free the call
--                memory, i.e. a leak. Always pass a finite value.
--   address    : the address to execute -- argument THREE.
--
-- Getting the slots wrong is SILENT: CE runs with address = nil and returns nil
-- without raising. Audit #4 B1 -- for a long time this called
-- executeCodeEx(retType, fn), so the address landed in the timeout slot,
-- UE5_Shutdown never actually ran, and the CE script reported a clean teardown.
-- ============================================================

-- ============================================================
-- ue5_isAlreadyLoaded()
-- Detect if our DLL or proxy DLL is already in the target process,
-- so we can skip a redundant (and potentially harmful) inject.
-- Returns: present (bool), moduleName (string|nil), modulePath (string|nil)
-- ============================================================

-- Proxy DLL file names we ship. A hijacked copy sits in the GAME folder; the
-- genuine Windows DLL of the same name lives in System32/SysWOW64 and is
-- filtered out by path below. Keep this list in sync with the C++ side
-- (Methode.cpp IsAlreadyLoadedInTarget) and with Models/ProxyType.cs — a name
-- missing here means the double-inject guard silently fails for that flavour.
local UE5_PROXY_DLL_NAMES = {
    ["version.dll"] = true,
    ["dinput8.dll"] = true,
    ["dxgi.dll"]    = true,
    ["winmm.dll"]   = true,
}

function ue5_isAlreadyLoaded()
    -- Fast path: any UE5_* export resolvable means our code is already in.
    local okGet, addr = pcall(getAddress, "UE5_Init")
    if not (okGet and addr and addr ~= 0) then
        return false, nil, nil
    end

    -- Confirmed loaded — figure out which module for the message.
    local okEnum, mods = pcall(enumModules)
    if okEnum and type(mods) == "table" then
        for _, mod in ipairs(mods) do
            local nm = string.lower(mod.Name or "")
            if nm == "ue5dumper.dll" then
                return true, mod.Name, mod.PathToFile
            end
            if UE5_PROXY_DLL_NAMES[nm] then
                local path = string.lower(mod.PathToFile or "")
                -- Skip System32/SysWOW64 — that's the genuine Windows copy
                if path ~= "" and not path:find("\\system32\\", 1, true)
                              and not path:find("\\syswow64\\", 1, true) then
                    return true, mod.Name, mod.PathToFile
                end
            end
        end
    end

    return true, "(unknown module)", nil
end

-- Milliseconds to wait for a DLL call. Finite on purpose -- see the header above.
local UE5_CALL_TIMEOUT_MS = 5000

function ue5_callDLL(funcName, retType, ...)
    -- pcall: getAddress THROWS when the symbol is not in CE's table (it is
    -- getAddressSafe that returns nil), and an uncaught throw here would abort
    -- the whole [DISABLE] chunk before the log handle is closed.
    local okGet, fn = pcall(getAddress, funcName)
    if not okGet or fn == nil or fn == 0 then
        ue5_logError("Export not found: %s  (DLL not injected?)", funcName)
        return nil
    end

    -- retType is ours, not CE's: it selects how we interpret the returned RAX.
    -- CE's own first argument is the CALLING CONVENTION and x64 has only one.
    local result, why = executeCodeEx(0, UE5_CALL_TIMEOUT_MS, fn, ...)

    -- Propagate nil: executeCodeEx returns nil when the remote call fails, and its
    -- SECOND return value names which failure -- 'Execution timeout', 'Failure
    -- launching thread', 'Wait failure', 'Failure reading the result address'.
    -- "process alive?" used to be printed here, which is a GUESS: four of those
    -- reasons happen with a perfectly healthy process and send you somewhere else
    -- entirely. Report what CE already knows. docs/ce-plugin-sdk-notes.md 13.5.
    if result == nil then
        ue5_logError("executeCodeEx failed for %s: %s", funcName, tostring(why))
        return nil
    end

    if retType == "bool" then return result ~= 0 end
    return result
end

-- ============================================================
-- ue5_inject()  —  called from [ENABLE] of the AA entry
-- ============================================================

-- Last resort: ask. createOpenDialog gives an absolute path to a file that
-- EXISTS -- the one thing none of the inferred folders can guarantee. Only
-- reached when every folder missed, so it never appears on a working install.
-- Fully pcall'd: an older CE without this API just degrades to the error dialog.
function ue5_pickDllManually()
    local d, picked = nil, nil

    pcall(function() d = createOpenDialog(getMainForm()) end)
    if not d then return nil end

    pcall(function()
        d.Title  = "UE5Dumper.dll was not found - please select it (it sits next to this .CT)"
        d.Filter = "UE5Dumper.dll|UE5Dumper.dll|All files (*.*)|*.*"
        if DLL_PICK_HINT and DLL_PICK_HINT ~= "" then d.InitialDir = DLL_PICK_HINT end
    end)

    local ran, chose = pcall(function() return d.Execute() end)
    if not ran then ran, chose = pcall(function() return d:Execute() end) end

    if ran and chose then
        pcall(function()
            local fn = d.FileName
            if type(fn) == "string" and fn ~= "" then
                local f = io.open(fn, "rb")
                if f then
                    f:close()
                    picked = fn
                end
            end
        end)
    end

    pcall(function() d.destroy() end)
    pcall(function() d:destroy() end)

    if picked then
        local dir = ""
        pcall(function() dir = extractFilePath(picked) or "" end)
        ue5_recordDllDir(dir)
    end
    return picked
end

-- Resolve the exported mailbox symbol, trying BOTH spellings CE may present.
-- Depending on how CE's symbol handler picked up the module, an export is reachable
-- as the bare name or only as "&lt;module&gt;.&lt;name&gt;", and which one works is not
-- predictable from here. lessons-learned.md mandates trying both, and eight other
-- sites in this repo already do; these two were the holdouts, and a single-spelling
-- miss silently degrades the readiness poll to the old blind 15 s wait. (B33)
function ue5_findMailbox()
    for _, sym in ipairs({ "g_invokeMailbox", "UE5Dumper.g_invokeMailbox" }) do
        local ok, addr = pcall(getAddress, sym)
        if ok and addr and addr ~= 0 then return addr end
    end
    return nil
end

function ue5_inject()
    ue5_log("Starting UE5 Dumper...")

    -- The folder search ran in this record's parent [ENABLE], deliberately
    -- WITHOUT aborting on a miss. Here is where a miss actually matters, and
    -- where returning false unticks the record.
    if not DLL_PATH then
        DLL_PATH = ue5_pickDllManually()
    end
    if not DLL_PATH then
        ue5_logError("UE5Dumper.dll not found in any searchable folder.")
        ue5_log("%s", ue5_renderDllSearch())
        showMessage(
            "UE5 Dumper Error:\n\n" ..
            "UE5Dumper.dll was not found in any folder this table can look in.\n\n" ..
            "A table script has no way to read its own .CT path, so the folder has\n" ..
            "to be inferred from what Cheat Engine reports -- and opening a .CT by\n" ..
            "double-clicking it, or from the recent-files menu, leaves those reports\n" ..
            "empty. The DLL can be sitting right next to this file and still not be\n" ..
            "found.\n\n" ..
            "Any ONE of these fixes it:\n" ..
            "  1. Launch UE5DumpUI.exe once (it records where the DLL is), then re-tick.\n" ..
            "  2. Or open this same .CT via Cheat Engine's File &gt; Open, then re-tick.\n" ..
            "  3. Or re-tick and choose UE5Dumper.dll in the file picker.\n\n" ..
            ue5_renderDllSearch())
        return false
    end
    ue5_log("DLL path: %s", DLL_PATH)
    -- Size beside the path so a stale/old DLL is not resolved silently ([STALEDLL]).
    ue5_log("DLL size: %s", ue5_dllSizeText(DLL_PATH))

    -- 0. Pre-check: verify CE has attached to a game process.
    -- getOpenedProcessID() returns 0 when no process is attached.
    -- A common mistake is running the CT without first attaching CE to the game.
    local pid = getOpenedProcessID()
    if pid == 0 then
        ue5_logError("No game process attached! Open a game process in CE first (File &gt; Open Process).")
        showMessage("UE5 Dumper Error:\n\nNo game process is attached to Cheat Engine.\n\nPlease attach CE to a running UE5 game first:\n  File &gt; Open Process (or click the process icon)")
        return false
    end
    ue5_log("Target process PID: %d", pid)

    -- 0.5. Skip injection if our DLL or proxy DLL is already loaded.
    -- Common case: user has version.dll deployed in the game folder, then
    -- tries to inject via CE — without this guard we'd map a duplicate
    -- copy into VA before Heiter.cpp's runtime pipe-existence guard bails.
    local INIT_IDLE, INIT_RUNNING = 0, 1
    local INIT_READY, INIT_FAILED, INIT_SKIPPED = 2, 3, 4
    local MAILBOX_INITSTATE_OFF = 0x0C   -- MailboxData.initState

    local present, modName, modPath = ue5_isAlreadyLoaded()
    local revived = false
    if present then
        -- "Already loaded" splits two ways that need OPPOSITE handling, and the
        -- mailbox's initState is what separates them:
        --   SERVING  — a proxy DLL deployed it, or another instance owns the pipe.
        --              Not ours. Return false so [ENABLE] unticks the record and
        --              its [DISABLE] can never run UE5_Shutdown against a pipe
        --              this script never started (audit #4 B30).
        --   PARKED   — this record was ticked, then unticked, which runs
        --              UE5_Shutdown and leaves initState at IDLE. Re-ticking must
        --              revive it in place: the DLL is still mapped, so injecting
        --              again would double-map us (audit #4 B1(b)).
        local pre = nil
        local mbNow = ue5_findMailbox()
        if mbNow then
            local okRead, v = pcall(readInteger, mbNow + MAILBOX_INITSTATE_OFF)
            pre = okRead and v or nil
        end

        if pre == INIT_READY or pre == INIT_SKIPPED then
            ue5_log("UE5CEDumper already loaded as '%s' (path: %s) and serving — skipping inject.",
                    modName or "?", modPath or "?")
            local msg = "UE5CEDumper is already loaded and serving in this process as '"
                     .. (modName or "?") .. "'.\n\n"
                     .. "No injection needed — just launch UE5DumpUI.exe and click Connect.\n"
                     .. "Pipe: \\\\.\\pipe\\UE5DumpBfx"
            showMessage(msg)
            return false
        end

        ue5_log("UE5CEDumper loaded as '%s' but parked (initState=%s) — restarting in place.",
                modName or "?", tostring(pre))
        if ue5_callDLL("UE5_AutoStart", "bool") == nil then
            ue5_logError("UE5_AutoStart did not run — cannot restart in place.")
            showMessage("UE5 Dumper Error:\n\nThe DLL is loaded but could not be restarted.\n\nUE5_AutoStart did not run — the game may be blocking remote threads.\nRestart the game to get a clean state.")
            return false
        end
        revived = true
    end

    -- 1. Inject DLL into the target process (skipped when we revived one in place).
    -- The DLL auto-start thread handles UE5_Init (AOBScan) + UE5_StartPipeServer
    -- internally — no executeCodeEx calls needed or possible (remote threads may
    -- be blocked by the game; executeCodeEx relies on CreateRemoteThread).
    if not revived then
        if not injectDLL(DLL_PATH) then
            ue5_logError("injectDLL failed! Is CE attached to the game? DLL_PATH: %s", DLL_PATH)
            showMessage("UE5 Dumper Error:\n\ninjectDLL failed.\n\nPossible causes:\n1. CE is not attached to a game process\n2. DLL file not found: " .. DLL_PATH .. "\n3. Anti-cheat blocking injection")
            return false
        end
        ue5_log("DLL injected OK")
    end

    -- 2. Wait for the auto-start thread to finish — by POLLING, not by sleeping
    --    a fixed budget.
    --
    -- Timeline: 1s thread delay + ~2-8s AOB scan + pipe server start. The old
    -- code slept a flat 15s and then printed "complete (or failed)" without ever
    -- checking anything, so a normal run wasted 5-10s AND a failed run still
    -- reported success.
    --
    -- The readiness signal is Mimic's mailbox initState field (Mimic.h
    -- InitState). Reading it is a PURE MEMORY READ via the exported
    -- g_invokeMailbox symbol — deliberately NOT executeCodeEx, which needs
    -- CreateRemoteThread and is exactly what step 1's comment says we avoid
    -- here because games may block it.
    -- INIT_* / MAILBOX_INITSTATE_OFF are declared at the top of this function —
    -- the already-loaded check above reads the same field to tell "serving" from
    -- "parked", so they cannot live only down here.
    local POLL_MS      = 250
    local tickAvailable = (type(getTickCount) == 'function')
    local startTick     = tickAvailable and getTickCount() or 0
    local TIMEOUT_MS   = 25000           -- generous: a cold cache + big pool can
                                         -- legitimately exceed the old 15s budget

    -- Resolve the mailbox symbol INSIDE the loop, not once up-front: CE's symbol
    -- handler may not have picked up the just-injected module yet, and a single
    -- failed getAddress would silently drop us back to the blind wait and lose
    -- the whole point of this change.
    local SYMBOL_GRACE_MS = 5000   -- give up on the symbol (not on the DLL) after this
    local mb = nil

    ue5_log("Waiting for GObjects/GNames scan + Pipe Server (polling)...")
    local waited, state, lastLogged = 0, INIT_IDLE, -1
    -- Did the DLL ever show a sign of life? This separates two very different
    -- outcomes that both end the loop still-not-READY (B32):
    --   sawProgress = true  -> it really did start and then stall. A timeout.
    --   sawProgress = false -> it never left IDLE for the whole window, which is
    --                          also exactly what an OLD DLL looks like: offset 0x0C
    --                          used to be an `int32_t reserved` that nothing ever
    --                          wrote, so the symbol resolves and reads 0 forever.
    --                          Reporting that as a timeout put a modal error on a
    --                          perfectly healthy injection.
    local sawProgress = false
    while waited &lt; TIMEOUT_MS do
        if mb == nil then
            mb = ue5_findMailbox()
            if mb == nil and waited &gt;= SYMBOL_GRACE_MS then
                break   -- symbol never appeared → fall back below
            end
        end
        if mb ~= nil then
            local okRead, v = pcall(readInteger, mb + MAILBOX_INITSTATE_OFF)
            state = (okRead and v) or INIT_IDLE
            if state ~= INIT_IDLE then sawProgress = true end
            if state == INIT_READY or state == INIT_FAILED or state == INIT_SKIPPED then
                break
            end
            if state ~= lastLogged then
                ue5_log("  ... %s", state == INIT_RUNNING and "scanning" or "starting up")
                lastLogged = state
            end
        end
        sleep(POLL_MS)
        -- Same reason as every other wait here: CE's Lua sleep pumps nothing, so this
        -- loop would freeze Cheat Engine for its whole budget. Paint-only preferred;
        -- feature-tested because it is 7.7-era and an undefined global is just nil.
        if type(processMessagesPaintOnly) == 'function' then processMessagesPaintOnly()
        elseif type(processMessages) == 'function' then processMessages() end
        -- MEASURE, do not accumulate. sleep(n) in CE is a floor, not an exact
        -- duration -- it rounds up to the ~15.47 ms Windows tick -- so summing the
        -- REQUESTED amount under-reports real elapsed time, and the fallback below
        -- spends a budget it computed from that wrong number. Same class as the
        -- iteration-counting timeout removed from every emitted script.
        if tickAvailable then waited = getTickCount() - startTick
        else waited = waited + POLL_MS end
    end

    if mb == nil then
        -- Symbol never resolved (very old DLL build, or CE's symbol handler is
        -- not cooperating). Fall back to the historical blind wait rather than
        -- failing outright — but only for the remainder of the old 15s budget.
        local remain = 15000 - waited
        ue5_log("Mailbox symbol not found — falling back to a fixed wait.")
        if remain &gt; 0 then sleep(remain) end
        ue5_log("Fixed wait elapsed (state unknown — check the DLL log).")
    else
        if state == INIT_READY then
            ue5_log("DLL auto-start complete in %.1f sec.", waited / 1000)
        elseif state == INIT_SKIPPED then
            -- Another UE5CEDumper instance already owns the pipe (or we are the
            -- CE plugin host). A pipe server IS up, so this is not an error.
            ue5_log("Auto-start skipped — another UE5CEDumper instance owns the pipe. Proceeding.")
        elseif state == INIT_FAILED then
            -- Real failure: init ran but the pipe server did not come up.
            ue5_logError("DLL init finished but the Pipe Server FAILED to start.")
            showMessage("UE5 Dumper Error:\n\nThe DLL loaded and initialised, but the Pipe Server failed to start.\n\nMost likely another process already owns \\\\.\\pipe\\UE5DumpBfx.\nCheck the DLL log:\n  %LOCALAPPDATA%\\UE5CEDumper\\Logs")
            return false
        elseif not sawProgress then
            -- The symbol resolved but the field never once left IDLE. That is NOT a
            -- timeout — it is indistinguishable from an older DLL where this offset
            -- was an `int32_t reserved` nothing ever wrote, so it reads 0 forever.
            -- The old code called it a timeout and threw a modal error on a
            -- perfectly healthy injection. Proceed quietly instead; the pipe is
            -- almost certainly up, and the UI's Connect will say so if it is not.
            -- (B32)
            ue5_log("Readiness field never changed — this DLL predates it. " ..
                    "Proceeding; if Connect fails, check the DLL log.")
        else
            -- Progress WAS observed and then stopped: the scan is wedged or far
            -- slower than expected. A timeout is an error: report and stop.
            ue5_logError("Timed out after %d sec waiting for DLL auto-start (state=%d).",
                         TIMEOUT_MS / 1000, state)
            showMessage("UE5 Dumper Error:\n\nTimed out waiting for the DLL to finish starting up.\n\nThe AOB scan may be wedged, or the game may be blocking our thread.\nCheck the DLL log:\n  %LOCALAPPDATA%\\UE5CEDumper\\Logs")
            return false
        end
    end

    ue5_log("=========================================")
    ue5_log("Pipe: \\\\.\\pipe\\UE5DumpBfx")
    ue5_log("Launch UE5DumpUI.exe and click Connect.")
    ue5_log("DLL log: %%LOCALAPPDATA%%\\UE5CEDumper\\Logs")
    ue5_log("=========================================")
    return true
end

-- ============================================================
-- ue5_shutdown()  —  called from [DISABLE] of the AA entry
-- ============================================================

function ue5_shutdown()
    -- Nothing loaded? Say nothing and do nothing. [ENABLE]'s bail-outs untick the
    -- record, which makes CE run this block even though this script never injected
    -- anything — and a bare getAddress would THROW here, aborting the chunk before
    -- the log handle is closed (audit #4 B40).
    local okProbe, probe = pcall(getAddress, "UE5_StopPipeServer")
    if not (okProbe and probe and probe ~= 0) then
        ue5_log("Nothing loaded — nothing to shut down.")
    else
        -- UE5_Shutdown ALONE. It already calls s_pipeServer.Stop() itself, and it
        -- does so deliberately AFTER Stark::Shutdown so a pipe thread blocked in
        -- EnqueueInvoke receives its -7 and unwinds. Calling UE5_StopPipeServer
        -- first inverted that ordering, and since the CE call times out while the
        -- remote thread keeps running, it put two teardowns in the process at once.
        local ok = ue5_callDLL("UE5_Shutdown", "void")
        if ok == nil then
            -- Do not claim success for a call that never returned. The remote
            -- thread may still be unwinding; the DLL log is the ground truth.
            ue5_logError("UE5_Shutdown did not return in time — check the DLL log.")
        else
            ue5_log("UE5 Dumper stopped.")
        end
    end
    -- Always close the log, on every path.
    if _logHandle then
        _logHandle:close()
        _logHandle = nil
    end
end

-- ============================================================
-- Highlight custom functions in CE's Lua syntax highlighter
-- ============================================================

registerLuaFunctionHighlight('ue5_inject')
registerLuaFunctionHighlight('ue5_shutdown')
registerLuaFunctionHighlight('ue5_callDLL')
registerLuaFunctionHighlight('ue5_log')
registerLuaFunctionHighlight('ue5_logError')

-- Print startup hint
ue5_log("Table loaded. Check [Inject DLL + Start Pipe Server] to begin.")
-- The folder search ran before the log existed. Replay it here: a run that could
-- not find the DLL used to bail out before ue5_logInit() and leave NOTHING in the
-- log -- and because the log opens with "w", the previous SUCCESSFUL run's log
-- survived and read as if nothing had gone wrong.
if DLL_PATH then
    ue5_log("DLL_PATH = %s  (slot %s, size %s)", DLL_PATH, tostring(_DLL_FOUND_SLOT),
            ue5_dllSizeText(DLL_PATH))
else
    ue5_logError("UE5Dumper.dll NOT FOUND -- ticking [Inject DLL + Start Pipe Server] will show where it looked.")
    ue5_log("%s", ue5_renderDllSearch())
end



[DISABLE]
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"Inject DLL + Start Pipe Server"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

-- memrec only exists in THIS chunk, not inside ue5_inject, so the untick has to
-- happen here. Without it CE ticks the record on every bail-out — including the
-- "already loaded and serving" one — and unticking then runs a real UE5_Shutdown
-- against a proxy this script never injected (audit #4 B30).
if ue5_inject() == false then
  if memrec then memrec.Active = false end
end

[DISABLE]
{$lua}
if syntaxcheck then return end

ue5_shutdown()
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>20</ID>
      <Description>"--- Setup Instructions ---"</Description>
      <Color>8000FF</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>21</ID>
      <Description>"1. Place UE5Dumper.dll next to this .CT (also found via UE5DumpUI or File &gt; Open)"</Description>
      <Color>C08000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>22</ID>
      <Description>"2. Open target UE game process in CE  (File &gt; Open Process)"</Description>
      <Color>C08000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>23</ID>
      <Description>"3. Check [Inject DLL + Start Pipe Server]  (Lua console shows progress)"</Description>
      <Color>C08000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>24</ID>
      <Description>"4. Launch UE5DumpUI.exe and click Connect"</Description>
      <Color>C08000</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
