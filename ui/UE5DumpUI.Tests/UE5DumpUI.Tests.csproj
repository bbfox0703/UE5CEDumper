<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Same policy as UE5DumpUI.csproj, and for the same reason: xUnit analyzer
         warnings (xUnit1025 duplicate InlineData, xUnit1051 missing
         TestContext.Current.CancellationToken) kept re-appearing with each new test
         file because nothing failed the build — they were fixed once, then drifted
         back. Warnings-as-errors is what makes "fix it when it appears" automatic
         instead of a habit somebody has to remember. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin ONLY the three test-infrastructure packages. Everything the tests
         actually touch flows in transitively and must NOT be re-pinned here:
           - Avalonia, Microsoft.Data.Sqlite (+ its native e_sqlite3 / SourceGear),
             SkiaSharp, HarfBuzz, MicroCom, the app's own types  <- from the
             UE5DumpUI ProjectReference below.
           - The Microsoft.Testing.* / OpenTelemetry / Azure.Monitor telemetry
             stack  <- from xunit.v3.
         A NuGet "Update all packages" pass used to splatter ~30 explicit
         transitive pins here (Azure.*, OpenTelemetry.*, SkiaSharp.*, HarfBuzz.*,
         Microsoft.Extensions.*, Microsoft.Identity.*, System.*, Tmds.DBus, …):
         pure churn that ALSO kept re-introducing the Microsoft.Testing.* landmine
         (see below). Keep this list minimal — let the graph resolve the rest. -->

    <!-- !! DO NOT add explicit Microsoft.Testing.Platform / Microsoft.Testing.Extensions.*
         PackageReferences here (a "Update all packages" pass keeps trying to re-add
         them — delete them again; build.ps1 also fails fast if they reappear).
         xunit.v3 bundles its own MTP bridge (Xunit.MicrosoftTestingPlatform.*)
         compiled against a SPECIFIC MTP API surface; pinning explicit versions of
         Microsoft.Testing.Platform / Microsoft.Testing.Platform.MSBuild /
         Microsoft.Testing.Extensions.Telemetry /
         Microsoft.Testing.Extensions.TrxReport.Abstractions overrides xunit.v3's
         tested transitives and the run dies at startup with:
           Zero tests ran + Exit code -532462766
           Unhandled exception. System.MissingMethodException: Method not found:
           'System.Threading.Tasks.Task Microsoft.Testing.Platform.OutputDevice.
            IOutputDevice.DisplayAsync(IOutputDeviceDataProducer, IOutputDeviceData)'
         (the IOutputDevice.DisplayAsync signature changed between MTP versions).
         Let xunit.v3's transitive graph resolve the whole Microsoft.Testing.* set. -->

    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UE5DumpUI\UE5DumpUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sanitized real-world "Dump All" slice used by DumpExplorerTests
         (Reader_ParsesRealWorldDumpFixture). Update (not Include) — the SDK
         already globs it into None; this only flags it for copy-to-output. -->
    <None Update="TestData\sample-dump.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
