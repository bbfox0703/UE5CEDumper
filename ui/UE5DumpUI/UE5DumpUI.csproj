<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- IL3053: AOT analysis warnings from Avalonia/MicroCom (third-party, safe to suppress).
         IL2104: DataGrid trim warning — TrimmerRootAssembly preserves it, safe to suppress. -->
    <NoWarn>$(NoWarn);IL3053;IL2104</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- ⚠ THESE MUST MATCH WHAT Avalonia.Skia / Avalonia.HarfBuzz WERE BUILT AGAINST.
         Read the required versions out of the resolved graph, do NOT bump them to
         "latest" with the rest of the dependencies:

           py -c "import json;d=json.load(open('obj/project.assets.json'));t=list(d['targets'].values())[0];
                  print(t['Avalonia.Skia/12.1.1']['dependencies'])"

         NuGet cannot protect this. Avalonia declares an open-ended minimum
         (SkiaSharp >= 3.119.4), so a major-version jump SATISFIES the constraint —
         no NU1608, no NU1605, nothing for TreatWarningsAsErrors to catch. The build
         stays green and the app starts; what breaks is native, later, and elsewhere.

         This is not hypothetical. Routine chore(deps) bumps had carried SkiaSharp to
         4.151.1 (one major ahead) and HarfBuzzSharp to 14.2.1.2 (six ahead), and the
         UI died with STATUS_HEAP_CORRUPTION (0xC0000374) minutes after a Copy CE XML.
         Full page heap named the culprit outright: an out-of-bounds access inside
         libSkiaSharp.dll+0x102B8D (0xC0000005, WER event AutoVerifierV2). See
         docs/todo.md "SkiaSharp/HarfBuzzSharp ABI alignment".

         The version lives here ONCE so a future bump cannot be applied to some of the
         seven references and not the others — which is the shape that hides longest. -->
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
    <HarfBuzzSharpVersion>8.3.1.3</HarfBuzzSharpVersion>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Treat warnings as errors so trim/AOT analysis warnings (IL2026 /
         IL3050) fail `dotnet publish` instead of silently shipping — the
         build-775 string-path Binding warnings reached a release before
         anyone noticed precisely because this wasn't on. NoWarn below
         keeps the third-party rollups (IL3053 / IL2104) demoted; only the
         live, fixable IL2026 / IL3050 + ordinary CS warnings break the
         build. Verified warning-clean across Debug + Release + Publish at
         build 784 before enabling (aot-pitfalls.md §0.5 / §1). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Must be false for Native AOT before Avalonia 12.0 -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- AOT: off by default, enabled via -p:PublishAot=true on publish -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <!-- partial trim: only [Trimmable]-annotated assemblies get aggressive trimming;
         Avalonia/MicroCom infrastructure is preserved via TrimmerRootAssembly below. -->
    <TrimMode>partial</TrimMode>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\Mainicon.ico</ApplicationIcon>

    <!-- ============================================================ -->
    <!-- Version: major.minor.patch synced with DLL (CMakeLists.txt)  -->
    <!-- Build number (4th digit) read from shared build_number.txt   -->
    <!-- ============================================================ -->
    <VerMajor>1</VerMajor>
    <VerMinor>0</VerMinor>
    <VerPatch>0</VerPatch>
    <BuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build_number.txt'))</BuildNumberFile>
    <VerBuild Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</VerBuild>
    <VerBuild Condition="'$(VerBuild)' == ''">0</VerBuild>

    <Version>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</Version>
    <AssemblyVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</AssemblyVersion>
    <FileVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</FileVersion>
    <InformationalVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</InformationalVersion>
    <Product>UE5CEDumper</Product>
    <Company>UE5CEDumper</Company>
    <Description>UE5 Object Dumper UI</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UE5DumpUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia. Windows-only: reference the Win32 + Skia backends DIRECTLY
         instead of the Avalonia.Desktop meta-package, which also pulls in the
         X11 / macOS-Native / FreeDesktop backends we never run. Dropping them
         removes their "will always throw" Native-AOT ILC warnings. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <!-- Text shaping. UsePlatformDetect() wired this automatically; with the
         explicit Win32+Skia backend it must be added by hand, else AppBuilder
         throws "No text shaping system configured" at startup. -->
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="$(HarfBuzzSharpVersion)" />

    <!-- SQLite (experimental Snapshot store). Raw ADO.NET only — no EF Core
         (its reflection query pipeline breaks trim/AOT). Microsoft.Data.Sqlite
         pulls SQLitePCLRaw.bundle_e_sqlite3, whose native e_sqlite3 must be
         bundled into the self-contained / AOT publish. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="$(SkiaSharpVersion)" />
    <!-- SQLitePCLRaw 3.0.x: Microsoft.Data.Sqlite 10.0.x only requires
         SQLitePCLRaw.* >= 2.1.11 (open-ended), so it would otherwise drag in the
         legacy 2.1.11 chain — including the now-DEPRECATED SQLitePCLRaw.lib.e_sqlite3.
         3.0 dropped lib.e_sqlite3 (renamed to SourceGear.sqlite3); bumping the bundle
         explicitly forces the whole core/provider/config chain to 3.0.3 and swaps the
         native lib to the maintained SourceGear.sqlite3. core is pinned too so NuGet
         can't pick 2.1.11 for it via Microsoft.Data.Sqlite's direct ref.
         Batteries_V2.Init() (SnapshotStore.cs) is unchanged in 3.x. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="MicroCom.Runtime" Version="0.11.6" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Embed CE Lua helper so the Tools -> Export CE Helper Lua File...
       command can stream it out. Single source of truth = scripts/ folder
       (linked here, not copied). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\ue5_invoke_helper.lua">
      <Link>Resources\CE\ue5_invoke_helper.lua</Link>
      <LogicalName>UE5DumpUI.Resources.CE.ue5_invoke_helper.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\ue5_freeze_helper.lua">
      <Link>Resources\CE\ue5_freeze_helper.lua</Link>
      <LogicalName>UE5DumpUI.Resources.CE.ue5_freeze_helper.lua</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Native AOT static CRT — `build.cmd publish` should produce an exe
       that runs on a bare Windows install without VC++ Redistributable.
       The redist provides vcruntime140.dll + msvcp140.dll; swap msvcrt
       and vcruntime for their static counterparts (libcmt, libvcruntime)
       so those symbols inline into the .exe. UCRT (ucrtbase.dll) stays
       dynamic — it's a Windows 10/11 OS component, not a redist payload,
       and the .NET AOT targets pin /DEFAULTLIB:ucrt.lib at the end of
       link.rsp anyway (overriding any /NODEFAULTLIB:ucrt.lib we'd add).
       Only fires when PublishAot=true so Debug / Release single-file
       publishes keep the dynamic CRT. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="/NODEFAULTLIB:msvcrt.lib" />
    <LinkerArg Include="/NODEFAULTLIB:msvcrtd.lib" />
    <LinkerArg Include="/NODEFAULTLIB:vcruntime.lib" />
    <LinkerArg Include="/NODEFAULTLIB:vcruntimed.lib" />
    <LinkerArg Include="/DEFAULTLIB:libvcruntime.lib" />
    <LinkerArg Include="/DEFAULTLIB:libcmt.lib" />
  </ItemGroup>

  <!-- Prevent Avalonia assemblies from being over-trimmed during AOT publish.
       The Win32 + Skia backends are wired explicitly in Program.cs but still
       construct types via reflection internally; without explicit roots they'd
       be partially trimmed, causing NullReferenceException in the rendering
       compositor thread at runtime. -->
  <ItemGroup>
    <!-- Core -->
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Markup" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.MicroCom" />
    <!-- Controls & Themes -->
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <!-- Platform backend (Win32-only; constructed via reflection — critical) -->
    <TrimmerRootAssembly Include="Avalonia.Win32" />
    <TrimmerRootAssembly Include="Avalonia.Win32.Automation" />
    <!-- Rendering backend (loaded via reflection — critical) -->
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <!-- Text shaping (constructed via reflection — critical) -->
    <TrimmerRootAssembly Include="Avalonia.HarfBuzz" />
    <!-- Fonts -->
    <TrimmerRootAssembly Include="Avalonia.Fonts.Inter" />
    <!-- COM interop -->
    <TrimmerRootAssembly Include="MicroCom.Runtime" />
  </ItemGroup>
</Project>
