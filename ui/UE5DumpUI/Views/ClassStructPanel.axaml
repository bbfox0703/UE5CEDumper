<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:models="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.ClassStructPanel"
             x:DataType="vm:ClassStructViewModel">

  <DockPanel Margin="8">
    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="{Binding HasClass}">
      <TextBlock Text="{Binding ClassName}" FontSize="18" FontWeight="Bold" Foreground="#4EC9B0"/>
      <TextBlock Text="{Binding ClassPath}" Foreground="#888" FontSize="12" Margin="0,2,0,0"/>

      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{StaticResource str.ClassStruct.Super}" Foreground="#888"/>
          <TextBlock Text="{Binding SuperName}" Foreground="#569CD6"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{StaticResource str.ClassStruct.PropsSize}" Foreground="#888"/>
          <TextBlock Text="{Binding PropertiesSize}" Foreground="#B5CEA8"/>
        </StackPanel>
        <Button Content="{StaticResource str.ClassStruct.FindClassFunc}"
                Command="{Binding FindClassFuncCommand}"
                ToolTip.Tip="{StaticResource str.Tip.ClassStruct.FindClassFunc}"
                Foreground="#C586C0" Background="Transparent"
                BorderThickness="1" BorderBrush="#C586C0"
                Padding="8,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>

    <!-- Failure surface — see the note in LiveWalkerPanel.axaml (audit #5 V7).
         Not gated on HasClass: a failed walk is exactly the case where there is
         no class to show, which is when the reason matters most. -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
               Foreground="#F48771" FontSize="11.5" TextWrapping="Wrap"
               Margin="0,0,0,6"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Field filter (client-side; no DLL roundtrip) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                Margin="0,0,0,8" IsVisible="{Binding HasClass}">
      <TextBlock Text="{StaticResource str.ClassStruct.FilterLabel}"
                 Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.ClassStruct.FilterHint}"
                       Text="{Binding FieldFilter, Mode=TwoWay}"
                       ItemsSource="{Binding FieldFilterHistory}"
                       FilterMode="Contains"
                       Width="320" Padding="4,2" FontSize="12"/>
    </StackPanel>

    <!-- No class selected message -->
    <TextBlock DockPanel.Dock="Top"
               Text="{StaticResource str.ClassStruct.NoClass}"
               Foreground="#666"
               IsVisible="{Binding !HasClass}"
               Margin="0,20,0,0"
               HorizontalAlignment="Center"/>

    <!-- Loading indicator -->
    <TextBlock DockPanel.Dock="Top"
               Text="{StaticResource str.ObjectTree.Loading}"
               Foreground="#4EC9B0"
               IsVisible="{Binding IsLoading}"
               HorizontalAlignment="Center"/>

    <!-- Empty-class hint: BlueprintFunctionLibrary subclasses
         (e.g. GameplayLib) report 0 instance fields because all their
         content is static methods. Without this banner the empty
         DataGrid below looks broken to a user landing here from an
         Interesting Funcs fallback. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasNoFields}"
            Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="3"
            Padding="12,8"
            Margin="0,4,0,8">
      <StackPanel Spacing="4">
        <TextBlock Foreground="#E0A050" FontSize="12" FontWeight="Bold"
                   Text="This class has no instance fields"/>
        <TextBlock Foreground="#CCCCCC" FontSize="11"
                   TextWrapping="Wrap"
                   Text="Likely a BlueprintFunctionLibrary or utility class — its content is static methods, not data. Use the Interesting Funcs tab to invoke its functions; LiveWalker has nothing to walk because there is no instance."/>
      </StackPanel>
    </Border>

    <!-- Fields DataGrid -->
    <DataGrid ItemsSource="{Binding Fields}"
              SelectedItem="{Binding SelectedField}"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              Background="Transparent"
              IsVisible="{Binding HasClass}"
              FontFamily="Consolas"
              FontSize="13">
      <DataGrid.ContextMenu>
        <ContextMenu x:DataType="vm:ClassStructViewModel">
          <MenuItem Header="{StaticResource str.Xref.FindFunctions}"
                    Command="{Binding FindFieldXrefsCommand}"
                    CommandParameter="{Binding SelectedField}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Offset}"
                            Binding="{Binding Offset, StringFormat=0x{0:X}}"
                            SortMemberPath="Offset"
                            Width="80"/>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Name}"
                            Binding="{Binding Name}"
                            SortMemberPath="Name"
                            Width="200"/>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Type}"
                            Binding="{Binding TypeName}"
                            SortMemberPath="TypeName"
                            Width="180"/>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Size}"
                            Binding="{Binding Size}"
                            SortMemberPath="Size"
                            Width="60"/>
        <DataGridTextColumn Header="Address"
                            Binding="{Binding Address}"
                            SortMemberPath="Address"
                            Width="160"/>
        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="models:FieldInfoModel">
              <Button Content="{StaticResource str.Xref.FindFuncsButton}"
                      Command="{Binding $parent[UserControl].((vm:ClassStructViewModel)DataContext).FindFieldXrefsCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{StaticResource str.Xref.FindFunctions}"
                      Foreground="#C586C0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#C586C0"
                      Padding="6,2" FontSize="11" Cursor="Hand"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
