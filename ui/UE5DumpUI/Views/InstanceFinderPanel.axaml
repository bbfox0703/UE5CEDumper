<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             xmlns:views="using:UE5DumpUI.Views"
             x:Class="UE5DumpUI.Views.InstanceFinderPanel"
             x:DataType="vm:InstanceFinderViewModel">

  <DockPanel Margin="8">
    <!-- Top: Search bar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox PlaceholderText="{StaticResource str.InstanceFinder.ClassNameHint}"
               Text="{Binding SearchClassName}"
               x:Name="SearchClassNameInput"
               KeyDown="SearchClassNameInput_KeyDown"
               ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.ClassName}"
               Width="260" Padding="4,2"/>
      <TextBox PlaceholderText="{StaticResource str.InstanceFinder.ObjectNameHint}"
               Text="{Binding SearchObjectName}"
               x:Name="SearchObjectNameInput"
               KeyDown="SearchClassNameInput_KeyDown"
               ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.ObjectName}"
               Width="220" Padding="4,2"/>
      <CheckBox Content="{StaticResource str.InstanceFinder.ExactMatch}"
                IsChecked="{Binding ExactMatch}"
                ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.ExactMatch}"
                VerticalAlignment="Center" Margin="0,0,4,0"/>
      <CheckBox Content="{StaticResource str.InstanceFinder.NewestFirst}"
                IsChecked="{Binding NewestFirst}"
                ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.NewestFirst}"
                VerticalAlignment="Center" Margin="0,0,4,0"/>
      <!-- Configurable result cap (game-side scan is always exhaustive; this only
           caps the returned list). Clamped 100–50000, also clamped DLL-side. -->
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                  ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.MaxResults}">
        <TextBlock Text="{StaticResource str.InstanceFinder.MaxResults}"
                   Foreground="#888" VerticalAlignment="Center"/>
        <NumericUpDown Value="{Binding InstanceSearchCap}"
                       Minimum="100" Maximum="50000" Increment="500"
                       FormatString="0" Width="120" FontSize="12"
                       VerticalAlignment="Center"/>
      </StackPanel>
      <Button Content="{StaticResource str.InstanceFinder.Search}"
              Command="{Binding SearchCommand}"
              ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.Search}"
              Classes="accent" Padding="12,4"/>
      <views:ClassFacetFilterButton Filter="{Binding ClassFilter}"/>
      <Button Content="{StaticResource str.Common.BatchFindFunc}"
              Click="OnBatchFindFuncsClick"
              IsEnabled="{Binding !IsXrefBatchRunning}"
              ToolTip.Tip="{StaticResource str.Tip.Common.BatchFindFunc}"
              Foreground="#C586C0" Background="Transparent"
              BorderThickness="1" BorderBrush="#C586C0"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
      <Button Content="{StaticResource str.Common.CancelBatch}"
              Command="{Binding CancelXrefBatchCommand}"
              IsVisible="{Binding IsXrefBatchRunning}"
              Foreground="#E06C75" Background="Transparent"
              BorderThickness="1" BorderBrush="#E06C75"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
    </StackPanel>

    <!-- Loading (class search) -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsSearching}" Height="2" Margin="0,0,0,4"/>

    <!-- Failure surface — see the note in LiveWalkerPanel.axaml (audit #5 V7).
         This VM sets ErrorMessage and nothing rendered it. -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
               Foreground="#F48771" FontSize="11.5" TextWrapping="Wrap"
               Margin="0,0,0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Address-to-Instance reverse lookup -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox PlaceholderText="{StaticResource str.InstanceFinder.AddressHint}"
               Text="{Binding LookupAddress}"
               x:Name="LookupAddressInput"
               KeyDown="LookupAddressInput_KeyDown"
               ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.AddressField}"
               Width="300" Padding="4,2"/>
      <Button Content="{StaticResource str.InstanceFinder.Lookup}"
              Command="{Binding LookupAddressCommand}"
              ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.Lookup}"
              Padding="12,4"/>
      <TextBlock Text="{Binding LookupStatusText}"
                 Foreground="#AAB8D0" FontSize="13" FontFamily="Consolas, Menlo, monospace"
                 VerticalAlignment="Center" Margin="8,0"/>
    </StackPanel>

    <!-- Loading (address lookup). IsIndeterminate is bound so the animation
         only runs while visible — avoids the hover-flicker pattern documented
         in the ProxyDeploy panel. -->
    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="{Binding IsLookingUp}"
                 IsVisible="{Binding IsLookingUp}"
                 Height="2" Margin="0,0,0,4"/>

    <!-- Container matches: address fell inside a UObject's TArray heap buffer.
         Surfaced separately because the address typically isn't a UObject and
         won't appear in the regular Instances grid. -->
    <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="4"
            Padding="6" Margin="0,0,0,8"
            IsVisible="{Binding HasContainerMatches}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{StaticResource str.InstanceFinder.ContainerMatches}"
                   Foreground="#CE9178" FontWeight="Bold" FontSize="12"
                   Margin="0,0,0,4"/>
        <DataGrid ItemsSource="{Binding ContainerMatches}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="0"
                  Background="#1E1E1E"
                  Foreground="#D4D4D4"
                  FontFamily="Consolas" FontSize="11"
                  MaxHeight="160"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Path"
                                Binding="{Binding DisplayPath}"
                                SortMemberPath="DisplayPath"
                                Width="420" MinWidth="220"/>
            <DataGridTextColumn Header="Owner Class"
                                Binding="{Binding OwnerClassName}"
                                SortMemberPath="OwnerClassName"
                                Width="220" MinWidth="140"/>
            <DataGridTextColumn Header="Inner"
                                Binding="{Binding InnerType}"
                                SortMemberPath="InnerType"
                                Width="120"/>
            <DataGridTextColumn Header="Owner Addr"
                                Binding="{Binding OwnerAddress}"
                                SortMemberPath="OwnerAddress"
                                Width="140"/>
            <DataGridTemplateColumn Header="" Width="Auto" CanUserResize="False" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="m:ContainerMatch">
                  <StackPanel Orientation="Horizontal" Spacing="4"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="{StaticResource str.VS.OpenLive}"
                            Command="{Binding $parent[DataGrid].((vm:InstanceFinderViewModel)DataContext).OpenContainerOwnerCommand}"
                            CommandParameter="{Binding}"
                            Foreground="#4EC9B0" Background="Transparent"
                            BorderThickness="1" BorderBrush="#4EC9B0"
                            Padding="6,2" FontSize="11" Cursor="Hand"/>
                    <Button Content="{StaticResource str.VS.CopyAddr}"
                            Command="{Binding $parent[DataGrid].((vm:InstanceFinderViewModel)DataContext).CopyContainerAddressCommand}"
                            CommandParameter="{Binding}"
                            Foreground="#DCDCAA" Background="Transparent"
                            BorderThickness="1" BorderBrush="#DCDCAA"
                            Padding="6,2" FontSize="11" Cursor="Hand"/>
                    <Button Content="{StaticResource str.InstanceFinder.LocateGWorldShort}"
                            Command="{Binding $parent[DataGrid].((vm:InstanceFinderViewModel)DataContext).LocateContainerOwnerInGWorldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.LocateGWorldContainer}"
                            Foreground="#C586C0" Background="Transparent"
                            BorderThickness="1" BorderBrush="#C586C0"
                            Padding="6,2" FontSize="11" Cursor="Hand"/>
                    <Button Content="{StaticResource str.InstanceFinder.LocateGameEngineShort}"
                            Command="{Binding $parent[DataGrid].((vm:InstanceFinderViewModel)DataContext).LocateContainerOwnerInGameEngineCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.LocateGameEngineContainer}"
                            Foreground="#C586C0" Background="Transparent"
                            BorderThickness="1" BorderBrush="#C586C0"
                            Padding="6,2" FontSize="11" Cursor="Hand"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!-- Temporary keyword filter over the returned instance rows. Client-side +
         instant (whitespace = AND across Name / Class / Address). Separate from the
         class-noise ⚑ filter: this only narrows what's already on screen and does
         NOT reach past the result cap. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <AutoCompleteBox PlaceholderText="{StaticResource str.InstanceFinder.KeywordHint}"
                       Text="{Binding InstanceFilterText, Mode=TwoWay}"
                       ItemsSource="{Binding InstanceFilterHistory}"
                       FilterMode="Contains"
                       ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.Keyword}"
                       Width="300" Padding="4,2"/>
    </StackPanel>

    <!-- Status row directly above the grid (mirrors Interesting Props — the
         place most panels surface their status / batch progress). -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#AAB8D0" FontSize="13" FontFamily="Consolas, Menlo, monospace"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding StatusText}"/>
      <TextBlock Text="{Binding ClassFilterNote}"
                 IsVisible="{Binding ClassFilterNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#E0A050" FontSize="13" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Main content: instances list (top) + field values (bottom) -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="200" MinHeight="100"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Instance list -->
      <DataGrid Grid.Row="0"
                x:Name="InstancesGrid"
                ItemsSource="{Binding Instances}"
                SelectedItem="{Binding SelectedInstance}"
                SelectionMode="Extended"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                Background="#1E1E1E"
                FontFamily="Consolas" FontSize="12">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{StaticResource str.InstanceFinder.Address}"
                              Binding="{Binding Address}"
                              SortMemberPath="Address"
                              Width="160"/>
          <DataGridTextColumn Header="{StaticResource str.ClassStruct.Name}"
                              Binding="{Binding Name}"
                              SortMemberPath="Name"
                              Width="200"/>
          <DataGridTextColumn Header="{StaticResource str.ClassStruct.Type}"
                              Binding="{Binding ClassName}"
                              SortMemberPath="ClassName"
                              Width="200"/>
          <DataGridTextColumn Header="Index"
                              Binding="{Binding Index}"
                              SortMemberPath="Index"
                              Width="80"/>
          <DataGridTemplateColumn Header="{StaticResource str.Common.FuncsCol}" Width="190" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:InstanceResult">
                <TextBlock Text="{Binding XrefInfo}"
                           Foreground="#C586C0"
                           VerticalAlignment="Center" Margin="4,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding XrefInfo}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{StaticResource str.InstanceFinder.CopyAddress}" Width="50" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:InstanceResult">
                <Button Content="Addr"
                        Command="{Binding $parent[UserControl].((vm:InstanceFinderViewModel)DataContext).CopyInstanceAddressCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.CopyAddr}"
                        Padding="4,2" Margin="2"
                        Foreground="#D4D4D4" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.GenerateCeAA}" Width="60" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:InstanceResult">
                <Button Content="AA"
                        Command="{Binding $parent[UserControl].((vm:InstanceFinderViewModel)DataContext).GenerateCeAAScriptCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.AA}"
                        Padding="4,2" Margin="2"
                        Foreground="#E5C07B" Background="Transparent"
                        BorderThickness="1" BorderBrush="#E5C07B"
                        Cursor="Hand" FontSize="10"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.CopyName}" Width="52" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:InstanceResult">
                <Button Content="{StaticResource str.LiveWalker.CopyName}"
                        Command="{Binding $parent[UserControl].((vm:InstanceFinderViewModel)DataContext).CopyInstanceNameCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.CopyName}"
                        Padding="4,2" Margin="2"
                        Foreground="#D4D4D4" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.CopyClass}" Width="52" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:InstanceResult">
                <Button Content="{StaticResource str.LiveWalker.CopyClass}"
                        Command="{Binding $parent[UserControl].((vm:InstanceFinderViewModel)DataContext).CopyInstanceClassNameCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CopyClass}"
                        Padding="4,2" Margin="2"
                        Foreground="#D4D4D4" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{StaticResource str.InstanceFinder.FindFunc}" Width="74" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:InstanceResult">
                <Button Content="{StaticResource str.InstanceFinder.FindFunc}"
                        Command="{Binding $parent[UserControl].((vm:InstanceFinderViewModel)DataContext).FindFunctionsForInstanceCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding ClassAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.FindFunc}"
                        Padding="4,2" Margin="2"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#C586C0"
                        Cursor="Hand" FontSize="10"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Row="1" Background="#3C3C3C" ResizeDirection="Rows"/>

      <!-- Field values for selected instance -->
      <DockPanel Grid.Row="2">
        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                    Margin="0,4,0,4" IsVisible="{Binding HasFields}">
          <Button Content="{StaticResource str.LiveWalker.ExportCE}"
                  Command="{Binding ExportCeXmlCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.ExportCE}"
                  Padding="8,4"/>
          <Button Content="{StaticResource str.InstanceFinder.OpenInWalker}"
                  Command="{Binding OpenInLiveWalkerCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.OpenWalker}"
                  Padding="8,4"/>
          <Button Content="{StaticResource str.InstanceFinder.LocateGWorld}"
                  Command="{Binding LocateSelectedInGWorldCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.LocateGWorld}"
                  Padding="8,4"/>
          <!-- Locate in GameEngine: kept as a compact icon button (not big text)
               even beside the big-text GWorld button, per the icon-style spec. Not
               gated on IsGWorldAvailable — engine availability is independent. -->
          <Button Content="{StaticResource str.InstanceFinder.LocateGameEngineShort}"
                  Command="{Binding LocateSelectedInGameEngineCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.LocateGameEngine}"
                  Foreground="#C586C0" Background="Transparent"
                  BorderThickness="1" BorderBrush="#C586C0"
                  Padding="6,2" FontSize="11" Cursor="Hand"/>
          <Button Content="{StaticResource str.Related.ShowButton}"
                  Command="{Binding ShowRelatedObjectsCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.Related.Show}"
                  Padding="8,4"/>
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                     IsVisible="{Binding IsLoadingFields}" Height="2" Margin="0,0,0,4"/>

        <DataGrid ItemsSource="{Binding Fields}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="#1E1E1E"
                  FontFamily="Consolas" FontSize="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{StaticResource str.ClassStruct.Offset}"
                                Binding="{Binding Offset, StringFormat='0x{0:X}'}"
                                SortMemberPath="Offset"
                                Width="80"/>
            <DataGridTextColumn Header="{StaticResource str.ClassStruct.Name}"
                                Binding="{Binding Name}"
                                SortMemberPath="Name"
                                Width="200"/>
            <DataGridTextColumn Header="{StaticResource str.ClassStruct.Type}"
                                Binding="{Binding TypeName}"
                                SortMemberPath="TypeName"
                                Width="140"/>
            <DataGridTextColumn Header="{StaticResource str.LiveWalker.Value}"
                                Binding="{Binding DisplayValue}"
                                SortMemberPath="DisplayValue"
                                Width="200"/>
            <DataGridTextColumn Header="Hex"
                                Binding="{Binding HexValue}" SortMemberPath="HexValue" Width="160"/>
            <DataGridTextColumn Header="{StaticResource str.InstanceFinder.Address}"
                                Binding="{Binding FieldAddress}"
                                SortMemberPath="FieldAddress"
                                Width="140"/>
            <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.CopyAddress}" Width="50" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="m:LiveFieldValue">
                  <Button Content="Addr"
                          Command="{Binding $parent[UserControl].((vm:InstanceFinderViewModel)DataContext).CopyFieldAddressCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{StaticResource str.Tip.InstanceFinder.CopyFieldAddr}"
                          Padding="4,2" Margin="2"
                          Foreground="#D4D4D4" Background="Transparent"
                          BorderThickness="1" BorderBrush="#555"
                          Cursor="Hand" FontSize="10"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
