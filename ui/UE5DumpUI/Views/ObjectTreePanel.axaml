<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:models="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.ObjectTreePanel"
             x:DataType="vm:ObjectTreeViewModel">

  <DockPanel>
    <!-- Search bar -->
    <StackPanel DockPanel.Dock="Top" Margin="4" Spacing="4">
      <!-- Grid (not DockPanel): the count text gets its own * column that
           truncates, so it can't overflow on top of the collapse button and
           swallow its clicks (the button sits in its own Auto column). -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{StaticResource str.ObjectTree.Title}"
                   FontWeight="SemiBold" FontSize="14" Foreground="#CCC"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding DisplayCount}"
                   Foreground="#888" FontSize="12" VerticalAlignment="Center"
                   Margin="8,0,4,0" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding DisplayCount}"/>
        <!-- Collapse the whole Object Tree column so the right panels get full
             width. A slim re-expand strip (in MainWindow) restores it. -->
        <Button Grid.Column="2"
                Content="&#x25C0;"
                Command="{Binding ToggleCollapseCommand}"
                ToolTip.Tip="{StaticResource str.Tip.ObjectTree.Collapse}"
                Padding="8,4" FontSize="12"
                Background="Transparent" BorderThickness="0"
                Foreground="#888" Cursor="Hand"
                VerticalAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <AutoCompleteBox Grid.Column="0"
                 PlaceholderText="{StaticResource str.ObjectTree.Search}"
                 Text="{Binding SearchText}"
                 FilterMode="Contains"
                 ItemsSource="{Binding SearchSuggestions}"
                 ToolTip.Tip="{StaticResource str.Tip.ObjectTree.SearchField}"
                 Margin="0,0,4,0"
                 KeyDown="SearchBox_KeyDown"
                 IsEnabled="{Binding !IsLoading}"
                 x:Name="SearchBox"/>
        <Button Grid.Column="1"
                Content="{StaticResource str.ObjectTree.Reload}"
                Command="{Binding LoadCommand}"
                IsVisible="{Binding !IsLoading}"
                ToolTip.Tip="{StaticResource str.Tip.ObjectTree.Reload}"
                Margin="0,0,4,0" Padding="8,4"/>
        <Button Grid.Column="1"
                Content="{StaticResource str.ObjectTree.Cancel}"
                Command="{Binding CancelLoadCommand}"
                IsVisible="{Binding IsLoading}"
                ToolTip.Tip="{StaticResource str.Tip.ObjectTree.Cancel}"
                Margin="0,0,4,0" Padding="8,4"
                Foreground="#F44747"/>
        <Button Grid.Column="2"
                Content="&#x1F50D;"
                Command="{Binding SearchCommand}"
                IsEnabled="{Binding !IsLoading}"
                ToolTip.Tip="{StaticResource str.Tip.ObjectTree.Search}"
                Padding="8,4"/>
      </Grid>

      <!-- Status text (shown during search/load operations) -->
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#888" FontSize="12"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Margin="0,0,0,2"/>

      <!-- Failure surface — see the note in LiveWalkerPanel.axaml (audit #5 V7). -->
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="#F48771" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Margin="0,0,0,2"/>

      <!-- Class type + text filter -->
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{StaticResource str.ObjectTree.ClassFilter}"
                   Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding ClassFilterOptions}"
                  SelectedIndex="{Binding SelectedClassFilterIndex}"
                  ToolTip.Tip="{StaticResource str.Tip.ObjectTree.ClassFilter}"
                  MinWidth="140" Padding="4,2" FontSize="12"/>
        <AutoCompleteBox PlaceholderText="{StaticResource str.ObjectTree.FilterHint}"
                 Text="{Binding FilterText, Mode=TwoWay}"
                 ItemsSource="{Binding FilterHistory}"
                 FilterMode="Contains"
                 ToolTip.Tip="{StaticResource str.Tip.ObjectTree.TextFilter}"
                 Padding="4,2" FontSize="12"
                 MinWidth="160"/>
      </StackPanel>

      <!-- Instances-only toggle: hide the reflection/type layer (UClass, UFunction,
           UScriptStruct, UEnum, UPackage) so a global keyword search over the whole
           loaded pool surfaces only live gameplay instances. Filters _allNodes, not
           the display-capped page. -->
      <CheckBox Content="{StaticResource str.ObjectTree.InstancesOnly}"
                IsChecked="{Binding InstancesOnly}"
                ToolTip.Tip="{StaticResource str.Tip.ObjectTree.InstancesOnly}"
                FontSize="12" Foreground="#CCC" Padding="4,0,0,0"/>
    </StackPanel>

    <!-- Object list (flat list with virtualization) -->
    <ListBox ItemsSource="{Binding FilteredNodes}"
             SelectedItem="{Binding SelectedNode}"
             Background="Transparent">
      <!-- ContextMenu on ListBox: uses SelectedNode for commands (works on full row area) -->
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{StaticResource str.ObjectTree.CopyClassName}"
                    Command="{Binding CopyClassNameCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <MenuItem Header="{StaticResource str.ObjectTree.CopyObjectName}"
                    Command="{Binding CopyObjectNameCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <MenuItem Header="{StaticResource str.ObjectTree.CopyAddress}"
                    Command="{Binding CopyAddressCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <Separator/>
          <MenuItem Header="{StaticResource str.ObjectTree.FindInstancesByType}"
                    Command="{Binding FindInstancesByTypeCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <MenuItem Header="{StaticResource str.ObjectTree.FindInstancesByTypeAndName}"
                    Command="{Binding FindInstancesByTypeAndNameCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <Separator/>
          <!-- Per-instance drill-downs: open THIS object (not just its class) in the
               instance-oriented panels. The handoffs re-resolve the live address. -->
          <MenuItem Header="{StaticResource str.ObjectTree.OpenInLiveWalker}"
                    Command="{Binding OpenInLiveWalkerCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <MenuItem Header="{StaticResource str.ObjectTree.ShowRelated}"
                    Command="{Binding ShowRelatedObjectsCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <MenuItem Header="{StaticResource str.ObjectTree.LocateInGWorld}"
                    Command="{Binding LocateSelectedInGWorldCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
          <MenuItem Header="{StaticResource str.ObjectTree.LocateInGameEngine}"
                    Command="{Binding LocateSelectedInGameEngineCommand}"
                    CommandParameter="{Binding SelectedNode}"/>
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:UObjectNode">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,1">
            <TextBlock Text="{Binding ClassName}"
                       Foreground="#569CD6" FontSize="14"
                       FontWeight="SemiBold"
                       MinWidth="140"/>
            <TextBlock Text="{Binding Name}"
                       Foreground="#D4D4D4" FontSize="14"/>
            <TextBlock Text="{Binding Address}"
                       Foreground="#6A9955" FontSize="13"
                       Opacity="0.7"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
