<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.GameClassFilterPanel"
             x:DataType="vm:GameClassFilterViewModel">

  <DockPanel Margin="8">
    <!-- Row 1: Load + GameOnly + Status -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <Button Content="{StaticResource str.GameClassFilter.Load}"
              Command="{Binding LoadCommand}"
              ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.Load}"
              Classes="accent" Padding="12,4"/>
      <CheckBox Content="{StaticResource str.GameClassFilter.GameOnly}"
                IsChecked="{Binding GameClassesOnly}"
                ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.GameOnly}"
                Foreground="#CCCCCC" FontSize="12"
                VerticalAlignment="Center"/>
      <!-- Configurable row cap. The GObjects walk is always exhaustive and the "of N total"
           figure counts past it; this bounds only the rows materialized. Clamped 100-50000 here
           and again DLL-side. [CLASSCAP-2026-08-21] -->
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                  ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.MaxResults}">
        <TextBlock Text="{StaticResource str.GameClassFilter.MaxResults}"
                   Foreground="#888" VerticalAlignment="Center"/>
        <NumericUpDown Value="{Binding ClassListCapValue}"
                       Minimum="100" Maximum="50000" ClipValueToMinMax="True" Increment="1000"
                       FormatString="0" Width="120" FontSize="12"
                       VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#AAB8D0" FontSize="13" FontFamily="Consolas, Menlo, monospace"
                 VerticalAlignment="Center" Margin="8,0"/>
    </StackPanel>

    <!-- Row 2: Filters -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{StaticResource str.GameClassFilter.SuperLabel}"
                 Foreground="#AAA" VerticalAlignment="Center" FontSize="12"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.GameClassFilter.SuperHint}"
                       Text="{Binding SuperFilter}"
                       FilterMode="Contains"
                       ItemsSource="{Binding SuperSuggestions}"
                       MinimumPrefixLength="0"
                       ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.SuperFilter}"
                       Width="180" Padding="4,2" FontSize="12"/>
      <TextBlock Text="{StaticResource str.GameClassFilter.PackageLabel}"
                 Foreground="#AAA" VerticalAlignment="Center" FontSize="12"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.GameClassFilter.PackageHint}"
                       Text="{Binding PackageFilter}"
                       FilterMode="Contains"
                       ItemsSource="{Binding PackageSuggestions}"
                       MinimumPrefixLength="0"
                       ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.PackageFilter}"
                       Width="180" Padding="4,2" FontSize="12"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.GameClassFilter.FilterHint}"
                       Text="{Binding FilterText, Mode=TwoWay}"
                       FilterMode="Contains"
                       ItemsSource="{Binding FilterHistory}"
                       MinimumPrefixLength="0"
                       Width="200" Padding="4,2"/>
      <Button Content="{StaticResource str.GameClassFilter.Clear}"
              Command="{Binding ClearFiltersCommand}"
              ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.Clear}"
              Padding="8,4" FontSize="11"/>
      <Button Content="{StaticResource str.Common.BatchFindFunc}"
              Click="OnBatchFindFuncClick"
              IsEnabled="{Binding !IsXrefBatchRunning}"
              ToolTip.Tip="{StaticResource str.Tip.Common.BatchFindFunc}"
              Foreground="#C586C0" Background="Transparent"
              BorderThickness="1" BorderBrush="#C586C0"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
      <Button Content="{StaticResource str.Common.CancelBatch}"
              Command="{Binding CancelXrefBatchCommand}"
              IsVisible="{Binding IsXrefBatchRunning}"
              Foreground="#E06C75" Background="Transparent"
              BorderThickness="1" BorderBrush="#E06C75"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
    </StackPanel>

    <!-- Suggestions-are-a-sample warning. Only visible when the class walk stopped at
         its row cap, in which case the two AutoCompleteBox dropdowns above list the
         Super / Package values found in the loaded page, not the ones that exist.
         VM-composed (audit #5 AE15 / Z10: Res.Get returns "" with no Application). -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding SuggestionsNote}"
               IsVisible="{Binding SuggestionsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Foreground="#D7BA7D" FontSize="11" TextWrapping="Wrap"
               Margin="0,0,0,6"/>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}" Height="2" Margin="0,0,0,4"/>

    <!-- Error display -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding ErrorMessage}"
               Foreground="#F44747" Margin="0,0,0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Results DataGrid -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedResult}"
              SelectionMode="Extended"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              Background="#1E1E1E"
              Foreground="#D4D4D4"
              FontSize="12"
              FontFamily="Consolas, Menlo, monospace">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Score" Width="55" SortMemberPath="Score" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:GameClassEntry">
              <TextBlock Text="{Binding Score}" Foreground="#E5C07B"
                         VerticalAlignment="Center" Margin="4,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Class"
                            Binding="{Binding ClassName}"
                            SortMemberPath="ClassName"
                            Width="200"/>
        <DataGridTextColumn Header="Super"
                            Binding="{Binding SuperName}"
                            SortMemberPath="SuperName"
                            Width="140"/>
        <DataGridTextColumn Header="Package"
                            Binding="{Binding Package}"
                            SortMemberPath="Package"
                            Width="140"/>
        <DataGridTextColumn Header="Path"
                            Binding="{Binding ClassPath}"
                            SortMemberPath="ClassPath"
                            Width="220"/>
        <DataGridTextColumn Header="Props"
                            Binding="{Binding PropertyCount}"
                            SortMemberPath="PropertyCount"
                            Width="60"/>
        <DataGridTextColumn Header="Size"
                            Binding="{Binding SizeHex}"
                            SortMemberPath="PropertiesSize"
                            CanUserSort="True"
                            Width="70"/>
        <DataGridTemplateColumn Header="{StaticResource str.Common.FuncsCol}" Width="200" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:GameClassEntry">
              <TextBlock Text="{Binding XrefInfo}"
                         Foreground="#C586C0"
                         VerticalAlignment="Center" Margin="4,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding XrefInfo}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:GameClassEntry">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{StaticResource str.GameClassFilter.FindInstances}"
                        Command="{Binding $parent[UserControl].((vm:GameClassFilterViewModel)DataContext).FindInstancesCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.FindInstances}"
                        Foreground="#7FB6E8" Background="Transparent"
                        BorderThickness="1" BorderBrush="#7FB6E8"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <Button Content="{StaticResource str.GameClassFilter.WalkClass}"
                        Command="{Binding $parent[UserControl].((vm:GameClassFilterViewModel)DataContext).WalkClassCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.WalkClass}"
                        Padding="6,2" FontSize="11"/>
                <Button Content="{StaticResource str.GameClassFilter.FindFunc}"
                        Command="{Binding $parent[UserControl].((vm:GameClassFilterViewModel)DataContext).FindFunctionsForClassCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.GameClassFilter.FindFunc}"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
