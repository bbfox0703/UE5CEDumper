<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.ClassPivotPanel"
             x:DataType="vm:ClassPivotViewModel">

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- Intro -->
    <TextBlock Grid.Row="0" Text="{StaticResource str.Pivot.Intro}"
               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Change-driven discovery: the automatic front-door. Find the (class, prop)
         targets that moved between two snapshots, ranked, so the user doesn't have to
         guess a class/key. "Use →" hands the chosen candidate to the pivot below. -->
    <Expander Grid.Row="1" Margin="0,0,0,8" IsExpanded="True"
              Header="{StaticResource str.Pivot.Discover.Header}">
      <StackPanel Orientation="Vertical" Spacing="6">
        <TextBlock Text="{StaticResource str.Pivot.Discover.Intro}"
                   Foreground="#999" FontSize="11" TextWrapping="Wrap"/>

        <!-- Usage limits, shown up front so expectations are clear before running. -->
        <Border Background="#16313D" BorderBrush="#2D6A8A" BorderThickness="1"
                CornerRadius="4" Padding="8,6">
          <TextBlock Text="{StaticResource str.Pivot.Discover.Limits}"
                     Foreground="#9FC6D8" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- N-snapshot picker: tick 2-4 (oldest → newest = Before … After). With 3-4
             the shape ranking separates a one-time change from per-frame noise. -->
        <TextBlock Text="{StaticResource str.Pivot.Discover.Pick}" Foreground="#CCCCCC"
                   FontSize="11" Margin="0,2,0,0"/>
        <ItemsControl ItemsSource="{Binding DiscoverPicks}" IsEnabled="{Binding !IsDiscovering}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DiscoverSnapshotPick">
              <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"
                        Margin="0,0,14,0" FontSize="11"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsDiscovering}">
          <Button Content="{StaticResource str.Pivot.Discover.Run}" Command="{Binding RunDiscoverCommand}"
                  IsEnabled="{Binding CanDiscover}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Pivot.Discover.Use}" Command="{Binding UseDiscoverCandidateCommand}"
                  CommandParameter="{Binding SelectedDiscoverResult}"
                  IsEnabled="{Binding SelectedDiscoverResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Padding="12,4" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding DiscoverHint}" Foreground="#999" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" Margin="4,0,0,0"
                       IsVisible="{Binding IsDiscovering}"/>
          <TextBlock Text="{Binding DiscoverStatus}" Foreground="#4EC9B0" FontSize="12"
                     VerticalAlignment="Center" Margin="8,0,0,0"
                     IsVisible="{Binding DiscoverStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </WrapPanel>
        <!-- Ranked candidates: highest "looks like game state" first. Select a row →
             Use → pivots it (selects the class, ticks the property, runs). -->
        <DataGrid x:Name="DiscoverGrid"
                  ItemsSource="{Binding DiscoverResults}" SelectedItem="{Binding SelectedDiscoverResult}"
                  Height="170" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Class}"   Binding="{Binding ClassName}"      SortMemberPath="ClassName"        Width="280" MinWidth="180"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Prop}"    Binding="{Binding PropName}"       SortMemberPath="PropName"         Width="260" MinWidth="160"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Changed}" Binding="{Binding ChangedDisplay}" SortMemberPath="InstancesChanged" Width="80"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Dir}"     Binding="{Binding Direction}"      SortMemberPath="Direction"        Width="44"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Cat}"     Binding="{Binding CategoryName}"   SortMemberPath="InterestScore"    Width="90"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Shape}"   Binding="{Binding ShapeLabel}"     SortMemberPath="ShapeScore"       Width="90"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Seq}"     Binding="{Binding SampleSequence}" SortMemberPath="SampleSequence"   Width="300" MinWidth="180"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Score}"   Binding="{Binding ScoreDisplay}"   SortMemberPath="Score"            Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Expander>

    <!-- Snapshot / class selection. Collapsible (the picker + class list take vertical
         space; collapse to give the results grid more room). Grayed during a pivot run so
         the source / snapshot / class can't change mid-operation. -->
    <Expander Grid.Row="2" Margin="0,0,0,8" IsExpanded="True"
              Header="{StaticResource str.Pivot.SourceHeader}">
      <StackPanel Orientation="Vertical" IsEnabled="{Binding !IsBusy}">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Pivot.Source}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}"
                  MinWidth="120" Margin="0,0,12,0"/>

        <!-- Snapshot + Snapshot Array sources share the snapshot/class pickers -->
        <TextBlock Text="{StaticResource str.Pivot.Snapshot}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding UsesSnapshot}"/>
        <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                  MinWidth="180" Margin="0,0,12,0" IsVisible="{Binding UsesSnapshot}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:SnapshotMeta">
              <TextBlock Text="{Binding PickerDisplay}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{StaticResource str.Pivot.ClassFilter}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding UsesSnapshot}"/>
        <!-- Class picker = filter AutoCompleteBox (here) + ListBox (below the WrapPanel). NOT a
             ComboBox (its dropdown Popup drops the click after a per-keystroke ItemsSource
             rebuild). SAFE as an AutoCompleteBox ONLY because we bind Text ONLY (never
             SelectedItem/SelectedValue) — its ItemsSource is the keyword MEMORY (past filters),
             so the Text<->SelectedItem reconciliation that oscillated SelectedClass and froze
             the UI never happens; SelectedClass stays owned by the ListBox. A ListBox has no
             Popup, so a live-filtered list commits clicks reliably. Typing here sets
             SelectedClass=null → no field load → the DB is never touched while filtering. -->
        <AutoCompleteBox Text="{Binding ClassFilter, Mode=TwoWay}"
                         ItemsSource="{Binding ClassFilterHistory}"
                         FilterMode="Contains"
                         Width="200" Margin="0,0,12,0"
                         IsVisible="{Binding UsesSnapshot}"
                         PlaceholderText="{StaticResource str.Pivot.ClassFilterHint}"/>

        <!-- Snapshot Array source (Phase C6: inner-key pivot of a struct array) -->
        <TextBlock Text="{StaticResource str.Pivot.ArrayField}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsArraySource}"/>
        <ComboBox ItemsSource="{Binding ArrayFields}" SelectedItem="{Binding SelectedArrayField}"
                  MinWidth="240" Margin="0,0,12,0" IsVisible="{Binding IsArraySource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:PivotArrayFieldInfo">
              <TextBlock Text="{Binding Display}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- DataTable source (Phase C4: zero-config, RowName is the key) -->
        <TextBlock Text="{StaticResource str.Pivot.DataTable}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsDataTableSource}"/>
        <ComboBox ItemsSource="{Binding DataTables}" SelectedItem="{Binding SelectedDataTable}"
                  MinWidth="300" Margin="0,0,8,0" IsVisible="{Binding IsDataTableSource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:DataTablePick">
              <TextBlock Text="{Binding Display}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="{StaticResource str.Pivot.RefreshDataTables}" Command="{Binding RefreshDataTablesCommand}"
                IsVisible="{Binding IsDataTableSource}" Padding="8,4" Margin="0,0,12,0"/>

        <Button Content="{StaticResource str.Pivot.Run}" Command="{Binding RunPivotCommand}"
                IsEnabled="{Binding CanRunPivot}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Pivot.OpenWalker}" Command="{Binding OpenInLiveWalkerCommand}"
                CommandParameter="{Binding SelectedResult}" Padding="8,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Pivot.CopyAddr}" Command="{Binding CopyAddressCommand}"
                CommandParameter="{Binding SelectedResult}" Padding="8,4"/>
        <!-- Locate the selected group's representative object in the world/engine graph. -->
        <Button Content="{StaticResource str.Pivot.LocateGWorld}" Command="{Binding LocateResultInGWorldCommand}"
                CommandParameter="{Binding SelectedResult}" IsEnabled="{Binding CanLocateResultInGWorld}"
                ToolTip.Tip="{StaticResource str.Tip.Pivot.LocateGWorld}"
                Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                Padding="8,4" Margin="8,0,0,0"/>
        <Button Content="{StaticResource str.Pivot.LocateGameEngine}" Command="{Binding LocateResultInGameEngineCommand}"
                CommandParameter="{Binding SelectedResult}" IsEnabled="{Binding CanLocateResult}"
                ToolTip.Tip="{StaticResource str.Tip.Pivot.LocateGameEngine}"
                Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                Padding="8,4" Margin="4,0,0,0"/>
      </WrapPanel>

      <!-- Class list (Snapshot sources). A ListBox — not a ComboBox dropdown — so the
           per-keystroke filter rebuild can't drop the click. Filter above to narrow it,
           then click a class to pivot it. Right-click → hide the class (Pivot-scope denylist). -->
      <ListBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
               Height="132" Margin="0,8,0,0" Background="#1E1E1E"
               IsVisible="{Binding UsesSnapshot}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{StaticResource str.Pivot.HideClass}"
                      Command="{Binding HideClassCommand}"
                      CommandParameter="{Binding SelectedClass}"/>
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="m:PivotClassInfo">
            <TextBlock Text="{Binding Display}" Padding="2,1"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </StackPanel>
    </Expander>

    <!-- Key mode -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Pivot.GroupBy}" Foreground="#CCCCCC" VerticalAlignment="Center"
                 IsVisible="{Binding IsSnapshotSource}"/>
      <ComboBox ItemsSource="{Binding KeyModeOptions}" SelectedItem="{Binding SelectedKeyMode}" MinWidth="170"
                IsVisible="{Binding IsSnapshotSource}" IsEnabled="{Binding !IsBusy}"/>
      <TextBlock Text="{StaticResource str.Pivot.KeyField}" Foreground="#CCCCCC"
                 VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding ShowKeyField}"/>
      <ComboBox ItemsSource="{Binding KeyFieldOptions}" SelectedItem="{Binding SelectedKeyField}"
                MinWidth="200" IsVisible="{Binding ShowKeyField}" IsEnabled="{Binding !IsBusy}"/>
      <TextBlock Text="{StaticResource str.Pivot.KeyRowName}" Foreground="#CCCCCC"
                 VerticalAlignment="Center" IsVisible="{Binding IsDataTableSource}"/>
      <TextBlock Text="{StaticResource str.Pivot.KeyInnerKey}" Foreground="#CCCCCC"
                 VerticalAlignment="Center" IsVisible="{Binding IsArraySource}"/>
      <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" Margin="12,0,0,0"
                   IsVisible="{Binding IsBusy}"/>
      <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0" FontSize="12"
                 VerticalAlignment="Center" Margin="12,0,0,0"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12"
                 VerticalAlignment="Center" Margin="12,0,0,0"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Resizable region: drag the splitter to reallocate height between the field
         picker (top) and the results (bottom). -->
    <Grid Grid.Row="4" RowDefinitions="1.3*,Auto,2.5*">

    <!-- Field picker: tick the value fields to project per group, and the Key
         fields to add to the composite group key (Field mode). KeyScore hints which
         fields make good group keys; the best is pre-selected in the Key-field box. -->
    <DataGrid x:Name="FieldPickGrid"
              Grid.Row="0" ItemsSource="{Binding Fields}" IsReadOnly="False"
              GridLinesVisibility="Horizontal" Background="#1E1E1E"
              IsEnabled="{Binding !IsBusy}"
              CanUserResizeColumns="True" CanUserSortColumns="True"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <!-- Composite group key: tick to add this field to the Field-mode key tuple
             (alongside the primary Key field above). Inert in Identity/DataTable/Array. -->
        <DataGridTemplateColumn Header="{StaticResource str.Pivot.Col.Key}" Width="50" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PivotFieldPick">
              <CheckBox IsChecked="{Binding IsKey}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip.Tip="{StaticResource str.Pivot.Col.KeyTip}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.Pivot.Col.Project}" Width="60" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PivotFieldPick">
              <CheckBox IsChecked="{Binding IsValue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Field}"    Binding="{Binding Name}"            SortMemberPath="Name"          IsReadOnly="True" Width="260" MinWidth="160"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Type}"     Binding="{Binding DeclaredType}"    SortMemberPath="DeclaredType"  IsReadOnly="True" Width="130"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Distinct}" Binding="{Binding DistinctCount}"   SortMemberPath="DistinctCount" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Insts}"    Binding="{Binding InstanceCount}"   SortMemberPath="InstanceCount" IsReadOnly="True" Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.KeyScore}" Binding="{Binding KeyScoreDisplay}" SortMemberPath="KeyScore"      IsReadOnly="True" Width="80"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Drag to reallocate height between the field picker and the results. -->
    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                  ResizeDirection="Rows" Background="#3C3C3C"/>

    <!-- Results region: hint + filter, then one row per group -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,6">
        <TextBlock Text="{StaticResource str.Pivot.ResultsHint}" Foreground="#888"
                   FontSize="11" TextWrapping="Wrap" Width="680" Margin="0,0,12,0"/>
        <AutoCompleteBox Text="{Binding ResultFilter, Mode=TwoWay}"
                         ItemsSource="{Binding ResultFilterHistory}"
                         FilterMode="Contains"
                         Width="220" Height="26" VerticalAlignment="Center"
                         PlaceholderText="{StaticResource str.Pivot.ResultFilterHint}"/>
      </WrapPanel>

      <!-- Results: one row per group -->
      <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                CanUserResizeColumns="True" CanUserSortColumns="True"
                HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Res.Count}"  Binding="{Binding Count}"         SortMemberPath="Count"         Width="70"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Res.Key}"    Binding="{Binding KeyValue}"      SortMemberPath="KeyValue"      Width="320" MinWidth="200"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Res.Values}" Binding="{Binding ValuesDisplay}" SortMemberPath="ValuesDisplay" Width="440" MinWidth="240"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    </Grid>

    <!-- N1: hidden-class chips (Pivot-scope denylist). Only shown when non-empty.
         Click a chip to un-hide; "Clear all" empties the Pivot denylist. -->
    <Border Grid.Row="5" Background="#252526" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
            BorderBrush="#3C3C3C" BorderThickness="1"
            IsVisible="{Binding HasHiddenClasses}">
      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="{StaticResource str.Pivot.HiddenHeader}"
                     Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Noise.Clear}"
                  Command="{Binding ClearDenylistCommand}" Padding="8,2"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ActiveDenylist}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Content="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:ClassPivotViewModel)DataContext).RemoveFromDenylistCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{StaticResource str.Noise.RemoveTip}"
                      Margin="0,0,4,4" Padding="6,2"
                      Background="#3C3C3C" Foreground="#CCCCCC"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
