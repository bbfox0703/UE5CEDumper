<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.LiveFuncsPanel"
             x:DataType="vm:LiveFuncsViewModel">

  <DockPanel Margin="8">

    <!-- Top: Start / Stop / Refresh / Clear + filter -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <Button Content="{StaticResource str.LF.Start}"
              Command="{Binding StartCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LF.Start}"
              IsEnabled="{Binding !IsRecording}"
              Foreground="#00BB5E" Background="Transparent"
              BorderThickness="1" BorderBrush="#00BB5E"
              Padding="12,4" Cursor="Hand"/>
      <Button Content="{StaticResource str.LF.Stop}"
              Command="{Binding StopCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LF.Stop}"
              IsEnabled="{Binding IsRecording}"
              Foreground="#E06C75" Background="Transparent"
              BorderThickness="1" BorderBrush="#E06C75"
              Padding="12,4" Cursor="Hand"/>
      <Button Content="{StaticResource str.LF.Refresh}"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LF.Refresh}"
              Padding="6,2" FontSize="11" VerticalAlignment="Center"
              Cursor="Hand"/>
      <Button Content="{StaticResource str.LF.Clear}"
              Command="{Binding ClearCommand}"
              Padding="6,2" FontSize="11" VerticalAlignment="Center"
              Cursor="Hand"/>
      <Button Content="{StaticResource str.LF.SaveJsonl}"
              Command="{Binding SaveJsonlCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LF.SaveJsonl}"
              IsEnabled="{Binding !IsRecording}"
              Padding="6,2" FontSize="11" VerticalAlignment="Center"
              Cursor="Hand"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.LF.FilterHint}"
               Text="{Binding FilterText, Mode=TwoWay}"
               ItemsSource="{Binding FilterHistory}"
               FilterMode="Contains"
               ToolTip.Tip="{StaticResource str.Tip.LF.Filter}"
               Width="260" Padding="4,2"/>
      <!-- Recording pulse indicator -->
      <Ellipse Width="10" Height="10" Fill="#E06C75"
               IsVisible="{Binding IsRecording}"
               VerticalAlignment="Center"/>
    </StackPanel>

    <!-- [LF-COMPACT-TOP] The capture settings' header line: the button that folds them, Clear choices and Open in
         Call Trace, then the first row of settings or, folded, a summary of them all. Clear choices sits here because
         the section's choices are what it clears, and this line shows folded or not, taking no line of its own; so
         does Open in Call Trace, an action after a traced Stop rather than a setting. The summary wraps and is the D3
         pair, so a warning folded away still shows in full, in orange. MainWindowViewModel remembers the fold. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
      <Button DockPanel.Dock="Left" Content="{Binding CaptureSettingsToggleText}"
              Command="{Binding ToggleCaptureSettingsCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LF.Settings.Toggle}"
              Foreground="#CCCCCC" Background="Transparent" BorderThickness="0"
              Padding="2,2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"/>
      <Button DockPanel.Dock="Left" Content="{StaticResource str.LF.ClearChoices}"
              Command="{Binding ClearChoicesCommand}"
              IsEnabled="{Binding !IsRecording}"
              IsVisible="{Binding TraceAvailable}"
              ToolTip.Tip="{StaticResource str.Tip.LF.ClearChoices}"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Cursor="Hand"/>
      <Button DockPanel.Dock="Right" Content="{StaticResource str.LF.Trace.Open}"
              Command="{Binding OpenCallTraceCommand}"
              IsVisible="{Binding HasTraceToOpen}"
              ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Open}"
              Foreground="#4EC9B0" Background="Transparent"
              BorderThickness="1" BorderBrush="#4EC9B0"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Cursor="Hand"/>
      <Panel Margin="12,0,0,0" VerticalAlignment="Center">
        <!-- The tooltip on the pair's panel: one binding, where one on each TextBlock built the summary once more each. -->
        <Panel IsVisible="{Binding CaptureSettingsCollapsed}" ToolTip.Tip="{Binding CaptureSummary}">
          <TextBlock Text="{Binding CaptureSummary}" IsVisible="{Binding !CaptureSummaryWarn}"
                     Foreground="#8FA0B8" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CaptureSummary}" IsVisible="{Binding CaptureSummaryWarn}"
                     Foreground="#E5A050" FontSize="12" TextWrapping="Wrap"/>
        </Panel>
        <!-- [EXTPR-539-540-2026-10-02] Capture settings. Disabled while a recording runs: the recording keeps the
             values it started with. Each slider's bounds are its view model's constants (WikiTooltipAccuracyTests). -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !CaptureSettingsCollapsed}">
          <TextBlock Text="{StaticResource str.LF.FetchLimit}"
                     Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
          <Slider Value="{Binding FetchLimitExponent}"
                  Minimum="6" Maximum="15"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  Width="160" VerticalAlignment="Center"
                  IsEnabled="{Binding !IsRecording}"
                  ToolTip.Tip="{StaticResource str.Tip.LF.FetchLimit}"/>
          <TextBlock Text="{Binding FetchLimit}"
                     Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                     VerticalAlignment="Center" MinWidth="44"/>
          <TextBlock Text="{StaticResource str.LF.MinCalls}" Margin="12,0,0,0"
                     Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
          <Slider Value="{Binding MinCallsExponent}"
                  Minimum="0" Maximum="5"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  Width="100" VerticalAlignment="Center"
                  IsEnabled="{Binding !IsRecording}"
                  ToolTip.Tip="{StaticResource str.Tip.LF.MinCalls}"/>
          <TextBlock Text="{Binding MinCalls}"
                     Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                     VerticalAlignment="Center" MinWidth="20"/>
          <!-- [LIVEFUNCS-HIDE-PERFRAME] Done by the DLL before the fetch limit, so it frees rows rather than hiding them. -->
          <CheckBox Content="{StaticResource str.LF.HidePerFrame}"
                    IsChecked="{Binding HidePerFrame}"
                    IsEnabled="{Binding !IsRecording}"
                    ToolTip.Tip="{StaticResource str.Tip.LF.HidePerFrame}"
                    Margin="12,0,0,0"
                    Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Panel>
    </DockPanel>

    <!-- [LF-COMPACT-TOP] The rest of the capture settings, folded with the header's button. Every warning in it is
         carried by the header's summary while it is folded. -->
    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding !CaptureSettingsCollapsed}">
      <!-- [LIVEFUNCS-TIMELINE-2026-10-04] The call trace (experimental, T6): armed by this Start, read in the Call Trace
           tab. Disabled while recording like the capture settings above; the slider's bounds are the view model's. -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4"
                  IsVisible="{Binding TraceAvailable}">
        <CheckBox Content="{StaticResource str.LF.Trace.Enable}"
                  IsChecked="{Binding TraceEnabled}"
                  IsEnabled="{Binding !IsRecording}"
                  ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Enable}"
                  Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="{StaticResource str.LF.Trace.Buffer}"
                   Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        <Slider Value="{Binding TraceBufferExponent}"
                Minimum="5" Maximum="9"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Width="100" VerticalAlignment="Center"
                IsEnabled="{Binding !IsRecording}"
                ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Buffer}"/>
        <TextBlock Text="{Binding TraceBufferText}"
                   Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center" MinWidth="52"/>
        <TextBlock Text="{Binding TraceEstimate}"
                   Foreground="#8FA0B8" FontSize="12" VerticalAlignment="Center"
                   ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Estimate}"/>
        <CheckBox Content="{StaticResource str.LF.Trace.ExcludePerFrame}"
                  IsChecked="{Binding TraceExcludePerFrame}"
                  IsEnabled="{Binding !IsRecording}"
                  ToolTip.Tip="{StaticResource str.Tip.LF.Trace.ExcludePerFrame}"
                  Margin="12,0,0,0"
                  Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TickedCountText}"
                   Foreground="#DCDCAA" FontSize="12" VerticalAlignment="Center"
                   ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Ticked}"/>
        <Button Content="{StaticResource str.LF.Trace.ClearTicks}"
                Command="{Binding ClearTicksCommand}"
                IsEnabled="{Binding !IsRecording}"
                Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
      </StackPanel>
      <!-- [LIVEFUNCS-STEP2] Parameter snapshots (T9, T12, T13): the choices, the buffer and what it would keep. Disabled
           while recording; the slider's bounds are the view model's. [LIVEFUNCS-STEP3] The stack count follows the bulk
           button, so that button reads as the parameters' own, and precedes Clear, which drops the stack choices too:
           they fill the same buffer (D4). The stack budget (T20) sits with the stack count, shown once a stack is chosen
           and fixed while recording like the rest of the row: a recording runs on the budget it started with. Radios,
           not a ComboBox: a SelectedItem bound to a boxed value fails only once trimmed. -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4"
                  IsVisible="{Binding TraceAvailable}">
        <TextBlock Text="{StaticResource str.LF.Snap.Label}"
                   Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SnapshotCountText}"
                   Foreground="#DCDCAA" FontSize="12" VerticalAlignment="Center"/>
        <Button Content="{StaticResource str.LF.Snap.ShownRows}"
                Command="{Binding SnapshotShownRowsCommand}"
                IsEnabled="{Binding CanSnapshot}"
                ToolTip.Tip="{StaticResource str.Tip.LF.Snap.ShownRows}"
                Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
        <TextBlock Text="{Binding StackCountText}"
                   Foreground="#DCDCAA" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="{StaticResource str.LF.Stack.Budget}"
                   IsVisible="{Binding HasStackChoices}"
                   Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        <RadioButton GroupName="LiveFuncsStackBudget"
                     Content="{StaticResource str.LF.Stack.Standard}"
                     IsChecked="{Binding StackBudgetStandard, Mode=TwoWay}"
                     IsVisible="{Binding HasStackChoices}"
                     IsEnabled="{Binding !IsRecording}"
                     ToolTip.Tip="{Binding StackStandardTip}"
                     Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        <RadioButton GroupName="LiveFuncsStackBudget"
                     Content="{StaticResource str.LF.Stack.Low}"
                     IsChecked="{Binding StackBudgetLow, Mode=TwoWay}"
                     IsVisible="{Binding HasStackChoices}"
                     IsEnabled="{Binding !IsRecording}"
                     ToolTip.Tip="{Binding StackLowTip}"
                     Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        <Button Content="{StaticResource str.LF.Snap.Clear}"
                Command="{Binding ClearSnapshotsCommand}"
                IsEnabled="{Binding !IsRecording}"
                Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
        <TextBlock Text="{StaticResource str.LF.Trace.Buffer}"
                   Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
        <Slider Value="{Binding SnapshotBufferExponent}"
                Minimum="3" Maximum="7"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Width="80" VerticalAlignment="Center"
                IsEnabled="{Binding !IsRecording}"
                ToolTip.Tip="{StaticResource str.Tip.LF.Snap.Buffer}"/>
        <TextBlock Text="{Binding SnapshotBufferText}"
                   Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center" MinWidth="44"/>
      </StackPanel>
      <!-- [LIVEFUNCS-STEP3] Under the stack count and budget, whenever a stack is chosen: T9.1's estimate of what the
           stacks chosen would cost the game a second, then T20's warning of what a capture is. Both turn the panel's
           warning orange above T9's threshold and stay calm under it, so the warning stands out when the estimate says
           it applies. Lines of their own, because a TextBlock in a horizontal StackPanel never wraps; each twice, toggled
           by a bool (the D3 pattern). Hidden with the row above when Trace is unavailable, as a Start then takes no
           stacks. [LF-COMPACT-TOP] The warning shows one line of its essentials and the whole text only under Details:
           four lines of it were the biggest block above the table. A WrapPanel keeps Details beside the line while it
           fits and lets the line wrap rather than clip in a narrow window. -->
      <Panel IsVisible="{Binding TraceAvailable}">
        <StackPanel IsVisible="{Binding HasStackChoices}" Margin="0,0,0,4">
          <Panel>
            <TextBlock Text="{Binding StackEstimate}" IsVisible="{Binding !StackEstimateWarn}"
                       Foreground="#8FA0B8" FontSize="12" TextWrapping="Wrap"
                       ToolTip.Tip="{Binding StackEstimateTip}"/>
            <TextBlock Text="{Binding StackEstimate}" IsVisible="{Binding StackEstimateWarn}"
                       Foreground="#E5A050" FontSize="12" TextWrapping="Wrap"
                       ToolTip.Tip="{Binding StackEstimateTip}"/>
          </Panel>
          <WrapPanel Orientation="Horizontal">
            <Panel VerticalAlignment="Center">
              <TextBlock Text="{StaticResource str.LF.Stack.WarningShort}" IsVisible="{Binding !StackEstimateWarn}"
                         Foreground="#808080" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="{StaticResource str.LF.Stack.WarningShort}" IsVisible="{Binding StackEstimateWarn}"
                         Foreground="#E5A050" FontSize="12" TextWrapping="Wrap"/>
            </Panel>
            <ToggleButton x:Name="StackWarningDetails" Content="{StaticResource str.LF.Stack.WarningDetails}"
                          ToolTip.Tip="{StaticResource str.Tip.LF.Stack.WarningDetails}"
                          Padding="6,0" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand"/>
          </WrapPanel>
          <Panel IsVisible="{Binding #StackWarningDetails.IsChecked}">
            <TextBlock Text="{StaticResource str.LF.Stack.Warning}" IsVisible="{Binding !StackEstimateWarn}"
                       Foreground="#808080" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{StaticResource str.LF.Stack.Warning}" IsVisible="{Binding StackEstimateWarn}"
                       Foreground="#E5A050" FontSize="12" TextWrapping="Wrap"/>
          </Panel>
        </StackPanel>
      </Panel>
      <!-- The estimate, orange per T13; the budget's cut in grey. Two TextBlocks toggled by a bool, the D3 pattern.
           [LIVEFUNCS-STEP3] Stacks alone still have the buffer's refusal to show, so the row shows for either choice. -->
      <StackPanel Margin="0,0,0,4">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="HasSnapshotChoices"/>
            <Binding Path="HasStackChoices"/>
          </MultiBinding>
        </StackPanel.IsVisible>
        <Panel IsVisible="{Binding TraceAvailable}">
          <TextBlock Text="{Binding SnapshotEstimate}" IsVisible="{Binding !SnapshotEstimateWarn}"
                     Foreground="#8FA0B8" FontSize="12" TextWrapping="Wrap"
                     ToolTip.Tip="{StaticResource str.Tip.LF.Snap.Estimate}"/>
          <TextBlock Text="{Binding SnapshotEstimate}" IsVisible="{Binding SnapshotEstimateWarn}"
                     Foreground="#E5A050" FontSize="12" TextWrapping="Wrap"
                     ToolTip.Tip="{StaticResource str.Tip.LF.Snap.Estimate}"/>
        </Panel>
        <TextBlock Text="{Binding SnapshotBudgetNote}" IsVisible="{Binding TraceAvailable}"
                   Foreground="#808080" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
      <!-- [TRACE-UI-LOAD-MEMORY] D3: what a buffer that fills costs, from the buffer alone; above the memory free now the
           same line turns orange: a warning, never a refusal. Two TextBlocks, so no converter. -->
      <Panel Margin="0,0,0,4" IsVisible="{Binding TraceAvailable}">
        <TextBlock Text="{Binding TraceMemoryEstimate}" IsVisible="{Binding !TraceMemoryOverAvailable}"
                   Foreground="#8FA0B8" FontSize="12" TextWrapping="Wrap"
                   ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Memory}"/>
        <TextBlock Text="{Binding TraceMemoryEstimate}" IsVisible="{Binding TraceMemoryOverAvailable}"
                   Foreground="#E5A050" FontSize="12" TextWrapping="Wrap"
                   ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Memory}"/>
      </Panel>
    </StackPanel>

    <!-- Baseline diff row: isolate the action's function from per-frame Tick noise. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,2"
                VerticalAlignment="Center">
      <Button Content="{StaticResource str.LF.SetBaseline}"
              Command="{Binding SetBaselineCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LF.SetBaseline}"
              Foreground="#7FB6E8" Background="Transparent"
              BorderThickness="1" BorderBrush="#7FB6E8"
              Padding="6,2" FontSize="11" Cursor="Hand"/>
      <CheckBox Content="{StaticResource str.LF.Diff}"
                IsChecked="{Binding DiffMode}"
                ToolTip.Tip="{StaticResource str.Tip.LF.Diff}"
                Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.LF.NewOnly}"
                IsChecked="{Binding NewChangedOnly}"
                IsVisible="{Binding DiffMode}"
                ToolTip.Tip="{StaticResource str.Tip.LF.NewOnly}"
                Foreground="#5FBF7F" FontSize="12" VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.LF.HideWidgets}"
                IsChecked="{Binding HideWidgets}"
                ToolTip.Tip="{StaticResource str.Tip.LF.HideWidgets}"
                Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.LF.HideEvents}"
                IsChecked="{Binding HideEvents}"
                ToolTip.Tip="{StaticResource str.Tip.LF.HideEvents}"
                Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.LF.PeriodicOnly}"
                IsChecked="{Binding PeriodicOnly}"
                ToolTip.Tip="{StaticResource str.Tip.LF.PeriodicOnly}"
                Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.LF.EarliestFirst}"
                IsChecked="{Binding EarliestFirst}"
                ToolTip.Tip="{StaticResource str.Tip.LF.EarliestFirst}"
                Foreground="#DCDCAA" FontSize="12" VerticalAlignment="Center"/>
      <Button Content="{StaticResource str.LF.ClearBaseline}"
              Command="{Binding ClearBaselineCommand}"
              IsVisible="{Binding DiffMode}"
              Padding="6,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
    </StackPanel>
    <!-- The baseline's status on a line of its own, full width and wrapping: beside the row's controls it got
         only what they left, which is little once Diff shows its extra controls. [LF-COMPACT-TOP] Only with a baseline
         or with Diff on: the hint it gave everyone else is on Set Baseline's tooltip. -->
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
               Text="{Binding BaselineStatus}"
               IsVisible="{Binding BaselineStatusVisible}"
               Foreground="#8FA0B8" FontSize="12"
               TextWrapping="Wrap"
               ToolTip.Tip="{Binding BaselineStatus}"/>

    <!-- Status + progress. DockPanel (not a horizontal StackPanel) so the status
         TextBlock gets a bounded width and WRAPS long messages instead of being
         clipped at the window edge. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
      <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Width="80" Height="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#AAB8D0" FontSize="13"
                 FontFamily="Consolas, Menlo, monospace"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding StatusText}"/>
    </DockPanel>

    <!-- Error display -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding ErrorMessage}"
               Foreground="#F44747" Margin="0,0,0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Results DataGrid -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedResult}"
              SelectionMode="Single"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              Background="#1E1E1E"
              Foreground="#D4D4D4"
              FontSize="12"
              FontFamily="Consolas, Menlo, monospace">
      <DataGrid.Columns>
        <!-- [LIVEFUNCS-TIMELINE-2026-10-04] Tick for the call trace (T3, T5): the next traced Start records only these
             functions' calls and what they call. Shown only with the experimental tabs on; the code-behind finds it by
             its header. The command keeps the ticks (by Class::Func) in the view model, so they outlive this fetch's rows. -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Trace}" Width="52" CanUserSort="False" IsVisible="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <CheckBox IsChecked="{Binding IsTicked, Mode=OneWay}"
                        Command="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).ToggleTickCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).CanTick}"
                        IsVisible="{Binding IsTickable}"
                        ToolTip.Tip="{StaticResource str.Tip.LF.Trace.Tick}"
                        HorizontalAlignment="Center" Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- [LIVEFUNCS-STEP2] Choose for parameter snapshots (T10, T11): by name, so an unloaded row with a key can be
             chosen. Hidden with the experimental tabs off like Trace; never sorted (no SortMemberPath). -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Snapshot}" Width="52" CanUserSort="False" IsVisible="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <CheckBox IsChecked="{Binding IsSnapChosen, Mode=OneWay}"
                        Command="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).ToggleSnapshotCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).CanSnapshot}"
                        IsVisible="{Binding CanChooseSnapshot}"
                        ToolTip.Tip="{StaticResource str.Tip.LF.Snap.Choose}"
                        HorizontalAlignment="Center" Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- [LIVEFUNCS-STEP3] Choose for a native stack (D1): a column of its own, because every function has a stack
             but not every one has parameters, and a walk costs far more than a parameter copy. Params?'s bindings and
             rules otherwise; it rides on the experimental trace the same way. -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Stack}" Width="52" CanUserSort="False" IsVisible="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <CheckBox IsChecked="{Binding IsStackChosen, Mode=OneWay}"
                        Command="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).ToggleStackCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).CanSnapshot}"
                        IsVisible="{Binding CanChooseStack}"
                        ToolTip.Tip="{StaticResource str.Tip.LF.Stack.Choose}"
                        HorizontalAlignment="Center" Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Order: call-stream position of the first fire (lower = earlier = more likely
             the causal entry point). Sort ascending to put openers on top. -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Order}" Width="64" SortMemberPath="FirstSeq" CanUserSort="True"
                                ClipboardContentBinding="{Binding FirstSeq}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <TextBlock Text="{Binding FirstSeq}"
                         Foreground="#7FB6E8"
                         VerticalAlignment="Center" Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Calls}" Width="80" SortMemberPath="Count" CanUserSort="True"
                                ClipboardContentBinding="{Binding Count}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <TextBlock Text="{Binding Count}"
                         Foreground="#DCDCAA" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Δ vs baseline — "NEW" / "+N" (green) surfaces action-specific funcs.
             Blank outside Diff mode. -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.DeltaVsBase}" Width="80" SortMemberPath="Delta" CanUserSort="True"
                                ClipboardContentBinding="{Binding DeltaLabel}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <TextBlock Text="{Binding DeltaLabel}"
                         Foreground="#5FBF7F" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Kind: "UI" marks a transient widget method (the created UI, not the opener). -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Kind}" Width="44" SortMemberPath="Kind" CanUserSort="True"
                                ClipboardContentBinding="{Binding Kind}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <TextBlock Text="{Binding Kind}"
                         Foreground="#808080" FontSize="11"
                         VerticalAlignment="Center" Margin="4,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Type: Event/Deleg (a reaction the engine fires) vs Call (an imperative
             function you can invoke) vs native. -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Type}" Width="56" SortMemberPath="TypeLabel" CanUserSort="True"
                                ClipboardContentBinding="{Binding TypeLabel}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <TextBlock Text="{Binding TypeLabel}"
                         Foreground="#8FA0B8" FontSize="11"
                         VerticalAlignment="Center" Margin="4,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource str.LF.Col.Class}" Binding="{Binding ClassName}" SortMemberPath="ClassName" Width="240"/>
        <!-- [TRACE-UNLOADED-NAMES] A function the game unloaded since it fired: its name from its first call, and a grey
             marker beside it. The marker is its own TextBlock, never part of the name, so Name copies, the filter and
             the sort see the plain name. -->
        <DataGridTemplateColumn Header="{StaticResource str.LF.Col.Function}" Width="240" SortMemberPath="FuncName" CanUserSort="True"
                                ClipboardContentBinding="{Binding FuncName}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <DockPanel VerticalAlignment="Center" Margin="6,0">
                <TextBlock DockPanel.Dock="Right" Text="{StaticResource str.LF.Unloaded.Marker}"
                           IsVisible="{Binding IsUnloaded}"
                           ToolTip.Tip="{StaticResource str.Tip.LF.Unloaded}"
                           Foreground="#808080" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <!-- [LIVEFUNCS-STEP2] Fired every frame: a chosen one takes the budget's share. -->
                <TextBlock DockPanel.Dock="Right" Text="{StaticResource str.LF.PerFrame.Marker}"
                           IsVisible="{Binding IsPerFrame}"
                           ToolTip.Tip="{StaticResource str.Tip.LF.PerFrame.Marker}"
                           Foreground="#808080" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <!-- Review DLL-3: the address held another function during the recording; the count is both. -->
                <TextBlock DockPanel.Dock="Right" Text="{StaticResource str.LF.Reused.Marker}"
                           IsVisible="{Binding IsReused}"
                           ToolTip.Tip="{StaticResource str.Tip.LF.Reused}"
                           Foreground="#C08040" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FuncName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource str.LF.Col.Params}" Binding="{Binding ParamsLabel}" SortMemberPath="NumParms" Width="90" CanUserSort="True"/>
        <!-- Period: mean inter-arrival cadence (Phase E); "Timer" in the Kind column
             marks a regular timer-like callback. -->
        <DataGridTextColumn Header="{StaticResource str.LF.Col.Period}" Binding="{Binding PeriodLabel}" SortMemberPath="MeanPeriodMs" Width="72"/>
        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PeProfileEntry">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{StaticResource str.LF.OpenLive}"
                        Command="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).OpenInLiveWalkerCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.LF.OpenLive}"
                        Foreground="#4EC9B0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#4EC9B0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <Button Content="{StaticResource str.LF.CopyName}"
                        Command="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).CopyFuncNameCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.LF.CopyName}"
                        Foreground="#DCDCAA" Background="Transparent"
                        BorderThickness="1" BorderBrush="#DCDCAA"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <!-- [AOBM-FUNC-DISASM] -->
                <Button Content="{StaticResource str.Pointers.AobMakerAsm}"
                        Command="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).AsmFuncCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveFuncsViewModel)DataContext).AobMaker.IsAvailable}"
                        IsVisible="{Binding !IsUnloaded}"
                        ToolTip.Tip="{StaticResource str.Tip.AobMaker.FuncAsm}"
                        Foreground="#E5C07B" Background="Transparent"
                        BorderThickness="1" BorderBrush="#E5C07B"
                        Padding="6,2" FontSize="11" FontFamily="Consolas" Cursor="Hand"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
