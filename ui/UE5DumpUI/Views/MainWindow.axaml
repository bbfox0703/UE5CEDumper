<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UE5DumpUI.ViewModels"
        xmlns:views="using:UE5DumpUI.Views"
        x:Class="UE5DumpUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/Mainicon.png"
        Title="{Binding WindowTitle}" Background="#1E1E1E"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500">

  <DockPanel>
    <!-- Top Toolbar (WrapPanel for adaptive layout) -->
    <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,4">
      <WrapPanel Orientation="Horizontal">

        <!-- Connection buttons + status -->
        <StackPanel Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,2">
          <Button Content="{StaticResource str.Connect}"
                  Command="{Binding ConnectCommand}"
                  IsVisible="{Binding !IsConnected}"
                  ToolTip.Tip="{StaticResource str.Tip.Connect}"
                  Classes="accent" Padding="12,4"/>
          <Button Content="{StaticResource str.Disconnect}"
                  Command="{Binding DisconnectCommand}"
                  IsVisible="{Binding IsConnected}"
                  ToolTip.Tip="{StaticResource str.Tip.Disconnect}"
                  Padding="12,4"/>
          <Button Content="{StaticResource str.Toolbar.StartScan}"
                  Command="{Binding TriggerScanCommand}"
                  IsVisible="{Binding NeedsScan}"
                  IsEnabled="{Binding !IsScanning}"
                  ToolTip.Tip="{StaticResource str.Tip.StartScan}"
                  Classes="accent" Padding="12,4"
                  FontWeight="Bold"/>
          <!-- Status: capped width + ellipsis + tooltip so long messages
               (e.g. "Navigated to FooComponent::GetBar (live instance 0x…)")
               don't push the rest of the toolbar off-screen and wrap. -->
          <TextBlock Text="{Binding StatusText}"
                     Foreground="#4EC9B0"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     MaxWidth="360"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding StatusText}"/>
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="#F44747"
                     VerticalAlignment="Center"
                     MaxWidth="360"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <!-- The global stale-DLL badge now lives next to the version label (right
               edge of the toolbar) where users look for build info — see below. -->
        </StackPanel>

        <!-- Address format selector -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="8,2">
          <TextBlock Text="{StaticResource str.Toolbar.AddressFormat}"
                     Foreground="#CCCCCC" FontSize="12"
                     VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding AddressFormatOptions}"
                    SelectedIndex="{Binding SelectedAddressFormatIndex}"
                    ToolTip.Tip="{StaticResource str.Tip.AddressFormat}"
                    MinWidth="140" Padding="4,2" FontSize="12"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- AOBMaker plugin status + manual refresh. Mirrors the System-tab
             indicator but stays visible from every tab so the user can confirm
             CE connectivity at a glance before using HEX/ASM/Add-to-CE actions.
             Only shown when the bridge is configured. -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="8,2"
                    IsVisible="{Binding IsAobMakerConfigured}">
          <Ellipse Width="9" Height="9" Fill="#4EC9B0" VerticalAlignment="Center"
                   IsVisible="{Binding IsAobMakerAvailable}"/>
          <Ellipse Width="9" Height="9" Fill="#888888" VerticalAlignment="Center"
                   IsVisible="{Binding !IsAobMakerAvailable}"/>
          <TextBlock Text="{StaticResource str.Toolbar.AobMakerLabel}"
                     Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="{StaticResource str.Toolbar.AobMakerConnected}"
                     Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding IsAobMakerAvailable}"/>
          <TextBlock Text="{StaticResource str.Toolbar.AobMakerOffline}"
                     Foreground="#888888" FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding !IsAobMakerAvailable}"/>
          <Button Content="{StaticResource str.Toolbar.AobMakerRefresh}"
                  Command="{Binding RefreshAobMakerCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.Toolbar.AobMakerRefresh}"
                  Padding="6,2" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Options popover (⚙):
             Collapses 5 export-shape controls (Collapse Pointers + 4 slider
             limits) into a single dropdown to keep the top toolbar on one
             row even at 4K / 225% scaling. These are tuned once per export
             session, not flipped frequently, so hiding them behind a click
             trades zero ergonomic cost for ~600px of horizontal space. -->
        <Border Margin="8,2" VerticalAlignment="Center">
          <DropDownButton Content="{StaticResource str.Toolbar.Options}"
                          ToolTip.Tip="{StaticResource str.Tip.Toolbar.Options}"
                          Padding="8,3" FontSize="12">
            <DropDownButton.Flyout>
              <Flyout Placement="Bottom">
                <StackPanel Spacing="10" Width="380" Margin="6">
                  <!-- CE XML collapse toggle -->
                  <CheckBox Content="{StaticResource str.Toolbar.CollapsePointers}"
                            IsChecked="{Binding CollapsePointerNodes}"
                            ToolTip.Tip="{StaticResource str.Tip.CollapsePointers}"
                            Foreground="#CCCCCC" FontSize="12"/>

                  <Separator Background="#3C3C3C" Height="1"/>

                  <!-- Array Limit -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.ArrayLimit}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding ArrayLimit}"
                                 Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="40"/>
                      <TextBlock Text="{StaticResource str.Toolbar.ArrayLimitWarn}"
                                 Foreground="#F4A747" FontSize="11"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding ShowArrayLimitWarning}"/>
                    </StackPanel>
                    <Slider Value="{Binding ArrayLimitExponent}"
                            Minimum="1" Maximum="14"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.ArrayLimit}"/>
                  </StackPanel>

                  <!-- DropDown Limit -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.DropDownLimit}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding DropDownLimit}"
                                 Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="40"/>
                    </StackPanel>
                    <Slider Value="{Binding DropDownLimitExponent}"
                            Minimum="6" Maximum="13"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.DropDownLimit}"/>
                  </StackPanel>

                  <!-- CE String Length -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.StringLength}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding CeStringLength}"
                                 Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="40"/>
                    </StackPanel>
                    <Slider Value="{Binding CeStringLengthExponent}"
                            Minimum="4" Maximum="12"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.StringLength}"/>
                  </StackPanel>

                  <!-- Copy CE Field: fabricate empty array slots (0 = off) -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.Fabricate}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FabricateArrayCountLabel}"
                                 Foreground="{Binding FabricateArrayCountBrush}" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="40"/>
                    </StackPanel>
                    <Slider Value="{Binding FabricateArrayCountExponent}"
                            Minimum="0" Maximum="12"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.Fabricate}"/>
                  </StackPanel>

                  <!-- Preview limit -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.PreviewLimit}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding PreviewLimit}"
                                 Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="20"/>
                    </StackPanel>
                    <Slider Value="{Binding PreviewLimit}"
                            Minimum="0" Maximum="6"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.PreviewLimit}"/>
                  </StackPanel>

                  <!-- CSX Drill Depth -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.CsxDepth}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding CsxDrilldownDepth}"
                                 Foreground="{Binding CsxDrilldownDepthBrush}"
                                 FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="20"/>
                    </StackPanel>
                    <Slider Value="{Binding CsxDrilldownDepth}"
                            Minimum="0" Maximum="8"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.CsxDepth}"/>
                  </StackPanel>

                  <Separator Background="#3C3C3C" Height="1"/>

                  <!-- Locate in GWorld depth (BFS hops from GWorld) + Deep. These are
                       persisted user preferences, so they stay editable even while
                       disconnected / when GWorld is unavailable — the user can dial them
                       in ahead of a locate. Bound through the Live Walker sub-VM that owns them. -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.GWorldDepth}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding LiveWalker.GWorldLocateDepth}"
                                 Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="20"/>
                    </StackPanel>
                    <Slider Value="{Binding LiveWalker.GWorldLocateDepth}"
                            Minimum="1" Maximum="32"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.LiveWalker.GWorldDepth}"/>
                    <!-- Deep locate: follow object pointers inside struct-array
                         elements (Value Search "Deep" analogue). Heavier. -->
                    <CheckBox Content="{StaticResource str.Toolbar.GWorldDeep}"
                              IsChecked="{Binding LiveWalker.GWorldLocateDeep}"
                              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.GWorldDeep}"
                              Foreground="#CCCCCC" FontSize="12"/>
                  </StackPanel>

                  <!-- Deep container scan cap (per-container element probe limit
                       for the Instances "Lookup" recursive deep scan). 2^exp. -->
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{StaticResource str.Toolbar.DeepScanElemCap}"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding DeepScanElemCap}"
                                 Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="40"/>
                    </StackPanel>
                    <Slider Value="{Binding DeepScanElemCapExponent}"
                            Minimum="4" Maximum="12"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip.Tip="{StaticResource str.Tip.Toolbar.DeepScanElemCap}"/>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Border>

        <!-- Export dropdown -->
        <Border Margin="8,2" VerticalAlignment="Center"
                IsVisible="{Binding IsConnected}">
          <DropDownButton Content="{StaticResource str.Toolbar.Export}"
                          ToolTip.Tip="{StaticResource str.Tip.Export}"
                          Padding="8,3" FontSize="12">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="{StaticResource str.Export.SymbolsX64dbg}"
                          Command="{Binding ExportSymbolsX64dbgCommand}"/>
                <MenuItem Header="{StaticResource str.Export.SymbolsGhidra}"
                          Command="{Binding ExportSymbolsGhidraCommand}"/>
                <MenuItem Header="{StaticResource str.Export.SymbolsIda}"
                          Command="{Binding ExportSymbolsIdaCommand}"/>
                <Separator/>
                <MenuItem Header="{StaticResource str.Export.SdkHeader}"
                          Command="{Binding ExportFullSdkCommand}"/>
                <MenuItem Header="{StaticResource str.Export.Usmap}"
                          Command="{Binding ExportUsmapCommand}"/>
                <Separator/>
                <MenuItem Header="{StaticResource str.Export.DumpAll}"
                          Command="{Binding ExportDumpAllCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Export.DumpAll}"/>
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Border>

        <!-- Tools dropdown (always available; doesn't need a DLL connection) -->
        <Border Margin="8,2" VerticalAlignment="Center">
          <DropDownButton Content="{StaticResource str.Toolbar.Tools}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools}"
                          Padding="8,3" FontSize="12">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="{StaticResource str.Tools.InjectCeBootstrap}"
                          Command="{Binding InjectCeBootstrapCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools.InjectCeBootstrap}"/>
                <MenuItem Header="{StaticResource str.Tools.InstallCeAutorun}"
                          Command="{Binding InstallCeAutorunCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools.InstallCeAutorun}"/>
                <Separator/>
                <MenuItem Header="{StaticResource str.Tools.InjectCeHelperLua}"
                          Command="{Binding InjectCeHelperLuaCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools.InjectCeHelperLua}"/>
                <MenuItem Header="{StaticResource str.Tools.ExportCeHelperLua}"
                          Command="{Binding ExportCeHelperLuaCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools.ExportCeHelperLua}"/>
                <Separator/>
                <MenuItem Header="{StaticResource str.Tools.InjectFreezeHelperLua}"
                          Command="{Binding InjectFreezeHelperLuaCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools.InjectFreezeHelperLua}"/>
                <MenuItem Header="{StaticResource str.Tools.ExportFreezeHelperLua}"
                          Command="{Binding ExportFreezeHelperLuaCommand}"
                          ToolTip.Tip="{StaticResource str.Tip.Tools.ExportFreezeHelperLua}"/>
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Border>

        <!-- Version + DLL-build indicator. The stale-DLL alert sits right next to the
             UI version (amber when the deployed DLL build differs from / pre-dates the
             UI's), and a subtle "DLL <n>" confirms a matched deploy so "no alert" isn't
             ambiguous with "the warning is broken". Both only while connected. -->
        <StackPanel Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="8,2">
          <TextBlock Text="{Binding AppVersion}"
                     Foreground="#808080" FontSize="11" VerticalAlignment="Center"/>
          <Border IsVisible="{Binding ShowBuildMismatchBadge}"
                  Background="#3A2E0A" BorderBrush="#E6A817" BorderThickness="1"
                  CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding BuildMismatchBadgeText}">
            <TextBlock Text="{Binding BuildMismatchBadgeText}"
                       Foreground="#E6A817" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       MaxWidth="440" TextTrimming="CharacterEllipsis"/>
          </Border>
          <TextBlock Text="{Binding DllBuildOkText}"
                     Foreground="#5A8C5A" FontSize="11" VerticalAlignment="Center"
                     IsVisible="{Binding ShowDllBuildOk}"
                     ToolTip.Tip="Deployed DLL build matches the UI build"/>
          <!-- UE5.7+ *** UNVERIFIED *** packed FUObjectItem layout: warn that reconstructed
               addresses and every export (CE XML / CSX / Teleport) are best-effort. -->
          <Border IsVisible="{Binding ShowPackedLayoutBadge}"
                  Background="#3A1E0A" BorderBrush="#E67817" BorderThickness="1"
                  CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding PackedLayoutBadgeText}">
            <TextBlock Text="{Binding PackedLayoutBadgeText}"
                       Foreground="#E67817" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       MaxWidth="440" TextTrimming="CharacterEllipsis"/>
          </Border>
          <!-- [W4-STRIDE-TENTATIVE] The object-array stride is a GUESS (tentative) or was not detected at all:
               object counts and names may be an alias of the real pool. -->
          <Border IsVisible="{Binding ShowStrideGuessBadge}"
                  Background="#3A1E0A" BorderBrush="#E67817" BorderThickness="1"
                  CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding StrideGuessBadgeText}">
            <TextBlock Text="{Binding StrideGuessBadgeText}"
                       Foreground="#E67817" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       MaxWidth="440" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Full-width "game thread paused" banner. Visible on every tab whenever the
         DLL reports the game thread has stopped ticking ProcessEvent (pause /
         alt-tab / breakpoint): live-camera & invoke features time out and, with
         Teleport auto-refresh on, POV polling would otherwise starve scans. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding GameThreadStalled}"
            Background="#3A2E0A" BorderBrush="#E6A817" BorderThickness="0,0,0,1"
            Padding="10,5">
      <TextBlock Text="{StaticResource str.Banner.GameThreadPaused}"
                 Foreground="#E6A817" FontSize="12" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
    </Border>

    <!-- More than one process hosts the dumper DLL. Red, not amber: unlike the paused-thread
         banner this can mean you are looking at the WRONG GAME'S data, which nothing else on
         screen would reveal. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasMultipleDumperHosts}"
            Background="#3A2226" BorderBrush="#E05252" BorderThickness="0,0,0,1"
            Padding="10,5">
      <TextBlock Text="{Binding MultipleDumperHostsWarning}"
                 Foreground="#E88" FontSize="12" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
    </Border>

    <!-- Main Content: Left Tree + Right Tabs -->
    <Grid x:Name="ContentGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350" MinWidth="200"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Object Tree, with a slim re-expand strip shown when collapsed.
           MainWindow.axaml.cs resizes TreeColumn / hides TreeSplitter in
           response to ObjectTree.IsCollapsed so the right panels get full width. -->
      <Panel Grid.Column="0">
        <!-- IsVisible resolves against this element's own DataContext (the
             ObjectTree sub-VM set just above), so bind IsCollapsed directly. -->
        <views:ObjectTreePanel DataContext="{Binding ObjectTree}"
                               IsVisible="{Binding !IsCollapsed}"/>
        <Border IsVisible="{Binding ObjectTree.IsCollapsed}"
                Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
          <Button Content="&#x25B6;"
                  Command="{Binding ObjectTree.ToggleCollapseCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ObjectTree.Expand}"
                  VerticalAlignment="Top" HorizontalAlignment="Center"
                  Margin="0,6,0,0" Padding="4,3"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#888" Cursor="Hand" FontSize="12"/>
        </Border>
      </Panel>

      <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Background="#3C3C3C"
                    ResizeDirection="Columns"/>

      <!-- Right: Tab panels -->
      <TabControl x:Name="MainTabs" Grid.Column="2" Background="#1E1E1E" Padding="4"
                  SelectedIndex="{Binding SelectedTabIndex}"
                  SelectionChanged="MainTabs_SelectionChanged">
        <!-- Tag tokens mark tabs whose toolbar/per-row buttons depend on the
             AOBMaker CE plugin. MainWindow.axaml.cs routes the tab-switch
             AOBMaker re-check by Tag (not index) so reordering/inserting tabs
             can't silently break it (see MainTabs_SelectionChanged). -->
        <TabItem Header="{StaticResource str.Tab.LiveWalker}" Tag="LiveWalker">
          <views:LiveWalkerPanel DataContext="{Binding LiveWalker}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.InstanceFinder}">
          <views:InstanceFinderPanel DataContext="{Binding InstanceFinder}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.PropertySearch}">
          <views:PropertySearchPanel DataContext="{Binding PropertySearch}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.InterestingFunctions}" Tag="InterestingFunctions">
          <views:InterestingFunctionsPanel DataContext="{Binding InterestingFunctions}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.InterestingProperties}">
          <views:InterestingPropertiesPanel DataContext="{Binding InterestingProperties}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.ValueSearch}">
          <views:ValueSearchPanel DataContext="{Binding ValueSearch}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.Console}">
          <views:ConsolePanel DataContext="{Binding Console}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.Teleport}" Tag="Teleport">
          <views:TeleportPanel DataContext="{Binding Teleport}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.GameClassFilter}">
          <views:GameClassFilterPanel DataContext="{Binding GameClassFilter}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.ClassStruct}">
          <views:ClassStructPanel DataContext="{Binding ClassStruct}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.RelatedObjects}">
          <views:RelatedObjectsPanel DataContext="{Binding RelatedObjects}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.DumpExplorer}">
          <views:DumpExplorerPanel DataContext="{Binding DumpExplorer}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.LiveFuncs}" Tag="LiveFuncs">
          <views:LiveFuncsPanel DataContext="{Binding LiveFuncs}"/>
        </TabItem>

        <!-- Fixed tail order (see MainTabIndex): the experimental tabs (hidden
             unless opted in via the System-tab credit checkbox), then Proxy
             Deploy (always 2nd-to-last), then System (always last). New tabs go
             ABOVE this block so these stay anchored at the end. -->
        <TabItem Header="{StaticResource str.Tab.DetectStats}" Tag="DetectStats"
                 IsVisible="{Binding ExperimentalEnabled}">
          <views:DetectStatsPanel DataContext="{Binding DetectStats}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.Snapshot}" Tag="Snapshot"
                 IsVisible="{Binding ExperimentalEnabled}">
          <views:SnapshotPanel DataContext="{Binding Snapshot}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.SpcQuery}" Tag="SpcQuery"
                 IsVisible="{Binding ExperimentalEnabled}">
          <views:SpcPanel DataContext="{Binding Spc}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.ClassPivot}" Tag="ClassPivot"
                 IsVisible="{Binding ExperimentalEnabled}">
          <views:ClassPivotPanel DataContext="{Binding Pivot}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.ProxyDeploy}">
          <views:ProxyDeployPanel DataContext="{Binding ProxyDeploy}"/>
        </TabItem>
        <TabItem Header="{StaticResource str.Tab.Pointers}" Tag="Pointers">
          <views:PointerPanel DataContext="{Binding Pointers}"/>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
