<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             xmlns:conv="using:UE5DumpUI.Converters"
             xmlns:views="using:UE5DumpUI.Views"
             x:Class="UE5DumpUI.Views.LiveWalkerPanel"
             x:DataType="vm:LiveWalkerViewModel">

  <UserControl.Resources>
    <!-- Specular-shine confinement mask (relative, so it tracks the image on
         resize). The empty-state logo's own edge-fade is now baked into the
         PNG's alpha (a separable rectangular feather — see Assets/UE5CEDumper.png),
         so the Image needs no mask. This radial alpha brush only confines the
         rare "shine" sweep to the logo's circular area: inner region opaque
         (#FFFFFFFF), outer ring transparent (#00FFFFFF). -->
    <RadialGradientBrush x:Key="LogoShineMask"
                         Center="50%,50%" GradientOrigin="50%,50%"
                         RadiusX="50%" RadiusY="58%">
      <GradientStop Offset="0.0"  Color="#FFFFFFFF"/>
      <GradientStop Offset="0.78" Color="#FFFFFFFF"/>
      <GradientStop Offset="1.0"  Color="#00FFFFFF"/>
    </RadialGradientBrush>
  </UserControl.Resources>

  <DockPanel Margin="8">
    <!-- Top toolbar row 1: Navigation -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <Button Content="{StaticResource str.LiveWalker.StartWorld}"
              Command="{Binding StartFromWorldCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.StartWorld}"
              Classes="accent" Padding="12,4"/>
      <Button Content="{StaticResource str.LiveWalker.StartGameEngine}"
              Command="{Binding StartFromGameEngineCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.StartGameEngine}"
              Padding="12,4"/>
      <Button Content="{StaticResource str.LiveWalker.Back}"
              Command="{Binding GoBackCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.Back}"
              Padding="8,4"/>
      <!-- Forward: re-enter the level Back just left. Disabled (rather than hidden)
           when the forward history is empty, so the pair reads like a browser. -->
      <Button Content="{StaticResource str.LiveWalker.Forward}"
              Command="{Binding GoForwardCommand}"
              IsEnabled="{Binding CanGoForward}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.Forward}"
              Padding="8,4"/>
      <Button Content="{StaticResource str.LiveWalker.Parent}"
              Command="{Binding GoToParentCommand}"
              IsVisible="{Binding HasParent}"
              Padding="8,4"
              Foreground="#C586C0"
              ToolTip.Tip="Navigate to parent (OuterPrivate)"/>
      <!-- Find References: reverse-scan all UObjects for ones that point to
           the current UObject (direct ObjectProperty fields + TArray<UObject*>
           elements, including nested in StructProperty). Resolves the
           "logical owner" question that OuterPrivate doesn't answer for
           runtime-spawned objects (e.g. an Item created by a player's
           Inventory — Outer is /Engine/Transient, but Find References
           returns the actual PlayerInventory.Items[N]). -->
      <Button Content="{StaticResource str.LiveWalker.FindRefs}"
              Command="{Binding FindReferencesCommand}"
              IsVisible="{Binding HasData}"
              Padding="8,4"
              Foreground="#4EC9B0"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FindRefs}"/>
      <Button Content="{StaticResource str.Related.ShowButton}"
              Command="{Binding ShowRelatedObjectsCommand}"
              IsVisible="{Binding HasData}"
              Padding="8,4"
              Foreground="#CE9178"
              ToolTip.Tip="{StaticResource str.Tip.Related.Show}"/>
      <Button Content="{StaticResource str.LiveWalker.Refresh}"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.Refresh}"
              Padding="8,4"/>
      <!-- Auto-refresh toggle + interval -->
      <ToggleButton Content="{StaticResource str.LiveWalker.AutoRefresh}"
                    IsChecked="{Binding IsAutoRefreshing}"
                    IsVisible="{Binding HasData}"
                    Padding="8,4"
                    ToolTip.Tip="Toggle automatic refresh"/>
      <NumericUpDown Value="{Binding AutoRefreshIntervalSec}"
                     Minimum="{Binding AutoRefreshMinSec}"
                     Maximum="60" Increment="1"
                     IsVisible="{Binding HasData}"
                     Width="140" Padding="4,2" FontSize="12"
                     Foreground="#D4D4D4"
                     FormatString="0"
                     ShowButtonSpinner="True"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     ToolTip.Tip="Auto-refresh interval (seconds)"/>
      <TextBlock Text="{Binding AutoRefreshStatusText}"
                 Foreground="#888" VerticalAlignment="Center" FontSize="11"
                 IsVisible="{Binding HasData}"/>

      <!-- Bookmark controls (inline, after auto-refresh). Visible when there's a live
           object OR any saved bookmark, so persisted bookmarks are clickable right
           after connecting (before the user has navigated). -->
      <Border BorderBrush="#444" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="8,0,0,0"
              IsVisible="{Binding ShowBookmarkBar}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <!-- Save bookmark toggle (★) — yellow when active, grey when idle -->
          <Panel>
            <Button Content="{StaticResource str.LiveWalker.BookmarkSave}"
                    Command="{Binding ToggleBookmarkSaveModeCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.LiveWalker.BookmarkSave}"
                    Padding="6,4" FontSize="13" MinWidth="28"
                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                    Foreground="#888"
                    IsVisible="{Binding !IsBookmarkSaveMode}"/>
            <Button Content="{StaticResource str.LiveWalker.BookmarkSave}"
                    Command="{Binding ToggleBookmarkSaveModeCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.LiveWalker.BookmarkSaveActive}"
                    Padding="6,4" FontSize="13" MinWidth="28"
                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                    Foreground="#DCDCAA"
                    IsVisible="{Binding IsBookmarkSaveMode}"/>
          </Panel>
          <!-- Bookmark slots -->
          <ItemsControl ItemsSource="{Binding BookmarkSlots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BookmarkSlot">
                <Button Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).LoadBookmarkCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding TooltipText}"
                        Padding="5,3" MinWidth="30" FontSize="11"
                        Background="Transparent" BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand">
                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="{StaticResource str.LiveWalker.BookmarkClearOne}"
                                IsEnabled="{Binding IsOccupied}"
                                Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).ClearBookmarkSlotCommand}"
                                CommandParameter="{Binding}"/>
                    </MenuFlyout>
                  </Button.ContextFlyout>
                  <Panel>
                    <TextBlock Text="{Binding Label}"
                               IsVisible="{Binding IsOccupied}"
                               Foreground="#4EC9B0"/>
                    <TextBlock Text="{Binding DisplayNumber}"
                               IsVisible="{Binding !IsOccupied}"
                               Foreground="#555"/>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Clear all bookmarks (visible only when at least one slot is filled).
               Right-click a single slot to clear just that one. -->
          <Button Content="{StaticResource str.LiveWalker.BookmarkClearAll}"
                  Command="{Binding ClearAllBookmarksAndPersistCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.LiveWalker.BookmarkClearAll}"
                  IsVisible="{Binding AnyBookmarkOccupied}"
                  Padding="5,3" MinWidth="24" FontSize="11"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Foreground="#888" Cursor="Hand"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Top toolbar row 2: Address + Export -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox PlaceholderText="{StaticResource str.LiveWalker.AddressHint}"
               x:Name="AddressInput"
               KeyDown="AddressInput_KeyDown"
               ToolTip.Tip="{StaticResource str.Tip.LiveWalker.AddressInput}"
               Width="280" Padding="4,2"/>
      <Button Content="{StaticResource str.LiveWalker.Go}"
              Command="{Binding NavigateToAddressCommand}"
              CommandParameter="{Binding #AddressInput.Text}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.Go}"
              Padding="8,4"/>
      <!-- "Locate in GWorld" search depth moved to the top Options flyout
           ("Locate in GWorld depth"). -->
      <Button Content="{StaticResource str.LiveWalker.ExportCE}"
              Command="{Binding ExportCeXmlCommand}"
              IsVisible="{Binding HasData}"
              IsEnabled="{Binding !IsExporting}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportCE}"
              Padding="8,4"/>
      <Button Content="{Binding ExportCeFieldButtonLabel}"
              Command="{Binding ExportCeFieldXmlCommand}"
              IsVisible="{Binding HasSelectedFields}"
              IsEnabled="{Binding !IsExporting}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportCEField}"
              Padding="8,4"/>
      <!-- Abort the drilldown pipe-walk of an in-flight Copy CE XML / Copy CE Field
           export. Only visible while IsExporting; mirrors the Value Search Cancel style. -->
      <Button Content="{StaticResource str.LiveWalker.CancelExport}"
              Command="{Binding CancelExportCommand}"
              IsVisible="{Binding IsExporting}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CancelExport}"
              Foreground="#F44747" BorderBrush="#F44747" BorderThickness="1"
              Background="Transparent" Padding="8,4"/>
      <Button Content="{StaticResource str.LiveWalker.PushCeField}"
              Command="{Binding PushCeFieldToCeCommand}"
              IsVisible="{Binding HasSelectedFields}"
              IsEnabled="{Binding IsAobMakerAvailable}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.PushCeField}"
              Foreground="#C586C0"
              Padding="8,4"/>
      <!-- Consolidated export options: memory-record Description format (+Offset /
           +Type) plus the AOB / Collapse chain / Guess? toggles that used to be inline
           checkboxes. The AOB item keeps its IsEnabled=CanUseAobSymbol gray-out and the
           Guess? item keeps reflecting the VM's auto-check (SetFillGapsSilently). -->
      <DropDownButton Content="{StaticResource str.LiveWalker.ExportOptions}"
                      IsVisible="{Binding HasData}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportOptions}"
                      Padding="8,4" VerticalAlignment="Center">
        <DropDownButton.Flyout>
          <!-- MenuFlyout + checkable MenuItems: same proven pattern as Export CSX,
               with reliable DataContext inheritance and TwoWay IsChecked write-back
               (a plain Flyout's content did NOT reliably write the toggles back). -->
          <MenuFlyout Placement="Bottom">
            <MenuItem Header="{StaticResource str.LiveWalker.DescShowOffset}"
                      ToggleType="CheckBox" IsChecked="{Binding DescShowOffset, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.DescShowOffset}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.DescShowType}"
                      ToggleType="CheckBox" IsChecked="{Binding DescShowType, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.DescShowType}"/>
            <Separator/>
            <MenuItem Header="{StaticResource str.LiveWalker.AobToggle}"
                      ToggleType="CheckBox" IsChecked="{Binding UseAobSymbol, Mode=TwoWay}"
                      IsEnabled="{Binding CanUseAobSymbol}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.AobToggle}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.CollapseChain}"
                      ToggleType="CheckBox" IsChecked="{Binding CollapseChain, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CollapseChain}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.FlattenGas}"
                      ToggleType="CheckBox" IsChecked="{Binding FlattenGasAttributes, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FlattenGas}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.FlattenLeafStructs}"
                      ToggleType="CheckBox" IsChecked="{Binding FlattenLeafStructs, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FlattenLeafStructs}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.FlattenLeafRecords}"
                      ToggleType="CheckBox" IsChecked="{Binding FlattenLeafRecords, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FlattenLeafRecords}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.RecordColors}"
                      Command="{Binding OpenFlattenColorsCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.RecordColors}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.CollapseLeafPointers}"
                      ToggleType="CheckBox" IsChecked="{Binding CollapseLeafPointers, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CollapseLeafPointers}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.DedupShared}"
                      ToggleType="CheckBox" IsChecked="{Binding DedupSharedObjects, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.DedupShared}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.ExcludeSysComponents}"
                      ToggleType="CheckBox" IsChecked="{Binding ExcludeSystemComponents, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExcludeSysComponents}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.GuessWhat}"
                      ToggleType="CheckBox" IsChecked="{Binding FillGaps, Mode=TwoWay}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.GuessWhat}"/>
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Content="{StaticResource str.LiveWalker.ExportCsx}"
                      IsVisible="{Binding HasData}"
                      IsEnabled="{Binding !IsExporting}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportCsx}"
                      Padding="8,4">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="{StaticResource str.LiveWalker.ExportCsxPre77}"
                      Command="{Binding ExportCsxPre77Command}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportCsxPre77}"/>
            <MenuItem Header="{StaticResource str.LiveWalker.ExportCsx77}"
                      Command="{Binding ExportCsx77Command}"
                      ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportCsx77}"/>
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Content="{StaticResource str.LiveWalker.ExportHeader}"
              Command="{Binding ExportSdkHeaderCommand}"
              IsVisible="{Binding HasData}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.ExportHeader}"
              Padding="8,4"/>
      <!-- "Copy CE AA Script" moved to the object-info header row as a compact
           "AA" button (next to HEX / Addr / Name / Class), where it sits with the
           object it registers. -->
    </StackPanel>

    <!-- Breadcrumb -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BreadcrumbItem">
          <StackPanel Orientation="Horizontal">
            <Button Content="{Binding Label}"
                    Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).NavigateToBreadcrumbCommand}"
                    CommandParameter="{Binding}"
                    Padding="4,2" Margin="0,0,2,0"
                    Foreground="#4EC9B0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand"/>
            <TextBlock Text=">" Foreground="#666" VerticalAlignment="Center" Margin="2,0"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Object info header -->
    <Border DockPanel.Dock="Top" Background="#252525" Padding="8,4" Margin="0,0,0,4"
            IsVisible="{Binding HasData}" CornerRadius="4">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- AOT: bind TextBlock.Text directly, NOT via a child <Run Text=...>.
               A single-binding <Run> inside <TextBlock> StackOverflows under
               Native AOT (aot-pitfalls.md §0.25 / §4.10). -->
          <TextBlock Foreground="#569CD6" FontWeight="Bold" Text="{Binding CurrentClassName}"/>
          <TextBlock Foreground="#D4D4D4" Text="{Binding CurrentObjectName}"/>
          <TextBlock Foreground="#666" FontFamily="Consolas" FontSize="12" Text="{Binding CurrentAddress}"/>
          <!-- AOBMaker HEX button for current object address -->
          <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                  Command="{Binding HexObjectAddressCommand}"
                  IsEnabled="{Binding IsAobMakerAvailable}"
                  ToolTip.Tip="{StaticResource str.LiveWalker.HexObjectTip}"
                  Padding="4,2" Margin="4,0,0,0"
                  FontSize="10" FontFamily="Consolas"
                  Foreground="#569CD6" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
          <!-- Copy buttons for current object -->
          <Button Content="Addr"
                  Command="{Binding CopyCurrentAddressCommand}"
                  Padding="3,1"
                  Foreground="#D4D4D4" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10"
                  ToolTip.Tip="Copy CE address"/>
          <Button Content="Name"
                  Command="{Binding CopyCurrentNameCommand}"
                  Padding="3,1"
                  Foreground="#D4D4D4" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10"
                  ToolTip.Tip="Copy object name"/>
          <!-- Copy the class name to clipboard -->
          <Button Content="{StaticResource str.LiveWalker.CopyClass}"
                  Command="{Binding CopyCurrentClassNameCommand}"
                  Padding="3,1"
                  Foreground="#D4D4D4" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10"
                  ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CopyClass}"/>
          <!-- "Copy CE AA Script" (relocated from the export toolbar): pushes
               straight into CE's address list when the AOBMaker plugin is
               connected, otherwise copies the CheatTable XML to the clipboard. -->
          <Button Content="{StaticResource str.LiveWalker.CeAAShort}"
                  Command="{Binding GenerateCeAAScriptCommand}"
                  Padding="3,1"
                  Foreground="#E5C07B" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10" FontWeight="Bold"
                  ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CeAA}"/>
        </StackPanel>
        <!-- Parent (Outer) info -->
        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding HasParent}">
          <TextBlock Text="Outer:" Foreground="#888" FontSize="11"/>
          <Button Command="{Binding GoToParentCommand}"
                  Padding="2,0" Background="Transparent" BorderThickness="0"
                  Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- AOT: TextBlock.Text directly (see note above — no <Run>). -->
              <TextBlock Foreground="#C586C0" FontSize="11" Text="{Binding CurrentOuterClassName}"/>
              <TextBlock Foreground="#CE9178" FontSize="11" Text="{Binding CurrentOuterName}"/>
              <TextBlock Foreground="#666" FontFamily="Consolas" FontSize="11" Text="{Binding CurrentOuterAddr}"/>
            </StackPanel>
          </Button>
          <!-- Outer helper buttons (HEX / Addr / Name / Class), mirroring the
               object-info row above. HEX needs the AOBMaker plugin. -->
          <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                  Command="{Binding HexOuterAddressCommand}"
                  IsEnabled="{Binding IsAobMakerAvailable}"
                  ToolTip.Tip="{StaticResource str.LiveWalker.HexOuterTip}"
                  Padding="4,2"
                  FontSize="10" FontFamily="Consolas"
                  Foreground="#569CD6" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
          <Button Content="Addr"
                  Command="{Binding CopyOuterAddressCommand}"
                  Padding="3,1"
                  Foreground="#D4D4D4" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10"
                  ToolTip.Tip="Copy Outer CE address"/>
          <Button Content="Name"
                  Command="{Binding CopyOuterNameCommand}"
                  Padding="3,1"
                  Foreground="#D4D4D4" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10"
                  ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CopyOuterName}"/>
          <Button Content="{StaticResource str.LiveWalker.CopyClass}"
                  Command="{Binding CopyOuterClassNameCommand}"
                  Padding="3,1"
                  Foreground="#D4D4D4" Background="Transparent"
                  BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand" FontSize="10"
                  ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CopyOuterClass}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Reverse references panel: appears after Find References completes.
         Shows every UObject found to point at the current UObject (direct
         field or array element). Click "Open" to navigate to that owner —
         this is the "logical parent" the OuterPrivate Parent button
         frequently can't surface for runtime-spawned objects. -->
    <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="4"
            Padding="6" Margin="0,0,0,4"
            IsVisible="{Binding HasReferences}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock Text="{Binding ReferencesHeader}"
                     Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"
                     VerticalAlignment="Center"/>
          <Button Content="✕" Command="{Binding ClearReferencesCommand}"
                  Padding="4,0" FontSize="11"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#888" Cursor="Hand"
                  ToolTip.Tip="Hide references list"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding References}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="0"
                  Background="#1E1E1E"
                  Foreground="#D4D4D4"
                  FontFamily="Consolas" FontSize="11"
                  MaxHeight="160"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Reference Path"
                                Binding="{Binding DisplayPath}" SortMemberPath="DisplayPath"
                                Width="420" MinWidth="220"/>
            <DataGridTextColumn Header="Owner Class"
                                Binding="{Binding OwnerClassName}" SortMemberPath="OwnerClassName"
                                Width="220" MinWidth="140"/>
            <DataGridTextColumn Header="Field Type"
                                Binding="{Binding FieldType}" SortMemberPath="FieldType"
                                Width="120"/>
            <DataGridTextColumn Header="Owner Addr"
                                Binding="{Binding OwnerAddress}" SortMemberPath="OwnerAddress"
                                Width="140"/>
            <DataGridTemplateColumn Header="" Width="80" CanUserResize="False" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="m:ReferenceMatch">
                  <Button Content="Open"
                          Command="{Binding $parent[DataGrid].((vm:LiveWalkerViewModel)DataContext).OpenReferenceOwnerCommand}"
                          CommandParameter="{Binding}"
                          Padding="6,2" FontSize="11"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!-- Search bar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4"
                IsVisible="{Binding HasData}">
      <!-- AutoCompleteBox surfaces the per-session remembered keywords (LRU,
           longest-valid). FilterMode=Contains so typing "m" lists "magic". -->
      <AutoCompleteBox PlaceholderText="{StaticResource str.LiveWalker.SearchHint}"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       ItemsSource="{Binding SearchHistory}"
                       FilterMode="Contains"
                       ToolTip.Tip="{StaticResource str.Tip.LiveWalker.Search}"
                       Width="250" Padding="4,2" FontSize="12"/>
      <!-- Prev / next match navigation: search only re-colours matches, so
           these step the selection between them (wrap-around). Enabled only
           when there are matches. -->
      <Button Content="{StaticResource str.LiveWalker.MatchPrev}"
              Command="{Binding PrevSearchMatchCommand}"
              IsEnabled="{Binding HasSearchResults}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.MatchPrev}"
              Padding="7,2" FontSize="11" Cursor="Hand"
              Foreground="#4EC9B0" Background="Transparent"
              BorderThickness="1" BorderBrush="#555"
              VerticalAlignment="Center"/>
      <Button Content="{StaticResource str.LiveWalker.MatchNext}"
              Command="{Binding NextSearchMatchCommand}"
              IsEnabled="{Binding HasSearchResults}"
              ToolTip.Tip="{StaticResource str.Tip.LiveWalker.MatchNext}"
              Padding="7,2" FontSize="11" Cursor="Hand"
              Foreground="#4EC9B0" Background="Transparent"
              BorderThickness="1" BorderBrush="#555"
              VerticalAlignment="Center"/>
      <TextBlock Text="{Binding SearchMatchCount, StringFormat='{}{0} matches'}"
                 Foreground="#888" VerticalAlignment="Center" FontSize="12"
                 IsVisible="{Binding HasSearchResults}"/>
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}" Height="2" Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
               Foreground="#AAB8D0" FontSize="11" Margin="4,0,0,2"
               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <!-- Failure surface. This panel's VM calls SetError 28 times — including the
         refresh path's 10 s hard timeout — and NOTHING rendered ErrorMessage, so a
         dead refresh was pixel-identical to a live one while stale values kept
         showing. ClearStatus() had already blanked StatusText above, so there was
         not even a leftover line to contradict. (audit #5 U1/V7) -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
               Foreground="#F48771" FontSize="11.5" TextWrapping="Wrap"
               Margin="4,0,4,2"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Field list + Functions split -->
    <Grid RowDefinitions="*,Auto">
    <Panel Grid.Row="0">
    <DataGrid x:Name="FieldGrid"
              ItemsSource="{Binding Fields}"
              SelectedItem="{Binding SelectedField}"
              SelectionMode="Extended"
              IsReadOnly="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              Background="#1E1E1E"
              FontFamily="Consolas" FontSize="12"
              HorizontalScrollBarVisibility="Auto"
              LoadingRow="FieldGrid_LoadingRow"
              BeginningEdit="FieldGrid_BeginningEdit"
              CellEditEnded="FieldGrid_CellEditEnded"
              SelectionChanged="FieldGrid_SelectionChanged">
      <DataGrid.ContextMenu>
        <ContextMenu x:DataType="vm:LiveWalkerViewModel">
          <MenuItem Header="{StaticResource str.Pivot.ThisProperty}"
                    Command="{Binding PivotThisCommand}"
                    CommandParameter="{Binding SelectedField}"
                    IsVisible="{Binding PivotEnabled}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Offset}"
                            Binding="{Binding Offset, StringFormat='0x{0:X}'}" SortMemberPath="Offset"
                            Width="75" IsReadOnly="True"/>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Name}"
                            Binding="{Binding Name}" SortMemberPath="Name"
                            Width="220" MinWidth="140" IsReadOnly="True"/>
        <DataGridTextColumn Header="{StaticResource str.ClassStruct.Type}"
                            Binding="{Binding TypeName}" SortMemberPath="TypeName"
                            Width="115" IsReadOnly="True"/>
        <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.Value}"
                                SortMemberPath="DisplayValue"
                                CanUserSort="True"
                                Width="200" MinWidth="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:LiveFieldValue">
              <TextBlock Text="{Binding DisplayValue}"
                         VerticalAlignment="Center" Margin="4,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate x:DataType="m:LiveFieldValue">
              <Panel>
                <!-- BoolProperty: dropdown with true/false -->
                <ComboBox IsVisible="{Binding IsBoolProperty}"
                          ItemsSource="{x:Static m:LiveFieldValue.BoolOptions}"
                          SelectedItem="{Binding EditableValue, Mode=TwoWay}"
                          Loaded="BoolCombo_Loaded"
                          SelectionChanged="BoolCombo_SelectionChanged"
                          Padding="2,1" BorderThickness="1"
                          BorderBrush="#569CD6"
                          HorizontalAlignment="Stretch"/>
                <!-- Other editable types: free-text input -->
                <TextBox IsVisible="{Binding !IsBoolProperty}"
                         Text="{Binding EditableValue, Mode=TwoWay}"
                         KeyDown="EditBox_KeyDown"
                         Padding="4,2" BorderThickness="1"
                         BorderBrush="#569CD6"/>
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Hex"
                            Binding="{Binding HexValue}" SortMemberPath="HexValue"
                            Width="130" IsReadOnly="True"/>
        <DataGridTextColumn Header="{StaticResource str.InstanceFinder.Address}"
                            Binding="{Binding FieldAddress}" SortMemberPath="FieldAddress"
                            Width="135" IsReadOnly="True"/>
        <DataGridTextColumn Header="{StaticResource str.LiveWalker.PtrValue}"
                            Binding="{Binding PtrAddress}" SortMemberPath="PtrAddress"
                            Width="135" IsReadOnly="True"/>
        <DataGridTemplateColumn Header="" Width="45" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:LiveFieldValue">
              <StackPanel Orientation="Horizontal">
                <!-- Pointer navigation: arrow icon -->
                <Button Content="&#x2192;"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).NavigateToFieldCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding IsPointerNavigation}"
                        Padding="8,2" Margin="2"
                        Foreground="#4EC9B0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#4EC9B0"
                        Cursor="Hand" FontWeight="Bold"
                        ToolTip.Tip="Navigate to pointer target"/>
                <!-- Struct navigation: braces icon -->
                <Button Content="{}{}"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).NavigateToFieldCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding IsStructNavigation}"
                        Padding="8,2" Margin="2"
                        Foreground="#E5C07B" Background="Transparent"
                        BorderThickness="1" BorderBrush="#E5C07B"
                        Cursor="Hand" FontWeight="Bold"
                        ToolTip.Tip="Expand inline struct"/>
                <!-- Container navigation: bracket icon (Array/Map/Set) -->
                <Button Content="[]"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).NavigateToContainerCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding IsContainerNavigable}"
                        Padding="8,2" Margin="2"
                        Foreground="#61AFEF" Background="Transparent"
                        BorderThickness="1" BorderBrush="#61AFEF"
                        Cursor="Hand" FontWeight="Bold"
                        ToolTip.Tip="View container elements"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.CopyAddress}" Width="112" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:LiveFieldValue">
              <StackPanel Orientation="Horizontal">
                <Button Content="Addr"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).CopyFieldAddressCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CopyFieldAddr}"
                        Padding="4,2" Margin="2"
                        Foreground="#D4D4D4" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"/>
                <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).HexFieldAddressCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).IsAobMakerAvailable}"
                        ToolTip.Tip="{StaticResource str.LiveWalker.HexFieldTip}"
                        Padding="3,2" Margin="0,2,2,2"
                        Foreground="#569CD6" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="9" FontFamily="Consolas"/>
                <Button Content="{StaticResource str.LiveWalker.AddToCe}"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).AddFieldToCeCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).IsAobMakerAvailable}"
                        ToolTip.Tip="{StaticResource str.Tip.LiveWalker.AddFieldToCe}"
                        Padding="3,2" Margin="0,2,2,2"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="9" FontFamily="Consolas"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.CopyName}" Width="92" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:LiveFieldValue">
              <StackPanel Orientation="Horizontal">
                <Button Content="Name"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).CopyFieldNameCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.LiveWalker.CopyFieldName}"
                        Padding="4,2" Margin="2"
                        Foreground="#D4D4D4" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"/>
                <!-- inst: open the field's object class in the Instance Finder tab
                     (visible only for object-pointer fields, where PtrClassName is
                     the live class of the referenced object). -->
                <Button Content="{StaticResource str.IF.OpenInst}"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).OpenFieldInInstanceFinderCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding PtrClassName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FieldInst}"
                        Padding="4,2" Margin="0,2,2,2"
                        Foreground="#4EC9B0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.LiveWalker.CopyPtr}" Width="112" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:LiveFieldValue">
              <StackPanel Orientation="Horizontal"
                          IsVisible="{Binding IsPointerNavigation}">
                <Button Content="Ptr"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).CopyPtrAddressCommand}"
                        CommandParameter="{Binding}"
                        Padding="4,2" Margin="2"
                        Foreground="#4EC9B0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="10"
                        ToolTip.Tip="Copy pointer target address"/>
                <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).HexPtrAddressCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).IsAobMakerAvailable}"
                        ToolTip.Tip="{StaticResource str.LiveWalker.HexPtrTip}"
                        Padding="3,2" Margin="0,2,2,2"
                        Foreground="#4EC9B0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="9" FontFamily="Consolas"/>
                <Button Content="{StaticResource str.LiveWalker.AddToCe}"
                        Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).AddPtrToCeCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).IsAobMakerAvailable}"
                        ToolTip.Tip="{StaticResource str.Tip.LiveWalker.AddPtrToCe}"
                        Padding="3,2" Margin="0,2,2,2"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#555"
                        Cursor="Hand" FontSize="9" FontFamily="Consolas"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Empty-state logo: shown when DataGrid has no data AND there is no
         locate-failure banner to display (the banner takes over the area).
         Wrapped in a Grid so (a) the soft-fade vignette OpacityMask and the
         rare specular "shine" overlay both track the image's rendered rect
         (the Image sizes the Grid; the shine Border fills it), and (b) both
         reuse one relative RadialGradientBrush so they scale together on
         resize. The MaxWidth/MaxHeight bindings moved from the Image to this
         wrapper because $parent[Panel] would otherwise resolve to the wrapper
         Grid (Grid is a Panel) instead of the outer empty-state panel. -->
    <Grid IsVisible="{Binding ShowEmptyStateLogo}"
          IsHitTestVisible="False"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="{Binding $parent[Panel].Bounds.Width, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.75}"
          MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={x:Static conv:MultiplyConverter.Instance}, ConverterParameter=0.75}">
      <!-- Edge-fade is baked into the PNG's alpha (separable rectangular
           feather), so all four edges dissolve into the panel background and
           the fade scales with the image automatically. -->
      <Image Source="/Assets/UE5CEDumper.png"
             Opacity="0.6"
             Stretch="Uniform"/>
      <!-- Specular sweep overlay: hidden (Opacity=0) until a rare timer roll
           drives a one-shot diagonal glint (see LiveWalkerPanel.axaml.cs,
           PlayShineAsync). Clipped to the image rect and feathered by the same
           vignette so the glint stays within the logo's visible shape. -->
      <Border x:Name="LogoShine"
              Opacity="0"
              ClipToBounds="True"
              OpacityMask="{StaticResource LogoShineMask}">
        <Rectangle x:Name="LogoShineBar"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   RenderTransformOrigin="50%,50%">
          <Rectangle.Fill>
            <!-- A soft white band across the middle; rotated + swept by code. -->
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0.00" Color="#00FFFFFF"/>
              <GradientStop Offset="0.42" Color="#00FFFFFF"/>
              <GradientStop Offset="0.50" Color="#A6FFFFFF"/>
              <GradientStop Offset="0.58" Color="#00FFFFFF"/>
              <GradientStop Offset="1.00" Color="#00FFFFFF"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Border>
    </Grid>

    <!-- Locate-in-GWorld failure banner: replaces the idle logo so a failed
         locate doesn't look identical to "nothing loaded yet". Shows the full
         actionable reason (not_reachable / deadline / exception) prominently. -->
    <Border IsVisible="{Binding HasLocateFailure}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            MaxWidth="600" Margin="24"
            Background="#2A1E14" BorderBrush="#E0A050" BorderThickness="1,1,1,6"
            CornerRadius="6" Padding="20,16">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="⚠" FontSize="28" Foreground="#E0A050"
                   VerticalAlignment="Top"/>
        <StackPanel Spacing="6" MaxWidth="500">
          <TextBlock Text="{Binding LocateFailureTitle}"
                     Foreground="#F0C070" FontSize="14" FontWeight="Bold"/>
          <TextBlock Text="{Binding LocateFailureMessage}"
                     Foreground="#D4D4D4" FontSize="12.5"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Credit footer: pinned to the bottom of the empty-state panel so
         the attribution sits visibly below the logo. Hidden once the
         DataGrid has data and takes over the area. -->
    <views:CreditFooter IsVisible="{Binding !HasData}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"/>
    </Panel>

    <!-- Functions section (collapsible) -->
    <Expander Grid.Row="1" IsVisible="{Binding HasFunctions}"
              Header="{StaticResource str.LiveWalker.Functions}"
              IsExpanded="{Binding IsFunctionsExpanded, Mode=TwoWay}" Margin="0,4,0,0"
              MaxHeight="280">
      <DockPanel>
        <!-- Filter row: substring match on function name -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6"
                    Margin="2,2,2,4">
          <AutoCompleteBox Text="{Binding FunctionFilter, Mode=TwoWay}"
                   ItemsSource="{Binding FunctionFilterHistory}"
                   FilterMode="Contains"
                   PlaceholderText="Filter by name..."
                   Width="220" Padding="4,2" FontSize="12"
                   ToolTip.Tip="Substring match on function name (case-insensitive)"/>
          <Button Content="Clear"
                  Command="{Binding ClearFunctionFilterCommand}"
                  Padding="6,2"
                  IsEnabled="{Binding FunctionFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="Clear filter"/>
          <TextBlock VerticalAlignment="Center" Foreground="#888" FontSize="11"
                     Text="{Binding Functions.Count, StringFormat='{}{0} shown'}"/>
          <!-- AOBMaker availability indicator — single place (build 688).
               Previously this lived in a Notes column repeated per-row,
               which was pure noise. Visible only when the plugin isn't
               reachable. -->
          <TextBlock Text="{Binding AobMakerNote}"
                     IsVisible="{Binding AobMakerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="#E0A050"
                     FontSize="11"
                     FontStyle="Italic"
                     VerticalAlignment="Center"
                     Margin="6,0,0,0"
                     ToolTip.Tip="{Binding AobMakerNote}"/>
        </StackPanel>
      <DataGrid x:Name="FunctionGrid"
                ItemsSource="{Binding Functions}"
                SelectedItem="{Binding SelectedFunction}"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                Background="#1E1E1E"
                FontFamily="Consolas" FontSize="12"
                Focusable="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="200" MinWidth="120"/>
          <DataGridTextColumn Header="Return" Binding="{Binding ReturnType}" SortMemberPath="ReturnType" Width="100"/>
          <DataGridTextColumn Header="Params" Width="90" SortMemberPath="NumParms">
            <DataGridTextColumn.Binding>
              <MultiBinding StringFormat="{}{0} ({1}B)">
                <Binding Path="NumParms"/>
                <Binding Path="ParmsSize"/>
              </MultiBinding>
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Address" Binding="{Binding Address}" SortMemberPath="Address" Width="140"/>
          <DataGridTemplateColumn Header="" Width="320" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:FunctionInfoModel">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <!-- The Functions grid sits at the window bottom, so the
                       default "Pointer" tooltip placement flips upward and
                       lands on the cursor — hover ends → tooltip dismisses →
                       cursor re-enters → repeat, seen as a blinking hint on the
                       bottom row's INV/PIPE/AA(Baked) buttons. Force the tip
                       above the button, away from the cursor (same fix as
                       ProxyDeployPanel's bottom button bar). -->
                  <StackPanel.Styles>
                    <Style Selector="Button">
                      <Setter Property="ToolTip.Placement" Value="Top"/>
                      <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
                    </Style>
                  </StackPanel.Styles>
                  <Button Content="{StaticResource str.LiveWalker.FuncGenScript}"
                          Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).GenerateInvokeScriptCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).IsAobMakerAvailable}"
                          Padding="6,2" Margin="2,2,0,2"
                          Foreground="#DCDCAA" Background="Transparent"
                          BorderThickness="1" BorderBrush="#DCDCAA"
                          Cursor="Hand" FontWeight="Bold" FontSize="11"
                          ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FuncGenScript}"
                          ClickMode="Press"/>
                  <Button Content="{StaticResource str.LiveWalker.FuncPipeInvoke}"
                          Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).InvokeViaPipeCommand}"
                          CommandParameter="{Binding}"
                          Padding="6,2" Margin="0,2,0,2"
                          Foreground="#4EC9B0" Background="Transparent"
                          BorderThickness="1" BorderBrush="#4EC9B0"
                          Cursor="Hand" FontWeight="Bold" FontSize="11"
                          ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FuncPipeInvoke}"
                          ClickMode="Press"/>
                  <Button Content="{StaticResource str.LiveWalker.FuncCopyBaked}"
                          Command="{Binding $parent[UserControl].((vm:LiveWalkerViewModel)DataContext).CopyBakedScriptCommand}"
                          CommandParameter="{Binding}"
                          Padding="6,2" Margin="0,2,2,2"
                          Foreground="#7FB6E8" Background="Transparent"
                          BorderThickness="1" BorderBrush="#7FB6E8"
                          Cursor="Hand" FontWeight="Bold" FontSize="11"
                          ToolTip.Tip="{StaticResource str.Tip.LiveWalker.FuncCopyBaked}"
                          ClickMode="Press"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- (Build 688) Notes column removed — the value was identical
               on every row (VM-level AOBMaker status). The function-list
               toolbar above the grid carries the same indicator when the
               plugin isn't reachable, so per-row repetition was pure noise. -->
        </DataGrid.Columns>
      </DataGrid>
      </DockPanel>
    </Expander>
    </Grid>
  </DockPanel>
</UserControl>
