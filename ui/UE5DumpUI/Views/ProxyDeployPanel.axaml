<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.ProxyDeployPanel"
             x:DataType="vm:ProxyDeployViewModel">

  <DockPanel Margin="8">
    <!-- Top: scan source selector (Steam library vs generic drive scan) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
      <TextBlock Text="{StaticResource str.ProxyDeploy.Source}"
                 Foreground="#CCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
      <RadioButton GroupName="ScanSource"
                   Content="{StaticResource str.ProxyDeploy.Source.Steam}"
                   IsChecked="{Binding IsSteamSource, Mode=TwoWay}"
                   ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Source}"
                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
      <RadioButton GroupName="ScanSource"
                   Content="{StaticResource str.ProxyDeploy.Source.Drives}"
                   IsChecked="{Binding IsDriveSource, Mode=TwoWay}"
                   ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Source}"
                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Drive selection — only shown in Scan Drives mode -->
    <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="4" Padding="8"
            Margin="0,0,0,8" IsVisible="{Binding ScanDrivesMode}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{StaticResource str.ProxyDeploy.DriveHint}"
                     Foreground="#CCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
          <Button Content="{StaticResource str.ProxyDeploy.ScanDrives}"
                  Command="{Binding ScanDrivesCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.ScanDrives}"
                  Classes="accent" Padding="12,4"/>
          <Button Content="{StaticResource str.ProxyDeploy.RefreshDrives}"
                  Command="{Binding LoadDrivesCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.RefreshDrives}"
                  Padding="12,4"/>
          <Button Content="{StaticResource str.ProxyDeploy.CancelScan}"
                  Command="{Binding ScanDrivesCancelCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.CancelScan}"
                  IsVisible="{Binding IsScanningDrives}"
                  Padding="12,4"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Drives}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:DriveDescriptor">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Content="{Binding Display}"
                        Foreground="#D4D4D4" Margin="0,0,16,0"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Top: Proxy DLL type selector -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
      <TextBlock Text="{StaticResource str.ProxyDeploy.ProxyType}"
                 Foreground="#CCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
      <RadioButton GroupName="ProxyType"
                   Content="{StaticResource str.ProxyDeploy.Type.Version}"
                   IsChecked="{Binding IsVersionSelected, Mode=TwoWay}"
                   ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Type.Version}"
                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
      <RadioButton GroupName="ProxyType"
                   Content="{StaticResource str.ProxyDeploy.Type.Dinput8}"
                   IsChecked="{Binding IsDinput8Selected, Mode=TwoWay}"
                   ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Type.Dinput8}"
                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
      <RadioButton GroupName="ProxyType"
                   Content="{StaticResource str.ProxyDeploy.Type.Dxgi}"
                   IsChecked="{Binding IsDxgiSelected, Mode=TwoWay}"
                   ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Type.Dxgi}"
                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
      <RadioButton GroupName="ProxyType"
                   Content="{StaticResource str.ProxyDeploy.Type.Winmm}"
                   IsChecked="{Binding IsWinmmSelected, Mode=TwoWay}"
                   ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Type.Winmm}"
                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
      <Border Width="1" Background="#444" Margin="4,2"/>
      <CheckBox Content="{StaticResource str.ProxyDeploy.SuggestToggle}"
                IsChecked="{Binding LkgSuggestEnabled}"
                ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.SuggestToggle}"
                Foreground="#CCCCCC" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Toolbar: Scan / Refresh / Selection helpers -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="{StaticResource str.ProxyDeploy.Scan}"
              Command="{Binding ScanCommand}"
              IsVisible="{Binding IsSteamSource}"
              ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Scan}"
              Classes="accent" Padding="12,4"/>
      <Button Content="{StaticResource str.ProxyDeploy.Refresh}"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Refresh}"
              Padding="12,4"/>
      <Button Content="{StaticResource str.ProxyDeploy.Inject}"
              Command="{Binding InjectIntoRunningGameCommand}"
              ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Inject}"
              Padding="12,4"/>

      <!-- Selection buttons — separated visually from scan/refresh -->
      <Border Width="1" Background="#444" Margin="4,2"/>
      <Button Content="{StaticResource str.ProxyDeploy.SelectAll}"
              Command="{Binding SelectAllCommand}"
              Padding="8,4" FontSize="11"/>
      <Button Content="{StaticResource str.ProxyDeploy.UnselectAll}"
              Command="{Binding UnselectAllCommand}"
              Padding="8,4" FontSize="11"/>
      <Button Content="{StaticResource str.ProxyDeploy.InvertSel}"
              Command="{Binding InvertSelectionCommand}"
              Padding="8,4" FontSize="11"/>

      <TextBlock Text="{Binding StatusText}"
                 Foreground="{Binding StatusColor}" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="8,0"/>
    </StackPanel>

    <!-- Leftover proxy cleanup. A vertical list rather than the Drives card's WrapPanel because
         these rows carry full absolute paths. Rows default UNCHECKED and there is deliberately no
         select-all: this is the only destructive action in the panel, so each row is opted into
         individually. -->
    <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="4" Padding="8"
            Margin="0,0,0,8">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{StaticResource str.ProxyDeploy.Orphans.Header}"
                     Foreground="#CCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
          <Button Content="{StaticResource str.ProxyDeploy.Orphans.Scan}"
                  Command="{Binding ScanOrphansCommand}"
                  ToolTip.Tip="{StaticResource str.ProxyDeploy.Orphans.ScanTip}"
                  Classes="accent" Padding="12,4"/>
          <!-- Bound to IsScanningOrphans, NOT to the shared IsScanning and NOT to
               IsRemovingOrphans: this cancels the ORPHAN SCAN specifically. The shared flag is set
               by three different commands, so it used to render this button during the Steam-library
               scan and the drive scan too — wired to a command that could not run. (B45) -->
          <Button Content="{StaticResource str.ProxyDeploy.CancelScan}"
                  Command="{Binding ScanOrphansCancelCommand}"
                  IsVisible="{Binding IsScanningOrphans}"
                  Padding="12,4"/>
          <!-- Report and Execute deliberately side by side: the dry run is a first-class action, not
               something buried inside the confirmation. It writes a file the user reads at their own
               pace, outside any modal, before authorising anything. -->
          <Button Content="{StaticResource str.ProxyDeploy.Orphans.Report}"
                  Command="{Binding WriteOrphanReportCommand}"
                  ToolTip.Tip="{StaticResource str.ProxyDeploy.Orphans.ReportTip}"
                  IsEnabled="{Binding CanWriteOrphanReport}"
                  Padding="12,4" FontSize="11"/>
          <Button Content="{Binding DeleteOrphansLabel}"
                  Command="{Binding DeleteSelectedOrphansCommand}"
                  ToolTip.Tip="{StaticResource str.ProxyDeploy.Orphans.DeleteTip}"
                  IsEnabled="{Binding HasOrphanSelection}"
                  Foreground="#E05252" Padding="12,4" FontSize="11"/>
        </StackPanel>
        <TextBlock Text="{StaticResource str.ProxyDeploy.Orphans.Intro}"
                   Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{StaticResource str.ProxyDeploy.Orphans.NoneFound}"
                   Foreground="#7EC97A" FontSize="11"
                   IsVisible="{Binding ShowNoOrphansFound}"/>
        <!-- MaxHeight + scroller is load-bearing, not polish: a DockPanel measures its Top children
             with infinite available height, so an unbounded list of 9 rows (the measured count on a
             real machine) takes the space the game DataGrid needs and pushes it out of the panel.
             IsVisible keeps the list costing nothing until a scan has run. -->
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding OrphanScanRan}">
        <ItemsControl ItemsSource="{Binding Orphans}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:OrphanProxy">
              <Border Background="#2D2D30" CornerRadius="3" Padding="6" Margin="0,2">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding IsActionable}"
                            VerticalAlignment="Top" Margin="0,0,6,0"/>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding DllDirectory}"
                               Foreground="#D4D4D4" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding DllNames}" Foreground="#4EC9B0" FontSize="11"/>
                      <TextBlock Text="{Binding FileVersion}" Foreground="#8A8A8A" FontSize="11"/>
                      <TextBlock Text="{Binding SizeText}" Foreground="#8A8A8A" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActionSummary}"
                               Foreground="#E6A817" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusColor}" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                  <Button Grid.Column="2"
                          Content="{StaticResource str.ProxyDeploy.Orphans.OpenFolder}"
                          Command="{Binding $parent[ItemsControl].((vm:ProxyDeployViewModel)DataContext).OpenOrphanFolderCommand}"
                          CommandParameter="{Binding}"
                          Padding="8,2" FontSize="11" VerticalAlignment="Top"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Route guidance. Deliberately always-visible rather than a tooltip: this
         panel is where the user picks between deploying a proxy and injecting,
         and the three delivery routes are not equally good. A tooltip here would
         only be found by someone who already knew to look. -->
    <TextBlock DockPanel.Dock="Top"
               Text="{StaticResource str.ProxyDeploy.RouteOrder}"
               Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <!-- Scanning progress.
         IsIndeterminate is bound to IsScanning so the indeterminate animation
         does not keep ticking (and invalidating layout) while the bar is
         collapsed — this caused neighbouring Buttons to flicker on hover. -->
    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="{Binding IsScanning}"
                 IsVisible="{Binding IsScanning}"
                 Height="2" Margin="0,0,0,4"/>

    <!-- Bottom: Action buttons.
         Force ToolTip placement to "Top" for every Button/CheckBox inside.
         Default placement ("Pointer") at the bottom of the window has to flip
         upward and lands on the cursor — cursor leaves the control, hover
         ends, tooltip dismisses, then cursor re-enters, repeat. Visible as
         hover-state flicker until the tooltip stabilises. -->
    <Border DockPanel.Dock="Bottom" Background="#2D2D2D" Padding="8" Margin="0,8,0,0"
            CornerRadius="4">
      <Border.Styles>
        <Style Selector="Button">
          <Setter Property="ToolTip.Placement" Value="Top"/>
          <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
        </Style>
        <Style Selector="CheckBox">
          <Setter Property="ToolTip.Placement" Value="Top"/>
          <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
        </Style>
      </Border.Styles>
      <DockPanel>
        <!-- Right: source DLL info -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{StaticResource str.ProxyDeploy.SourceDll}"
                     Foreground="#888" FontSize="11"/>
          <TextBlock Text="{Binding SourceDllVersion, StringFormat='v{0}', FallbackValue='N/A'}"
                     Foreground="#D4D4D4" FontSize="11" FontWeight="Bold"/>
        </StackPanel>

        <!-- Left: buttons + force checkbox -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{StaticResource str.ProxyDeploy.Deploy}"
                  Command="{Binding DeploySelectedCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Deploy}"
                  Classes="accent" Padding="12,4"/>
          <Button Content="{StaticResource str.ProxyDeploy.Undeploy}"
                  Command="{Binding UndeploySelectedCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Undeploy}"
                  Padding="12,4"/>
          <Button Content="{StaticResource str.ProxyDeploy.UpdateAll}"
                  Command="{Binding UpdateAllCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.UpdateAll}"
                  Padding="12,4"/>
          <CheckBox Content="{StaticResource str.ProxyDeploy.Force}"
                    IsChecked="{Binding ForceOverwrite}"
                    ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.Force}"
                    Foreground="#CCCCCC" VerticalAlignment="Center" Margin="8,0"/>
          <!-- Separate from Force Overwrite on purpose (audit #5 AC1): this one
               destroys a third party's file and is NOT persisted, so it cannot
               become standing consent carried in from an earlier session. -->
          <CheckBox Content="{StaticResource str.ProxyDeploy.ForeignOverwrite}"
                    IsChecked="{Binding AllowForeignOverwrite}"
                    ToolTip.Tip="{StaticResource str.Tip.ProxyDeploy.ForeignOverwrite}"
                    Foreground="#E0A050" VerticalAlignment="Center" Margin="8,0"/>
          <TextBlock Text="{Binding LastOperationResult}"
                     Foreground="{Binding LastOperationColor}" VerticalAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Margin="8,0"
                     IsVisible="{Binding LastOperationResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Error display -->
    <TextBlock DockPanel.Dock="Bottom"
               Text="{Binding ErrorMessage}"
               Foreground="#F44747" FontSize="12" Margin="0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Main: Game list DataGrid
         IsReadOnly is set per-column (with the checkbox column editable)
         instead of on the grid itself. Marking the whole grid IsReadOnly=True
         caused row visuals to lag behind item PropertyChanged events from the
         background-thread Refresh, requiring a second click to repaint.

         That "background-thread Refresh" was the real defect, not a repaint quirk:
         ProxyDeployService raised PropertyChanged from inside Task.Run, and the same
         race that made rows repaint late also crashed the app (0xc0000005 in
         libSkiaSharp) on Scan Steam -> Update all. The service now applies every
         DetectedGame write on the caller's thread, so this per-column arrangement is
         no longer load-bearing — it is kept because the checkbox column still needs
         to be editable. -->
    <DataGrid ItemsSource="{Binding Games}"
              AutoGenerateColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              IsReadOnly="False"
              SelectionMode="Extended"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              BorderThickness="0"
              Background="#1E1E1E"
              Foreground="#D4D4D4"
              FontSize="12"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <!-- Select checkbox -->
        <DataGridTemplateColumn Header="" Width="40" CanUserResize="False" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:DetectedGame">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Game Name -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColName}"
                            Binding="{Binding Name}" SortMemberPath="Name" Width="260" MinWidth="160" IsReadOnly="True"/>

        <!-- BinariesDir (path) -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColPath}"
                            Binding="{Binding BinariesDir}" SortMemberPath="BinariesDir" Width="420" MinWidth="220" IsReadOnly="True"/>

        <!-- Status -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColStatus}"
                            Binding="{Binding Status}" SortMemberPath="Status" Width="200" IsReadOnly="True"/>

        <!-- Load observation: whether the DLL was actually SEEN to load (per-process log folder),
             NOT the disk state in Status. "DeployedCurrent" + "not observed" is the silent-failure
             the [PROXYLOAD] fix surfaces; "not observed" is honest unknown, never a failure claim. -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColLoad}"
                            Binding="{Binding LoadObservation}" SortMemberPath="LoadObservation"
                            Width="150" MinWidth="100" IsReadOnly="True"/>

        <!-- Suggested proxy (import-table + remembered pick; advisory, plain text
             column with Binding==SortMemberPath so it sorts under compiled bindings). -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColSuggested}"
                            Binding="{Binding SuggestedProxy}" SortMemberPath="SuggestedProxy"
                            Width="220" MinWidth="120" IsReadOnly="True"/>

        <!-- Installed Version -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColVersion}"
                            Binding="{Binding InstalledVersion}" SortMemberPath="InstalledVersion" Width="120" IsReadOnly="True"/>

        <!-- Error Message -->
        <DataGridTextColumn Header="{StaticResource str.ProxyDeploy.ColError}"
                            Binding="{Binding ErrorMessage}" SortMemberPath="ErrorMessage" Width="200" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
