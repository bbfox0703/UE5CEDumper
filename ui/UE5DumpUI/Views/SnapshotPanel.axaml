<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.SnapshotPanel"
             x:DataType="vm:SnapshotViewModel">

  <!-- Rows: intro / capture(collapsible) / usage / saved-header / saved-grid(2*) /
       splitter / compare+diff block(5*) / noise. The two star rows + splitter let
       the user trade space between the snapshot list and the diff result. -->
  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,2*,Auto,5*,Auto">

    <!-- Intro -->
    <TextBlock Grid.Row="0" Text="{StaticResource str.Snapshot.Intro}"
               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Capture controls (collapsible; force-expanded while capturing) -->
    <Expander Grid.Row="1" Header="{StaticResource str.Snapshot.CaptureHeader}"
              IsExpanded="{Binding CaptureSectionOpen}" Margin="0,0,0,10"
              Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Spacing="8" Margin="6">
        <!-- Single wrap row: Scope / GameOnly / Quota / Label / Capture / Cancel.
             Flows onto a second line on narrow windows but keeps everything on one
             line when there's room (denser than the old two-row layout). -->
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{StaticResource str.Snapshot.Scope}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" MinWidth="150"
                    IsEnabled="{Binding CanEditSettings}" Margin="0,0,12,0"/>
          <!-- Type-family narrowing (default All): floats = HP/MP/coords, integers =
               counts/flags/IDs. Cuts the DB at the source for type-specific hunts. -->
          <TextBlock Text="{StaticResource str.Snapshot.Family}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding FamilyOptions}" SelectedItem="{Binding SelectedFamily}" MinWidth="120"
                    ToolTip.Tip="{StaticResource str.Tip.Snapshot.Family}"
                    IsEnabled="{Binding CanEditSettings}" Margin="0,0,12,0"/>
          <CheckBox Content="{StaticResource str.Snapshot.GameOnly}" IsChecked="{Binding GameOnly}" Foreground="#CCCCCC"
                    IsEnabled="{Binding CanEditSettings}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <!-- Auto detect Engine/System noise (default ON): skip pure engine/system
               classes at the SOURCE so they never enter the snapshot (faster + smaller).
               A gameplay guardrail keeps Actor/Pawn/Character/components. -->
          <CheckBox Content="{StaticResource str.Snapshot.AutoSkipNoise}" IsChecked="{Binding AutoSkipNoise}"
                    ToolTip.Tip="{StaticResource str.Tip.Snapshot.AutoSkipNoise}" Foreground="#CCCCCC"
                    IsEnabled="{Binding CanEditSettings}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <!-- Native-C (P3): also capture unmanaged-hole guesses so SPC/Pivot can track
               native (non-UPROPERTY) values. Slower + larger; default OFF. -->
          <CheckBox Content="{StaticResource str.Snapshot.NativeC}" IsChecked="{Binding IncludeNativeFields}"
                    ToolTip.Tip="{StaticResource str.Tip.Snapshot.NativeC}" Foreground="#E0A050"
                    IsEnabled="{Binding CanEditSettings}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{StaticResource str.Snapshot.Quota}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding QuotaOptions}" SelectedItem="{Binding SelectedQuotaLabel}"
                    MinWidth="100" ToolTip.Tip="{StaticResource str.Snapshot.QuotaHint}"
                    IsEnabled="{Binding CanEditSettings}" Margin="0,0,12,0"/>
          <!-- Opt-in in-capture ceiling ("提前止血"): stop early + keep partial when the
               live DB crosses this. Fills the gap the post-capture quota can't bound. -->
          <TextBlock Text="{StaticResource str.Snapshot.MaxDataset}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding MaxDatasetOptions}" SelectedItem="{Binding SelectedMaxDataset}"
                    MinWidth="90" ToolTip.Tip="{StaticResource str.Tip.Snapshot.MaxDataset}"
                    IsEnabled="{Binding CanEditSettings}" Margin="0,0,12,0"/>
          <TextBlock Text="{StaticResource str.Snapshot.Label}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Text="{Binding Label}" PlaceholderText="{StaticResource str.Snapshot.LabelWatermark}" Width="220"
                   IsEnabled="{Binding CanEditSettings}" Margin="0,0,12,0"/>
          <!-- Pre-flight size estimate: sample-walk + extrapolate, never writes the DB. -->
          <Button Content="{StaticResource str.Snapshot.Estimate}" Command="{Binding EstimateSizeCommand}"
                  IsEnabled="{Binding CanCapture}" IsVisible="{Binding !IsBusy}"
                  ToolTip.Tip="{StaticResource str.Tip.Snapshot.Estimate}"
                  Padding="12,5" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Snapshot.Capture}" Command="{Binding CaptureCommand}"
                  IsEnabled="{Binding CanCapture}" IsVisible="{Binding !IsBusy}"
                  Classes="accent" Padding="12,5" FontWeight="Bold" Margin="0,0,8,0"/>
          <!-- Cancel surfaces for BOTH a running capture and a running estimate. -->
          <Button Content="{StaticResource str.Snapshot.Cancel}" Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsBusy}" Padding="12,5" Margin="0,0,8,0"/>
          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Width="200" Height="6"
                       IsVisible="{Binding IsCapturing}" VerticalAlignment="Center"/>
        </WrapPanel>
        <!-- Size-estimate result (pre-flight). Distinct colour from the capture status. -->
        <TextBlock Text="{Binding EstimateText}" Foreground="#C586C0" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding EstimateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{StaticResource str.Snapshot.NotConnected}" Foreground="#888" FontSize="11"
                   IsVisible="{Binding !CanCapture}"/>
        <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Auto snapshot (periodic capture). Manual Start/Stop toggle, session-only:
             never auto-starts on connect / auto-resumes on launch; only settings persist.
             The idle gap between snapshots (≥60s) is the game-impact lever — no thread-
             priority drop (that was tried and reverted for starving scans). -->
        <Border Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="3"
                Padding="8" Margin="0,4,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="{StaticResource str.Snapshot.Auto.Hint}" Foreground="#999" FontSize="11" TextWrapping="Wrap"/>
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="{StaticResource str.Snapshot.Auto.Header}" Foreground="#9CDCFE"
                         FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ToggleSwitch IsChecked="{Binding AutoSnapshotEnabled}" IsEnabled="{Binding CanToggleAuto}"
                            OffContent="{StaticResource str.Snapshot.Auto.Off}"
                            OnContent="{StaticResource str.Snapshot.Auto.On}" Margin="0,0,14,0"/>
              <TextBlock Text="{StaticResource str.Snapshot.Auto.Interval}" Foreground="#CCCCCC"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <NumericUpDown Value="{Binding AutoSnapshotIntervalSecValue}" Minimum="60" Maximum="86400"
                             Increment="60" FormatString="0" MinWidth="120" FontSize="12"
                             IsEnabled="{Binding CanEditAutoSettings}"
                             ToolTip.Tip="{StaticResource str.Tip.Snapshot.Auto.Interval}" Margin="0,0,14,0"/>
              <TextBlock Text="{StaticResource str.Snapshot.Auto.Retention}" Foreground="#CCCCCC"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox ItemsSource="{Binding RetentionModeOptions}" SelectedItem="{Binding RetentionMode}"
                        MinWidth="130" IsEnabled="{Binding CanEditAutoSettings}"
                        ToolTip.Tip="{StaticResource str.Tip.Snapshot.Auto.Retention}" Margin="0,0,8,0"/>
              <TextBlock Text="{StaticResource str.Snapshot.Auto.Count}" Foreground="#CCCCCC"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <NumericUpDown Value="{Binding AutoSnapshotCountValue}" Minimum="1" Maximum="10000"
                             Increment="1" FormatString="0" MinWidth="110" FontSize="12"
                             IsEnabled="{Binding CanEditAutoSettings}" Margin="0,0,14,0"/>
              <CheckBox Content="{StaticResource str.Snapshot.Auto.AdjustQuota}"
                        IsChecked="{Binding AutoSnapshotAdjustQuota}" Foreground="#CCCCCC"
                        IsEnabled="{Binding CanEditAutoSettings}" VerticalAlignment="Center"
                        ToolTip.Tip="{StaticResource str.Tip.Snapshot.Auto.AdjustQuota}"/>
            </WrapPanel>
            <TextBlock Text="{Binding AutoStatusText}" Foreground="#DCDCAA" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding AutoStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>

    <!-- Usage / quota + the free-disk-space guard (blocks ALL captures) -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Snapshot.Usage}" Foreground="#999" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding UsageText}" Foreground="#D4D4D4" FontFamily="Consolas"
                 VerticalAlignment="Center" MinWidth="150"/>
      <ProgressBar Value="{Binding UsageRatio}" Minimum="0" Maximum="1" Width="180" Height="6"
                   IsVisible="{Binding ShowUsageBar}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding AllGamesText}" Foreground="#777" FontSize="11"
                 VerticalAlignment="Center" Margin="12,0,0,0"/>
      <TextBlock Text="{StaticResource str.Snapshot.MinFreeDisk}" Foreground="#999"
                 VerticalAlignment="Center" Margin="12,0,0,0"
                 ToolTip.Tip="{StaticResource str.Tip.Snapshot.MinFreeDisk}"/>
      <NumericUpDown Value="{Binding SnapshotMinFreePercentValue}" Minimum="0" Maximum="99" Increment="1"
                     FormatString="0" MinWidth="90" FontSize="12" VerticalAlignment="Center"
                     ToolTip.Tip="{StaticResource str.Tip.Snapshot.MinFreeDisk}"/>
      <TextBlock Text="%" Foreground="#999" VerticalAlignment="Center"/>
      <TextBlock Text="/" Foreground="#777" VerticalAlignment="Center"/>
      <NumericUpDown Value="{Binding SnapshotMinFreeGbValue}" Minimum="0" Maximum="100000" Increment="10"
                     FormatString="0" MinWidth="110" FontSize="12" VerticalAlignment="Center"
                     ToolTip.Tip="{StaticResource str.Tip.Snapshot.MinFreeDisk}"/>
      <TextBlock Text="GB" Foreground="#999" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Saved-snapshots header + actions -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Snapshot.Saved}" Foreground="#9CDCFE"
                 FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="{StaticResource str.Snapshot.Refresh}" Command="{Binding RefreshCommand}" Padding="8,3"/>
      <Button Content="{StaticResource str.Snapshot.Delete}" Command="{Binding DeleteCommand}"
              CommandParameter="{Binding SelectedSnapshot}" Padding="8,3"
              IsEnabled="{Binding !IsDeleting}"/>
      <Button Content="{StaticResource str.Snapshot.DeleteAll}" Command="{Binding DeleteAllCommand}"
              Padding="8,3" IsEnabled="{Binding !IsDeleting}"
              ToolTip.Tip="{StaticResource str.Snapshot.DeleteAllTip}"/>
      <Button Content="{StaticResource str.Snapshot.OpenDbFolder}" Command="{Binding OpenDbFolderCommand}"
              Padding="8,3" ToolTip.Tip="{StaticResource str.Snapshot.OpenDbFolderTip}"/>
    </StackPanel>

    <!-- Snapshot list (fixed height; diff grid gets the remaining space) -->
    <DataGrid x:Name="SnapshotsGrid"
              Grid.Row="4" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
              CanUserResizeColumns="True" CanUserSortColumns="True"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Label}"    Binding="{Binding LabelDisplay}"   SortMemberPath="Label"        Width="280" MinWidth="180"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Captured}" Binding="{Binding CapturedAt}"     SortMemberPath="CapturedAt"   Width="190"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Objects}"  Binding="{Binding ObjectCount}"    SortMemberPath="ObjectCount"  Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Fields}"   Binding="{Binding FieldCount}"     SortMemberPath="FieldCount"   Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Size}"     Binding="{Binding EstSizeDisplay}" SortMemberPath="EstBytes"     Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Scope}"    Binding="{Binding Scope}"          SortMemberPath="Scope"        Width="130"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Ue}"       Binding="{Binding UeVersion}"      SortMemberPath="UeVersion"    Width="60"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Drag to trade vertical space between the snapshot list and the diff. -->
    <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch"
                  ResizeDirection="Rows" Background="#3C3C3C" Margin="0,4,0,4"/>

    <!-- Compare (collapsible) + diff results share the lower star row: collapsing
         the compare Expander hands its space to the diff grid below it. A Diff /
         Group toggle swaps the lower area between the snapshot diff and the
         Multiple-Values group match over one snapshot. -->
    <DockPanel Grid.Row="6">
      <!-- Diff / Group mode toggle -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                  Margin="0,0,0,8" VerticalAlignment="Center">
        <TextBlock Text="{StaticResource str.Snapshot.Group.ModeLabel}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
        <ToggleSwitch IsChecked="{Binding IsGroupMode}"
                      OffContent="{StaticResource str.Snapshot.Group.ModeDiff}"
                      OnContent="{StaticResource str.Snapshot.Group.ModeGroup}"/>
      </StackPanel>

      <!-- Both mode contents overlay this Panel; visibility shows exactly one. -->
      <Panel>
      <!-- ============ DIFF mode ============ -->
      <DockPanel IsVisible="{Binding !IsGroupMode}">
      <Expander DockPanel.Dock="Top" Header="{StaticResource str.Snapshot.CompareHeader}"
                IsExpanded="{Binding CompareSectionOpen}" Margin="0,0,0,8"
                Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Spacing="8" Margin="6">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{StaticResource str.Snapshot.Diff.Old}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding DiffA}" MinWidth="170" Margin="0,0,8,0"
                    IsEnabled="{Binding !IsDiffing}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:SnapshotMeta">
                <TextBlock Text="{Binding PickerDisplay}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.New}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding DiffB}" MinWidth="170" Margin="0,0,8,0"
                    IsEnabled="{Binding !IsDiffing}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:SnapshotMeta">
                <TextBlock Text="{Binding PickerDisplay}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{StaticResource str.Snapshot.Diff.Run}" Command="{Binding RunDiffCommand}"
                  IsEnabled="{Binding CanRunDiff}" Classes="accent" Padding="12,4"
                  ToolTip.Tip="{StaticResource str.Snapshot.Diff.Hint}"/>
          <!-- Diff always includes nested array / struct-array element rows (no Deep
               toggle here; Deep is Group-mode-only). Annotated so users don't look for
               a missing Deep switch on the Diff. -->
          <TextBlock Text="{StaticResource str.Snapshot.Diff.DeepNote}" Foreground="#888"
                     FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"
                     ToolTip.Tip="{StaticResource str.Tip.Snapshot.Diff.DeepNote}"/>
          <!-- Per-row Open / GWorld / Copy live on each diff row (below). -->
        </WrapPanel>
        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsDiffing}">
          <TextBlock Text="{StaticResource str.Snapshot.Diff.ClassFilter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <AutoCompleteBox Text="{Binding DiffClassFilter, Mode=TwoWay}" ItemsSource="{Binding DiffClassOptions}"
                           FilterMode="Contains" Width="140" Margin="0,0,8,0"/>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.PropFilter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <AutoCompleteBox Text="{Binding DiffPropFilter, Mode=TwoWay}" ItemsSource="{Binding DiffFieldOptions}"
                           FilterMode="Contains" Width="140" Margin="0,0,8,0"/>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.ObjectFilter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <AutoCompleteBox Text="{Binding DiffObjectFilter, Mode=TwoWay}" ItemsSource="{Binding DiffObjectOptions}"
                           FilterMode="Contains" Width="180" Margin="0,0,8,0"/>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.Dir}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding DiffDirectionOptions}" SelectedItem="{Binding SelectedDiffDirection}" MinWidth="120" Margin="0,0,8,0"/>
        </WrapPanel>
        <WrapPanel Orientation="Horizontal">
          <!-- Inputs grayed during a diff; progress + status stay live. -->
          <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsDiffing}">
            <TextBlock Text="{StaticResource str.Snapshot.Diff.Global}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <AutoCompleteBox Text="{Binding DiffGlobalFilter, Mode=TwoWay}" Width="180" Margin="0,0,12,0"
                     PlaceholderText="{StaticResource str.Snapshot.Diff.GlobalHint}"
                     ItemsSource="{Binding DiffGlobalHistory}" FilterMode="Contains"/>
            <TextBlock Text="{StaticResource str.Snapshot.Diff.OldRange}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding DiffOldMin}" Width="70" Margin="0,0,2,0" PlaceholderText="min"/>
            <TextBlock Text="–" Foreground="#888" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <TextBox Text="{Binding DiffOldMax}" Width="70" Margin="0,0,12,0" PlaceholderText="max"/>
            <TextBlock Text="{StaticResource str.Snapshot.Diff.NewRange}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding DiffNewMin}" Width="70" Margin="0,0,2,0" PlaceholderText="min"/>
            <TextBlock Text="–" Foreground="#888" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <TextBox Text="{Binding DiffNewMax}" Width="70" Margin="0,0,8,0" PlaceholderText="max"/>
            <Button Content="{StaticResource str.Snapshot.Diff.ApplyRange}" Command="{Binding ApplyDiffRangeCommand}" Padding="8,3" Margin="0,0,4,0"/>
            <Button Content="{StaticResource str.Snapshot.Diff.ResetRange}" Command="{Binding ResetDiffRangeCommand}" Padding="8,3" Margin="0,0,8,0"/>
          </WrapPanel>
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" Margin="0,0,8,0"
                       IsVisible="{Binding IsDiffing}"/>
          <TextBlock Text="{Binding DiffStatusText}" Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"/>
        </WrapPanel>
      </StackPanel>
      </Expander>

      <!-- Diff results — fills the rest of the lower star row below the compare Expander -->
      <DataGrid x:Name="DiffGrid"
                ItemsSource="{Binding DiffRows}" SelectedItem="{Binding SelectedDiffRow}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                CanUserResizeColumns="True" CanUserSortColumns="True"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Change}" Binding="{Binding DirectionGlyph}" SortMemberPath="Direction" Width="40"/>
          <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Class}"  Binding="{Binding ClassName}"      SortMemberPath="ClassName" Width="200"/>
          <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Object}" Binding="{Binding NormPath}"       SortMemberPath="NormPath"  Width="420" MinWidth="220"/>
          <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Field}"  Binding="{Binding PropName}"       SortMemberPath="PropName"  Width="160"/>
          <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Old}"    Binding="{Binding OldValue}"       SortMemberPath="OldValue"  Width="120"/>
          <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.New}"    Binding="{Binding NewValue}"       SortMemberPath="NewValue"  Width="120"/>
          <!-- Per-row actions (mirror Value Search): Open in Live Walker / GWorld /
               Copy Address, each operating on this row. GWorld is in-session only. -->
          <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:SnapshotDiffRow">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="{StaticResource str.Snapshot.Diff.OpenWalker}"
                          Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).OpenInLiveWalkerCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanUseDiffRowActions}"
                          Foreground="#4EC9B0" Background="Transparent" BorderThickness="1" BorderBrush="#4EC9B0"
                          Padding="6,2" FontSize="11" Cursor="Hand"/>
                  <Button Content="{StaticResource str.Snapshot.Diff.CopyAddr}"
                          Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CopyDiffAddressCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanUseDiffRowActions}"
                          Foreground="#DCDCAA" Background="Transparent" BorderThickness="1" BorderBrush="#DCDCAA"
                          Padding="6,2" FontSize="11" Cursor="Hand"/>
                  <Button Content="{StaticResource str.Snapshot.Diff.LocateGWorld}"
                          Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).LocateRowInGWorldCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanLocateDiffRowInGWorld}"
                          ToolTip.Tip="{StaticResource str.Tip.Snapshot.Diff.LocateGWorld}"
                          Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                          Padding="6,2" FontSize="11" Cursor="Hand"/>
                  <Button Content="{StaticResource str.Snapshot.Diff.LocateGameEngine}"
                          Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).LocateRowInGameEngineCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanUseDiffRowActions}"
                          ToolTip.Tip="{StaticResource str.Tip.Snapshot.Diff.LocateGameEngine}"
                          Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                          Padding="6,2" FontSize="11" Cursor="Hand"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      </DockPanel>

      <!-- ============ GROUP mode (Multiple Values over one snapshot) ============ -->
      <DockPanel IsVisible="{Binding IsGroupMode}">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
          <TextBlock Text="{StaticResource str.Snapshot.Group.Hint}" Foreground="#999" FontSize="11" TextWrapping="Wrap"/>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="{StaticResource str.Snapshot.Group.Snapshot}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding GroupSnapshot}" MinWidth="200" Margin="0,0,12,0"
                      IsEnabled="{Binding !IsGroupMatching}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:SnapshotMeta"><TextBlock Text="{Binding PickerDisplay}"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Optional compare snapshot (Mode B): enables Increased/Decreased/Unchanged. -->
            <TextBlock Text="{StaticResource str.Snapshot.Group.CompareWith}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding GroupCompareSnapshot}" MinWidth="180" Margin="0,0,4,0"
                      IsEnabled="{Binding !IsGroupMatching}"
                      ToolTip.Tip="{StaticResource str.Tip.Snapshot.Group.CompareWith}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:SnapshotMeta"><TextBlock Text="{Binding PickerDisplay}"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{StaticResource str.Snapshot.Group.CompareClear}" Command="{Binding ClearGroupCompareCommand}"
                    IsVisible="{Binding IsGroupCompareMode}" ToolTip.Tip="{StaticResource str.Tip.Snapshot.Group.CompareClear}"
                    Padding="6,3" Margin="0,0,12,0"/>
            <Button Content="{StaticResource str.Snapshot.Group.Find}" Command="{Binding RunGroupMatchCommand}"
                    IsEnabled="{Binding CanRunGroupMatch}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="{StaticResource str.Snapshot.Group.Clear}" Command="{Binding ClearGroupCommand}" Padding="8,4" Margin="0,0,8,0"/>
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" Margin="0,0,8,0"
                         IsVisible="{Binding IsGroupMatching}"/>
            <TextBlock Text="{Binding GroupStatusText}" Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"/>
          </WrapPanel>
          <!-- 2-4 value rows: width scope + predicate + value (+ Between upper bound) -->
          <ItemsControl ItemsSource="{Binding GroupInputs}" IsEnabled="{Binding !IsGroupMatching}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:GroupSlotInput">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                  <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).GroupDataTypeOptions}"
                            SelectedItem="{Binding DataType}" MinWidth="130"/>
                  <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).GroupScanTypeOptions}"
                            SelectedItem="{Binding ScanType}" MinWidth="100"/>
                  <TextBox Text="{Binding Value}" Width="120" IsVisible="{Binding RequiresValueInput}"
                           PlaceholderText="{StaticResource str.Snapshot.Group.ValueHint}"/>
                  <TextBlock Text="{StaticResource str.Snapshot.Group.Value2Hint}" Foreground="#888"
                             VerticalAlignment="Center" IsVisible="{Binding RequiresValue2Input}"/>
                  <TextBox Text="{Binding Value2}" Width="120" IsVisible="{Binding RequiresValue2Input}"/>
                  <!-- Live coerced-range preview for this Between row (mixed numeric →
                       both int and float interpretations), under the panel rounding mode. -->
                  <TextBlock Text="{Binding BetweenPreview}"
                             Foreground="#4EC9B0" VerticalAlignment="Center"
                             FontFamily="Consolas" FontSize="12"
                             IsVisible="{Binding BetweenPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="{StaticResource str.Snapshot.Group.AddRow}" Command="{Binding AddGroupRowCommand}"
                    IsEnabled="{Binding CanAddGroupRow}" Padding="8,3"/>
            <Button Content="{StaticResource str.Snapshot.Group.RemoveRow}" Command="{Binding RemoveGroupRowCommand}"
                    IsEnabled="{Binding CanRemoveGroupRow}" Padding="8,3"/>
            <CheckBox Content="{StaticResource str.Snapshot.Group.Deep}" IsChecked="{Binding GroupDeep}"
                      ToolTip.Tip="{StaticResource str.Tip.Snapshot.Group.Deep}" Foreground="#CCCCCC"
                      IsEnabled="{Binding !IsGroupMatching}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <!-- Rounding mode: how a fractional float/double target is reduced to the
                 displayed integer before compare (Round/Trunc/Ceil). -->
            <TextBlock Text="{StaticResource str.Snapshot.Rounding}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <ComboBox ItemsSource="{Binding RoundingModeOptions}" SelectedItem="{Binding SelectedRoundingMode}"
                      IsEnabled="{Binding !IsGroupMatching}" MinWidth="90" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding RoundingModeHint}" Foreground="#999" FontSize="11"
                     FontStyle="Italic" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Results master-detail: one row per matched object; expand for per-slot
             locked offsets + handoffs (reuses GroupCandidate / GroupSlotMatch). -->
        <DataGrid x:Name="GroupGrid"
                  ItemsSource="{Binding GroupCandidates}" SelectedItem="{Binding SelectedGroupCandidate}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  ToolTip.Tip="{StaticResource str.Tip.Group.MatchedOffline}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{StaticResource str.Snapshot.Group.Col.Class}"   Binding="{Binding LocationLabel}" SortMemberPath="ClassName"    Width="220"/>
            <DataGridTextColumn Header="{StaticResource str.Snapshot.Group.Col.Object}"  Binding="{Binding InstanceName}"  SortMemberPath="InstanceName" Width="320" MinWidth="200"/>
            <DataGridTextColumn Header="{StaticResource str.Snapshot.Group.Col.Matched}" Binding="{Binding SlotSummary}"   CanUserSort="False"           Width="440" MinWidth="240"/>
            <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="m:GroupCandidate">
                  <Button Content="{StaticResource str.Snapshot.Group.OpenWalker}"
                          Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).OpenGroupInLiveWalkerCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanUseGroupRowActions}"
                          Foreground="#4EC9B0" Background="Transparent" BorderThickness="1" BorderBrush="#4EC9B0"
                          Padding="6,2" FontSize="11" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate x:DataType="m:GroupCandidate">
              <StackPanel Margin="20,4,8,8" Spacing="4">
                <TextBlock Text="{Binding OffsetTableLabel}" IsVisible="{Binding HasOffsetTable}"
                           Foreground="#DCDCAA" FontFamily="Consolas" FontSize="12"/>
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:GroupSlotMatch">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                        <TextBlock Text="{Binding LockLabel}" Foreground="#9CDCFE" VerticalAlignment="Center" MinWidth="36"/>
                        <TextBlock Text="{Binding DisplayLabel}" Foreground="#D4D4D4" VerticalAlignment="Center" Width="360"/>
                        <TextBlock Text="{Binding LeafValue}" Foreground="#CE9178" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="80"/>
                        <Button Content="{StaticResource str.Snapshot.Group.CopyAddr}"
                                Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CopyGroupSlotAddressCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanUseGroupRowActions}"
                                Foreground="#DCDCAA" Background="Transparent" BorderThickness="1" BorderBrush="#DCDCAA"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.Snapshot.Group.LocateGWorld}"
                                Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).LocateGroupSlotInGWorldCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanLocateGroupRowInGWorld}"
                                ToolTip.Tip="{StaticResource str.Tip.Snapshot.Diff.LocateGWorld}"
                                Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.Snapshot.Group.LocateGameEngine}"
                                Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).LocateGroupSlotInGameEngineCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).CanUseGroupRowActions}"
                                ToolTip.Tip="{StaticResource str.Tip.Snapshot.Diff.LocateGameEngine}"
                                Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
      </DockPanel>
      </Panel>
    </DockPanel>

    <!-- N1: noise picker for the diff. Same shape as the SPC tab — Apply pushes
         ticked classes into the Diff-scope denylist and re-runs the diff. Diff-only. -->
    <Expander Grid.Row="7" Header="{StaticResource str.Noise.PanelHeader}"
              IsVisible="{Binding !IsGroupMode}"
              IsExpanded="{Binding NoisePanelOpen}" Margin="0,8,0,0"
              Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Orientation="Vertical" Margin="6">
        <TextBlock Text="{StaticResource str.Noise.PanelHint}"
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding NoiseRows}" IsReadOnly="False"
                  Height="200" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{StaticResource str.Noise.Col.Pick}" Width="50" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:NoiseRowVm">
                  <CheckBox IsChecked="{Binding Picked}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.Class}"
                                Binding="{Binding ClassName}" SortMemberPath="ClassName" IsReadOnly="True" Width="300" MinWidth="180"/>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.Hits}"
                                Binding="{Binding HitCount}" SortMemberPath="HitCount" IsReadOnly="True" Width="80"/>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.SampleProps}"
                                Binding="{Binding SamplePropsDisplay}" SortMemberPath="SamplePropsDisplay" IsReadOnly="True" Width="240"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="{StaticResource str.Noise.Apply}"
                  Command="{Binding ApplyNoisePicksCommand}"
                  Classes="accent" Padding="12,4" Margin="0,0,6,0"/>
          <Button Content="{StaticResource str.Noise.Reset}"
                  Command="{Binding ResetNoisePicksCommand}" Padding="8,4" Margin="0,0,12,0"/>
          <TextBlock Text="{StaticResource str.Noise.ActiveHeader}"
                     Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button Content="{StaticResource str.Noise.Clear}"
                  Command="{Binding ClearDenylistCommand}" Padding="8,3" Margin="0,0,6,0"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ActiveDenylist}" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Content="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:SnapshotViewModel)DataContext).RemoveFromDenylistCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{StaticResource str.Noise.RemoveTip}"
                      Margin="0,0,4,4" Padding="6,2"
                      Background="#3C3C3C" Foreground="#CCCCCC"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>
  </Grid>
</UserControl>
