<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.SpcPanel"
             x:DataType="vm:SpcQueryViewModel">

  <DockPanel Margin="12">
    <!-- Single / Group mode toggle (mirrors the Snapshot Diff/Group + Value Search
         Single/Group toggles). Group = the N-snapshot, object-aware multi-value match. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Spc.Group.ModeLabel}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
      <ToggleSwitch IsChecked="{Binding IsGroupMode}"
                    OffContent="{StaticResource str.Spc.Group.ModeSingle}"
                    OnContent="{StaticResource str.Spc.Group.ModeGroup}"/>
    </StackPanel>

    <!-- Both mode contents overlay this Panel; visibility shows exactly one. -->
    <Panel>

    <!-- ===================== SINGLE mode (one field's value sequence) ===================== -->
    <Grid IsVisible="{Binding !IsGroupMode}" RowDefinitions="Auto,Auto,Auto,170,Auto,*,Auto">

    <!-- Intro -->
    <TextBlock Grid.Row="0" Text="{StaticResource str.Spc.Intro}"
               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Query controls -->
    <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
            BorderBrush="#3C3C3C" BorderThickness="1">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Spc.Join}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox ItemsSource="{Binding JoinModeOptions}" SelectedItem="{Binding SelectedJoinMode}"
                  MinWidth="120" Margin="0,0,12,0" ToolTip.Tip="{StaticResource str.Spc.JoinHint}"
                  IsEnabled="{Binding !IsQuerying}"/>
        <TextBlock Text="{StaticResource str.Spc.ClassFilter}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding ClassFilter}" Width="140" Margin="0,0,12,0" IsEnabled="{Binding !IsQuerying}"/>
        <TextBlock Text="{StaticResource str.Spc.PropFilter}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding PropFilter}" Width="140" Margin="0,0,12,0" IsEnabled="{Binding !IsQuerying}"/>
        <!-- Rounding mode: how a fractional float/double absolute target is reduced to
             the displayed integer before compare (Round/Trunc/Ceil). -->
        <TextBlock Text="{StaticResource str.Spc.Rounding}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox ItemsSource="{Binding RoundingModeOptions}" SelectedItem="{Binding SelectedRoundingMode}"
                  MinWidth="90" Margin="0,0,12,0" IsEnabled="{Binding !IsQuerying}"/>
        <Button Content="{StaticResource str.Spc.Run}" Command="{Binding RunQueryCommand}"
                IsEnabled="{Binding CanRunQuery}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Spc.Refresh}" Command="{Binding RefreshCommand}"
                Padding="8,4" IsEnabled="{Binding !IsQuerying}"/>
        <!-- Per-row Open / GWorld / Copy live on each result row (below) — pick a
             row, then use its own buttons. -->
        <TextBlock Text="{Binding RoundingModeHint}" Foreground="#999" FontSize="11"
                   FontStyle="Italic" TextWrapping="Wrap" Width="380" Margin="8,4,0,0"/>
      </WrapPanel>
    </Border>

    <!-- Picker header -->
    <TextBlock Grid.Row="2" Text="{StaticResource str.Spc.PickerHeader}" Foreground="#9CDCFE"
               FontWeight="SemiBold" Margin="0,0,0,6"/>

    <!-- Snapshot picker: tick the snapshots (oldest selected = baseline) and set
         each one's directional predicate vs the previous selected snapshot. -->
    <DataGrid Grid.Row="3" ItemsSource="{Binding SnapshotPicks}" IsReadOnly="False"
              GridLinesVisibility="Horizontal" Background="#1E1E1E"
              IsEnabled="{Binding !IsQuerying}"
              CanUserResizeColumns="True" CanUserSortColumns="False"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Use}" Width="50">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource str.Spc.Col.Label}"
                            Binding="{Binding Label}" IsReadOnly="True" Width="260" MinWidth="160"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Col.Captured}"
                            Binding="{Binding CapturedAt}" IsReadOnly="True" Width="190"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Col.Session}"
                            Binding="{Binding SessionShort}" IsReadOnly="True" Width="120"/>
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Predicate}" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <ComboBox ItemsSource="{Binding PredicateOptions}"
                        SelectedItem="{Binding SelectedPredicate}"
                        IsEnabled="{Binding PredicateEnabled}"
                        HorizontalAlignment="Stretch" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.ValueFilter}" Width="240">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="2" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding AbsKindOptions}" SelectedItem="{Binding AbsKind}"
                          IsEnabled="{Binding AbsEnabled}" MinWidth="96"/>
                <TextBox Text="{Binding AbsLow}" Width="52" IsEnabled="{Binding AbsEnabled}"
                         IsVisible="{Binding ShowAbsLow}" PlaceholderText="lo"/>
                <TextBox Text="{Binding AbsHigh}" Width="52" IsEnabled="{Binding AbsEnabled}"
                         IsVisible="{Binding ShowAbsHigh}" PlaceholderText="hi"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Live coerced-range preview of the absolute window under the active mode. -->
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Preview}" Width="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <TextBlock Text="{Binding AbsPreview}" Foreground="#4EC9B0"
                         FontFamily="Consolas" FontSize="12"
                         VerticalAlignment="Center" Margin="4,0,0,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Result filters + hint + status -->
    <StackPanel Grid.Row="4" Spacing="6" Margin="0,8,0,8">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Spc.ResClass}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultClassFilter, Mode=TwoWay}" ItemsSource="{Binding ResultClassOptions}"
                         FilterMode="Contains" Width="140" Margin="0,0,8,0"/>
        <TextBlock Text="{StaticResource str.Spc.ResField}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultFieldFilter, Mode=TwoWay}" ItemsSource="{Binding ResultFieldOptions}"
                         FilterMode="Contains" Width="140" Margin="0,0,8,0"/>
        <TextBlock Text="{StaticResource str.Spc.ResObject}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultObjectFilter, Mode=TwoWay}" ItemsSource="{Binding ResultObjectOptions}"
                         FilterMode="Contains" Width="170" Margin="0,0,8,0"/>
        <TextBlock Text="{StaticResource str.Spc.ResGlobal}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultGlobalFilter, Mode=TwoWay}" ItemsSource="{Binding ResultGlobalHistory}"
                         FilterMode="Contains" Width="160" PlaceholderText="{StaticResource str.Spc.ResGlobalHint}"/>
      </WrapPanel>
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Spc.SeqFirst}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding SeqFirstMin}" Width="70" Margin="0,0,2,0" PlaceholderText="min"/>
        <TextBlock Text="–" Foreground="#888" VerticalAlignment="Center" Margin="0,0,2,0"/>
        <TextBox Text="{Binding SeqFirstMax}" Width="70" Margin="0,0,12,0" PlaceholderText="max"/>
        <TextBlock Text="{StaticResource str.Spc.SeqLast}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding SeqLastMin}" Width="70" Margin="0,0,2,0" PlaceholderText="min"/>
        <TextBlock Text="–" Foreground="#888" VerticalAlignment="Center" Margin="0,0,2,0"/>
        <TextBox Text="{Binding SeqLastMax}" Width="70" Margin="0,0,8,0" PlaceholderText="max"/>
        <Button Content="{StaticResource str.Spc.ApplyRange}" Command="{Binding ApplyResultRangeCommand}" Padding="8,3" Margin="0,0,4,0"/>
        <Button Content="{StaticResource str.Spc.ResetRange}" Command="{Binding ResetResultRangeCommand}" Padding="8,3"/>
      </WrapPanel>
      <ProgressBar IsIndeterminate="True" Height="4" Width="220" HorizontalAlignment="Left"
                   IsVisible="{Binding IsQuerying}"/>
      <TextBlock Text="{StaticResource str.Spc.BaselineHint}" Foreground="#888" FontSize="11"
                 TextWrapping="Wrap"/>
      <TextBlock Text="{Binding WarningText}" Foreground="#D7BA7D" FontSize="12" TextWrapping="Wrap"
                 FontStyle="Italic"
                 IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Results -->
    <DataGrid Grid.Row="5" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
              CanUserResizeColumns="True" CanUserSortColumns="True"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Class}"    Binding="{Binding ClassName}"       SortMemberPath="ClassName"       Width="200"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Object}"   Binding="{Binding NormPath}"        SortMemberPath="NormPath"        Width="420" MinWidth="220"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Field}"    Binding="{Binding PropName}"        SortMemberPath="PropName"        Width="150"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Type}"     Binding="{Binding DeclaredType}"    SortMemberPath="DeclaredType"    Width="120"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Sequence}" Binding="{Binding SequenceDisplay}" SortMemberPath="SequenceDisplay" Width="240"/>
        <!-- Per-row actions (mirror Value Search): Open in Live Walker / GWorld /
             Copy Address, each operating on this row. -->
        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:SpcResultRow">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{StaticResource str.Spc.OpenWalker}"
                        Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).OpenInLiveWalkerCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanUseResultRowActions}"
                        Foreground="#4EC9B0" Background="Transparent" BorderThickness="1" BorderBrush="#4EC9B0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <Button Content="{StaticResource str.Spc.CopyAddr}"
                        Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CopyAddressCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanUseResultRowActions}"
                        Foreground="#DCDCAA" Background="Transparent" BorderThickness="1" BorderBrush="#DCDCAA"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <Button Content="{StaticResource str.Spc.LocateGWorld}"
                        Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).LocateRowInGWorldCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanLocateResultRowInGWorld}"
                        ToolTip.Tip="{StaticResource str.Tip.Spc.LocateGWorld}"
                        Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <Button Content="{StaticResource str.Spc.LocateGameEngine}"
                        Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).LocateRowInGameEngineCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanUseResultRowActions}"
                        ToolTip.Tip="{StaticResource str.Tip.Spc.LocateGameEngine}"
                        Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- N1: noise picker (Top-N class contributors) + active denylist chips.
         Collapsed by default; opens to a fixed height so it doesn't eat the
         result grid. Apply pushes ticked rows into the per-game denylist file
         (snapshots.<pe_hash>.denylist.json) and re-runs the SPC query. -->
    <Expander Grid.Row="6" Header="{StaticResource str.Noise.PanelHeader}"
              IsExpanded="{Binding NoisePanelOpen}" Margin="0,8,0,0"
              Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Orientation="Vertical" Margin="6">
        <TextBlock Text="{StaticResource str.Noise.PanelHint}"
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- Top-N picker grid (height-capped) -->
        <DataGrid ItemsSource="{Binding NoiseRows}" IsReadOnly="False"
                  Height="200" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{StaticResource str.Noise.Col.Pick}" Width="50" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:NoiseRowVm">
                  <CheckBox IsChecked="{Binding Picked}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.Class}"
                                Binding="{Binding ClassName}" SortMemberPath="ClassName" IsReadOnly="True" Width="300" MinWidth="180"/>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.Hits}"
                                Binding="{Binding HitCount}" SortMemberPath="HitCount" IsReadOnly="True" Width="80"/>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.SampleProps}"
                                Binding="{Binding SamplePropsDisplay}" SortMemberPath="SamplePropsDisplay" IsReadOnly="True" Width="240"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="{StaticResource str.Noise.Apply}"
                  Command="{Binding ApplyNoisePicksCommand}"
                  Classes="accent" Padding="12,4" Margin="0,0,6,0"/>
          <Button Content="{StaticResource str.Noise.Reset}"
                  Command="{Binding ResetNoisePicksCommand}" Padding="8,4" Margin="0,0,12,0"/>
          <TextBlock Text="{StaticResource str.Noise.ActiveHeader}"
                     Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button Content="{StaticResource str.Noise.Clear}"
                  Command="{Binding ClearDenylistCommand}" Padding="8,3" Margin="0,0,6,0"/>
        </StackPanel>

        <!-- Active denylist chips: one button per class, click removes it. -->
        <ItemsControl ItemsSource="{Binding ActiveDenylist}" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Content="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).RemoveFromDenylistCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{StaticResource str.Noise.RemoveTip}"
                      Margin="0,0,4,4" Padding="6,2"
                      Background="#3C3C3C" Foreground="#CCCCCC"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>
    </Grid>

    <!-- ===================== GROUP mode (Multiple Values) ===================== -->
    <Grid IsVisible="{Binding IsGroupMode}" RowDefinitions="Auto,Auto,Auto,170,Auto,*">

      <!-- Intro -->
      <TextBlock Grid.Row="0" Text="{StaticResource str.Spc.Group.Intro}"
                 Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

      <!-- Query controls -->
      <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
              BorderBrush="#3C3C3C" BorderThickness="1">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{StaticResource str.Spc.Join}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding JoinModeOptions}" SelectedItem="{Binding SelectedJoinMode}"
                    MinWidth="120" Margin="0,0,12,0" ToolTip.Tip="{StaticResource str.Spc.JoinHint}"
                    IsEnabled="{Binding !IsGroupMatching}"/>
          <TextBlock Text="{StaticResource str.Spc.ClassFilter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox Text="{Binding ClassFilter}" Width="140" Margin="0,0,12,0" IsEnabled="{Binding !IsGroupMatching}"/>
          <TextBlock Text="{StaticResource str.Spc.PropFilter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox Text="{Binding PropFilter}" Width="140" Margin="0,0,12,0" IsEnabled="{Binding !IsGroupMatching}"/>
          <!-- Rounding mode: how a fractional float/double absolute target is reduced
               to the displayed integer before compare. Shared with single SPC. -->
          <TextBlock Text="{StaticResource str.Spc.Rounding}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding RoundingModeOptions}" SelectedItem="{Binding SelectedRoundingMode}"
                    MinWidth="90" Margin="0,0,12,0" IsEnabled="{Binding !IsGroupMatching}"/>
          <Button Content="{StaticResource str.Spc.Group.Run}" Command="{Binding RunGroupQueryCommand}"
                  IsEnabled="{Binding CanRunGroupQuery}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Spc.Group.Clear}" Command="{Binding ClearGroupCommand}" Padding="8,4" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Spc.Refresh}" Command="{Binding RefreshCommand}"
                  Padding="8,4" IsEnabled="{Binding !IsGroupMatching}"/>
          <ProgressBar IsIndeterminate="True" Height="4" Width="120" VerticalAlignment="Center" Margin="10,0,8,0"
                       IsVisible="{Binding IsGroupMatching}"/>
          <TextBlock Text="{Binding GroupStatusText}" Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding RoundingModeHint}" Foreground="#999" FontSize="11"
                     FontStyle="Italic" TextWrapping="Wrap" Width="380" Margin="8,4,0,0"/>
        </WrapPanel>
      </Border>

      <!-- Value slots: width scope per value + add/remove + which value the grid edits -->
      <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{StaticResource str.Spc.Group.SlotsHeader}" Foreground="#9CDCFE" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <!-- Prominent active-slot indicator: which value's chain the grid below edits. -->
          <Border Background="#264F26" BorderBrush="#4EC9B0" BorderThickness="1" CornerRadius="3"
                  Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding EditingSlotLabel}" Foreground="#7FE0A0" FontWeight="Bold"/>
          </Border>
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <ItemsControl ItemsSource="{Binding GroupSlots}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpcGroupSlotVm">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).GroupScopeOptions}"
                            SelectedItem="{Binding Scope}" MinWidth="130"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{StaticResource str.Spc.Group.AddSlot}" Command="{Binding AddGroupSlotCommand}"
                  IsEnabled="{Binding CanAddGroupSlot}" Padding="8,3" Margin="0,0,4,0"/>
          <Button Content="{StaticResource str.Spc.Group.RemoveSlot}" Command="{Binding RemoveGroupSlotCommand}"
                  IsEnabled="{Binding CanRemoveGroupSlot}" Padding="8,3" Margin="0,0,12,0"/>
          <TextBlock Text="{StaticResource str.Spc.Group.Editing}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding ActiveSlotChoices}" SelectedIndex="{Binding ActiveGroupSlot}"
                    MinWidth="100" ToolTip.Tip="{StaticResource str.Spc.Group.EditingHint}"
                    IsEnabled="{Binding !IsGroupMatching}"/>
        </WrapPanel>
      </StackPanel>

      <!-- Snapshot picker — tick the snapshots, then set the ACTIVE value's Compare +
           Value filter down the rows. The slot selector above swaps which value is edited. -->
      <DataGrid Grid.Row="3" ItemsSource="{Binding SnapshotPicks}" IsReadOnly="False"
                GridLinesVisibility="Horizontal" Background="#1E1E1E"
                IsEnabled="{Binding !IsGroupMatching}"
                CanUserResizeColumns="True" CanUserSortColumns="False"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Use}" Width="50">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SpcSnapshotPick">
                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{StaticResource str.Spc.Col.Label}"    Binding="{Binding Label}"       IsReadOnly="True" Width="260" MinWidth="160"/>
          <DataGridTextColumn Header="{StaticResource str.Spc.Col.Captured}" Binding="{Binding CapturedAt}"  IsReadOnly="True" Width="190"/>
          <DataGridTextColumn Header="{StaticResource str.Spc.Col.Session}"  Binding="{Binding SessionShort}" IsReadOnly="True" Width="120"/>
          <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Predicate}" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SpcSnapshotPick">
                <ComboBox ItemsSource="{Binding PredicateOptions}"
                          SelectedItem="{Binding GroupActivePredicate}"
                          IsEnabled="{Binding PredicateEnabled}"
                          HorizontalAlignment="Stretch" Margin="2"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.ValueFilter}" Width="240">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SpcSnapshotPick">
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="2" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding AbsKindOptions}" SelectedItem="{Binding GroupActiveAbsKind}"
                            IsEnabled="{Binding AbsEnabled}" MinWidth="96"/>
                  <TextBox Text="{Binding GroupActiveAbsLow}" Width="52" IsEnabled="{Binding AbsEnabled}"
                           IsVisible="{Binding GroupShowAbsLow}" PlaceholderText="lo"/>
                  <TextBox Text="{Binding GroupActiveAbsHigh}" Width="52" IsEnabled="{Binding AbsEnabled}"
                           IsVisible="{Binding GroupShowAbsHigh}" PlaceholderText="hi"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Live coerced-range preview of the ACTIVE slot's window under the active mode. -->
          <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Preview}" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SpcSnapshotPick">
                <TextBlock Text="{Binding GroupAbsPreview}" Foreground="#4EC9B0"
                           FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Hints + error -->
      <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,8">
        <TextBlock Text="{StaticResource str.Spc.BaselineHint}" Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>

      <!-- Results master-detail: one row per matched object; expand for per-slot chains
           + locked offsets + handoffs (reuses GroupCandidate / GroupSlotMatch). -->
      <DataGrid x:Name="GroupGrid"
                Grid.Row="5" ItemsSource="{Binding GroupCandidates}" SelectedItem="{Binding SelectedGroupCandidate}"
                IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                RowDetailsVisibilityMode="VisibleWhenSelected"
                CanUserResizeColumns="True" CanUserSortColumns="True"
                HorizontalScrollBarVisibility="Auto"
                ToolTip.Tip="{StaticResource str.Tip.Group.MatchedOffline}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{StaticResource str.Spc.Group.Col.Class}"   Binding="{Binding LocationLabel}" SortMemberPath="ClassName"    Width="220"/>
          <DataGridTextColumn Header="{StaticResource str.Spc.Group.Col.Object}"  Binding="{Binding InstanceName}"  SortMemberPath="InstanceName" Width="320" MinWidth="200"/>
          <DataGridTextColumn Header="{StaticResource str.Spc.Group.Col.Matched}" Binding="{Binding SlotSummary}"   CanUserSort="False"           Width="440" MinWidth="240"/>
          <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:GroupCandidate">
                <Button Content="{StaticResource str.Spc.OpenWalker}"
                        Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).OpenGroupInLiveWalkerCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanUseResultRowActions}"
                        Foreground="#4EC9B0" Background="Transparent" BorderThickness="1" BorderBrush="#4EC9B0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
        <DataGrid.RowDetailsTemplate>
          <DataTemplate x:DataType="m:GroupCandidate">
            <StackPanel Margin="20,4,8,8" Spacing="4">
              <TextBlock Text="{Binding OffsetTableLabel}" IsVisible="{Binding HasOffsetTable}"
                         Foreground="#DCDCAA" FontFamily="Consolas" FontSize="12"/>
              <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:GroupSlotMatch">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                      <TextBlock Text="{Binding LockLabel}" Foreground="#9CDCFE" VerticalAlignment="Center" MinWidth="36"/>
                      <TextBlock Text="{Binding FieldName}" Foreground="#D4D4D4" VerticalAlignment="Center" Width="200"/>
                      <TextBlock Text="{Binding ScanType}" Foreground="#9CDCFE" FontFamily="Consolas" VerticalAlignment="Center" Width="90"
                                 ToolTip.Tip="{StaticResource str.Spc.Group.Detail.Pattern}"/>
                      <TextBlock Text="{Binding OffsetHex}" Foreground="#888" FontFamily="Consolas" VerticalAlignment="Center" Width="70"/>
                      <TextBlock Text="{Binding FieldType}" Foreground="#888" VerticalAlignment="Center" Width="110"/>
                      <TextBlock Text="{Binding LeafValue}" Foreground="#CE9178" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="80"/>
                      <Button Content="{StaticResource str.Spc.CopyAddr}"
                              Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CopyGroupSlotAddressCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanUseResultRowActions}"
                              Foreground="#DCDCAA" Background="Transparent" BorderThickness="1" BorderBrush="#DCDCAA"
                              Padding="6,2" FontSize="11" Cursor="Hand"/>
                      <Button Content="{StaticResource str.Spc.LocateGWorld}"
                              Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).LocateGroupSlotInGWorldCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanLocateResultRowInGWorld}"
                              ToolTip.Tip="{StaticResource str.Tip.Spc.LocateGWorld}"
                              Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                              Padding="6,2" FontSize="11" Cursor="Hand"/>
                      <Button Content="{StaticResource str.Spc.LocateGameEngine}"
                              Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).LocateGroupSlotInGameEngineCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).CanUseResultRowActions}"
                              ToolTip.Tip="{StaticResource str.Tip.Spc.LocateGameEngine}"
                              Foreground="#C586C0" Background="Transparent" BorderThickness="1" BorderBrush="#C586C0"
                              Padding="6,2" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </DataGrid.RowDetailsTemplate>
      </DataGrid>
    </Grid>

    </Panel>
  </DockPanel>
</UserControl>
