<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             xmlns:svc="using:UE5DumpUI.Services"
             xmlns:views="using:UE5DumpUI.Views"
             x:Class="UE5DumpUI.Views.InterestingFunctionsPanel"
             x:DataType="vm:InterestingFunctionsViewModel">

  <DockPanel Margin="8">

    <!-- Top: Load + Game Only + Search bar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <Button Content="{StaticResource str.IF.Load}"
              Command="{Binding LoadCommand}"
              ToolTip.Tip="{StaticResource str.Tip.IF.Load}"
              IsEnabled="{Binding !IsLoading}"
              Classes="accent" Padding="12,4"/>
      <CheckBox Content="{StaticResource str.IF.GameOnly}"
                IsChecked="{Binding GameOnly}"
                ToolTip.Tip="{StaticResource str.Tip.IF.GameOnly}"
                Foreground="#CCCCCC" FontSize="12"
                VerticalAlignment="Center"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.IF.FilterHint}"
               Text="{Binding FilterText, Mode=TwoWay}"
               ItemsSource="{Binding FilterHistory}"
               FilterMode="Contains"
               ToolTip.Tip="{StaticResource str.Tip.IF.Filter}"
               Width="260" Padding="4,2"/>
      <ComboBox ItemsSource="{Binding CategoryOptions}"
                SelectedItem="{Binding CategoryFilter}"
                ToolTip.Tip="{StaticResource str.Tip.IF.Category}"
                Width="120" FontSize="12">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static svc:CategoryDisplayConverter.Instance}}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Content="{StaticResource str.IF.ShowAll}"
                IsChecked="{Binding ShowAll}"
                ToolTip.Tip="{StaticResource str.Tip.IF.ShowAll}"
                Foreground="#CCCCCC" FontSize="12"
                VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.IF.GameplayActions}"
                IsChecked="{Binding GameplayActions}"
                ToolTip.Tip="{StaticResource str.Tip.IF.GameplayActions}"
                Foreground="#5FBF7F" FontSize="12"
                VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.IF.CallableOnly}"
                IsChecked="{Binding CallableOnly}"
                ToolTip.Tip="{StaticResource str.Tip.IF.CallableOnly}"
                Foreground="#7FB6E8" FontSize="12"
                VerticalAlignment="Center"/>
      <Button Content="{StaticResource str.IF.ClearFilters}"
              Command="{Binding ClearFiltersCommand}"
              ToolTip.Tip="{StaticResource str.Tip.IF.ClearFilters}"
              Padding="6,2" FontSize="11"
              VerticalAlignment="Center"/>
      <views:ClassFacetFilterButton Filter="{Binding ClassFilter}"/>
      <Button Content="{StaticResource str.IF.GenerateCT}"
              Click="OnGenerateCtClick"
              ToolTip.Tip="{StaticResource str.Tip.IF.GenerateCT}"
              Foreground="#00BB5E" Background="Transparent"
              BorderThickness="1" BorderBrush="#00BB5E"
              Padding="6,2" FontSize="11"
              VerticalAlignment="Center"
              Cursor="Hand"/>
      <Button Content="{StaticResource str.IF.BatchProps}"
              Click="OnBatchFindPropsClick"
              IsEnabled="{Binding !IsXrefBatchRunning}"
              ToolTip.Tip="{StaticResource str.Tip.IF.BatchProps}"
              Foreground="#C586C0" Background="Transparent"
              BorderThickness="1" BorderBrush="#C586C0"
              Padding="6,2" FontSize="11"
              VerticalAlignment="Center"
              Cursor="Hand"/>
      <Button Content="{StaticResource str.Common.CancelBatch}"
              Command="{Binding CancelXrefBatchCommand}"
              IsVisible="{Binding IsXrefBatchRunning}"
              Foreground="#E06C75" Background="Transparent"
              BorderThickness="1" BorderBrush="#E06C75"
              Padding="6,2" FontSize="11"
              VerticalAlignment="Center"
              Cursor="Hand"/>
    </StackPanel>

    <!-- Status + progress in their own dock row (mirrors Interesting
         Properties panel build 681 layout) so a long status message
         doesn't get clipped behind the filter buttons at narrow widths. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                Margin="0,0,0,4" VerticalAlignment="Center">
      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsLoading}"
                   Width="80" Height="4"
                   VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#AAB8D0" FontSize="13"
                 FontFamily="Consolas, Menlo, monospace"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding StatusText}"/>
      <TextBlock Text="{Binding ClassFilterNote}"
                 IsVisible="{Binding ClassFilterNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#E0A050" FontSize="12" VerticalAlignment="Center"/>
      <!-- AOBMaker availability indicator — single place (build 688).
           Was previously repeated per-row in the Notes column; that
           was pure noise since the value is VM-level. Visible only
           when the plugin isn't reachable. -->
      <TextBlock Text="{Binding AobMakerNote}"
                 IsVisible="{Binding AobMakerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#E0A050"
                 FontSize="11"
                 FontStyle="Italic"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding AobMakerNote}"/>
    </StackPanel>

    <!-- Error display -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding ErrorMessage}"
               Foreground="#F44747" Margin="0,0,0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Results DataGrid -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedResult}"
              SelectionMode="Extended"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              Background="#1E1E1E"
              Foreground="#D4D4D4"
              FontSize="12"
              FontFamily="Consolas, Menlo, monospace">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Score" Width="60" SortMemberPath="FinalScore" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:ScoredFunctionRow">
              <TextBlock Text="{Binding FinalScore}"
                         Foreground="#CCCCCC"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="6,0"
                         ToolTip.Tip="{Binding ScoreTooltip}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Cat" Width="80" SortMemberPath="CategoryLabel" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:ScoredFunctionRow">
              <TextBlock Text="{Binding CategoryLabel}"
                         Foreground="{Binding CategoryColor}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Margin="4,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" SortMemberPath="ClassName" Width="220"/>
        <DataGridTextColumn Header="Function" Binding="{Binding FuncName}" SortMemberPath="FuncName" Width="200"/>
        <DataGridTextColumn Header="Flags" Binding="{Binding ShortFlags}" SortMemberPath="ShortFlags" Width="120"/>
        <DataGridTextColumn Header="Params" Binding="{Binding ParamsLabel}" SortMemberPath="NumParms" Width="80" CanUserSort="True"/>
        <DataGridTemplateColumn Header="{StaticResource str.IF.UsesCol}" Width="200" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:ScoredFunctionRow">
              <TextBlock Text="{Binding XrefInfo}"
                         Foreground="#C586C0"
                         VerticalAlignment="Center" Margin="4,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding XrefInfo}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:ScoredFunctionRow">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{StaticResource str.IF.OpenInst}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).OpenInInstanceFinderCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.OpenInst}"
                        Foreground="#7FB6E8" Background="Transparent"
                        BorderThickness="1" BorderBrush="#7FB6E8"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="{StaticResource str.IF.Props}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).FindFuncPropsCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.Props}"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="{StaticResource str.IF.OpenLive}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).OpenInLiveWalkerCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.OpenLive}"
                        Foreground="#4EC9B0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#4EC9B0"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="{StaticResource str.IF.LocateGWorld}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).LocateRowInGWorldCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.LocateGWorld}"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="{StaticResource str.IF.LocateGameEngine}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).LocateRowInGameEngineCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.LocateGameEngine}"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="{StaticResource str.IF.CopyAaScript}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).CopyAaScriptCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.CopyAaScript}"
                        Foreground="#7FB6E8" Background="Transparent"
                        BorderThickness="1" BorderBrush="#7FB6E8"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
                <Button Content="{StaticResource str.IF.CopyName}"
                        Command="{Binding $parent[UserControl].((vm:InterestingFunctionsViewModel)DataContext).CopyFunctionNameCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.IF.CopyName}"
                        Foreground="#DCDCAA" Background="Transparent"
                        BorderThickness="1" BorderBrush="#DCDCAA"
                        Padding="6,2" FontSize="11"
                        Cursor="Hand"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- (Build 688) Notes column removed — the value was identical on
             every row (VM-level AOBMaker status); see status row above
             for the single-place indicator. -->
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
