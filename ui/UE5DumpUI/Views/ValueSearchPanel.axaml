<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             xmlns:views="using:UE5DumpUI.Views"
             x:Class="UE5DumpUI.Views.ValueSearchPanel"
             x:DataType="vm:ValueSearchViewModel">

  <DockPanel Margin="8">

    <!-- UX banner (REQUIRED by project memory project_value_search_caveats).
         Surfaces the hard limitation that this scan only sees fields
         declared with UPROPERTY. Raw C++ members embedded inside a UObject
         remain visible to CE's raw scan but invisible to us. The banner
         is locked in by ValueSearchPanel_BannerTest. -->
    <Border DockPanel.Dock="Top"
            Background="#3A2A14"
            BorderBrush="#E0A050" BorderThickness="0,0,0,2"
            Padding="10,6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" Foreground="#E0A050"
                   FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center"/>
        <!-- Default disclosure: native fields invisible (locked in by
             project_value_search_caveats + the banner test). Shown when the
             Native-C opt-in is OFF. -->
        <TextBlock Text="{StaticResource str.VS.Banner}"
                   IsVisible="{Binding !NativeCScan}"
                   Foreground="#F0CC80" FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <!-- Native-C ON: the disclosure no longer applies — warn that the raw
             scan is intentionally noisy on first scan instead. -->
        <TextBlock Text="{StaticResource str.VS.NativeBanner}"
                   IsVisible="{Binding NativeCScan}"
                   Foreground="#F0CC80" FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Single / Group mode toggle (build 1276). Off = single value (default);
         On = multiple values "group" scan. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
      <ToggleSwitch IsChecked="{Binding IsGroupMode}"
                    OffContent="{StaticResource str.VS.Mode.Single}"
                    OnContent="{StaticResource str.VS.Mode.Group}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.Mode}"
                    FontSize="12"/>
    </StackPanel>

    <!-- Status row (shared by both modes) -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding StatusText}"
               Foreground="#AAB8D0" FontSize="12"
               FontFamily="Consolas, Menlo, monospace"
               Margin="0,4,0,4"
               TextWrapping="Wrap"
               ToolTip.Tip="{Binding StatusText}"/>

    <!-- Error row (shared by both modes) -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding ErrorMessage}"
               Foreground="#F44747" Margin="0,0,0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Body: single-mode and group-mode panels overlap in one cell; only the
         active one is visible, so each gets the full remaining space. -->
    <Grid>

      <!-- ============================ SINGLE MODE ============================ -->
      <DockPanel IsVisible="{Binding IsSingleMode}">

        <!-- Inputs row -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4" ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto">

          <!-- Row 0: DataType + ScanType + Values -->
          <TextBlock Grid.Row="0" Grid.Column="0"
                     Text="{StaticResource str.VS.DataType}"
                     Foreground="#CCCCCC" VerticalAlignment="Center"
                     Margin="0,4,8,4"/>
          <StackPanel Grid.Row="0" Grid.Column="1"
                      Orientation="Horizontal" Spacing="6" Margin="0,4,0,4">
            <ComboBox ItemsSource="{Binding DataTypeOptions}"
                      SelectedItem="{Binding SelectedDataType}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.DataType}"
                      MinWidth="100" Padding="4,2" FontSize="12"/>

            <TextBlock Text="{StaticResource str.VS.ScanType}"
                       Foreground="#CCCCCC" VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
            <ComboBox ItemsSource="{Binding VisibleScanTypeOptions}"
                      SelectedItem="{Binding SelectedScanType}"
                      MinWidth="110" Padding="4,2" FontSize="12"/>

            <!-- Value input box: hidden for prev-value scan types so the
                 user understands no value is required for Changed/etc. -->
            <TextBlock Text="{StaticResource str.VS.Value}"
                       Foreground="#CCCCCC" VerticalAlignment="Center"
                       IsVisible="{Binding RequiresValueInput}"
                       Margin="8,0,0,0"/>
            <TextBox Text="{Binding Value}"
                     IsVisible="{Binding RequiresValueInput}"
                     Width="120" Padding="4,2" FontSize="12"/>

            <TextBlock Text="{StaticResource str.VS.Value2}"
                       Foreground="#CCCCCC" VerticalAlignment="Center"
                       IsVisible="{Binding RequiresValue2Input}"
                       Margin="4,0,0,0"/>
            <TextBox Text="{Binding Value2}"
                     IsVisible="{Binding RequiresValue2Input}"
                     Width="120" Padding="4,2" FontSize="12"/>

            <!-- Rounding mode: how a fractional float/double target is reduced to
                 the displayed integer before compare (Round/Trunc/Ceil). Replaces
                 the old ± tolerance band. Hidden for Bool + the 3 string types. -->
            <TextBlock Text="{StaticResource str.VS.Rounding}"
                       Foreground="#CCCCCC" VerticalAlignment="Center"
                       IsVisible="{Binding SupportsRoundingMode}"
                       ToolTip.Tip="{StaticResource str.Tip.VS.Rounding}"
                       Margin="8,0,0,0"/>
            <ComboBox ItemsSource="{Binding RoundingModeOptions}"
                      SelectedItem="{Binding SelectedRoundingMode}"
                      IsVisible="{Binding SupportsRoundingMode}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.Rounding}"
                      MinWidth="90" Padding="4,2" FontSize="12"/>

            <!-- Live "what will this actually match" preview for a Between scan: the
                 coerced integer range and/or literal float range under the active mode
                 (e.g. → int 12~13 · float 11.5~13.2). Hidden until both bounds parse. -->
            <TextBlock Text="{Binding BetweenPreview}"
                       Foreground="#4EC9B0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="12"
                       IsVisible="{Binding BetweenPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Margin="8,0,0,0"/>

            <!-- Case-sensitive checkbox: visible only for string DataTypes
                 (FString / FName / FText). Default unchecked = CE-style
                 case-insensitive matching. -->
            <CheckBox Content="{StaticResource str.VS.CaseSensitive}"
                      IsChecked="{Binding CaseSensitive}"
                      IsVisible="{Binding SupportsCaseSensitive}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.CaseSensitive}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"/>
          </StackPanel>

          <!-- Row 1: Game Only + Max Results -->
          <StackPanel Grid.Row="1" Grid.Column="1"
                      Orientation="Horizontal" Spacing="12" Margin="0,2,0,4">
            <CheckBox Content="{StaticResource str.VS.GameOnly}"
                      IsChecked="{Binding GameOnly}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"/>
            <!-- Parallel scan toggle (default ON). Off = single-threaded DLL walk to
                 avoid concurrent reads tripping a game's anti-tamper (slower). -->
            <CheckBox Content="{StaticResource str.VS.Parallel}"
                      IsChecked="{Binding ParallelScan}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.Parallel}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"/>
            <!-- Batch read toggle (default ON). Off = one SEH read per field
                 instead of one body read per object. -->
            <CheckBox Content="{StaticResource str.VS.BatchRead}"
                      IsChecked="{Binding BatchRead}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.BatchRead}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"/>
            <!-- Opt-in deep-container pass (default off): reaches values buried in
                 deeply-nested containers a shallow scan misses. -->
            <CheckBox Content="{StaticResource str.VS.Deep}"
                      IsChecked="{Binding DeepScan}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.Deep}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"/>
            <!-- Native-C (P1, opt-in, default off): also scan unmanaged holes for
                 native (non-UPROPERTY) values. Auto-enables Newest-first. -->
            <CheckBox Content="{StaticResource str.VS.NativeC}"
                      IsChecked="{Binding NativeCScan}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.NativeC}"
                      Foreground="#E0A050" FontSize="12"
                      VerticalAlignment="Center"/>
            <!-- Newest-first GObjects ordering (auto-checked with Native-C; user can
                 uncheck). Detailed when-to-use guidance in the tooltip. -->
            <CheckBox Content="{StaticResource str.VS.NewestFirst}"
                      IsChecked="{Binding NewestFirst}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.NewestFirst}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"/>
            <!-- "Auto detect Engine/System noise" PRE-filter (opt-in, default off):
                 source-level skip of pure engine/system classes; gameplay guardrail
                 keeps Pawn/Actor/component/AttributeSet. Shared with Group mode. -->
            <CheckBox Content="{StaticResource str.VS.AutoSkipNoise}"
                      IsChecked="{Binding PreFilterNoise}"
                      ToolTip.Tip="{StaticResource str.Tip.VS.AutoSkipNoise}"
                      Foreground="#CCCCCC" FontSize="12"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.VS.MaxResults}"
                       Foreground="#CCCCCC" FontSize="12"
                       VerticalAlignment="Center"
                       ToolTip.Tip="{StaticResource str.Tip.VS.MaxResults}"/>
            <!-- V2 (build 950): ceiling raised 500k -> 1M now that the UI windows
                 server-side (V3-C) — the DLL holds the lean set cheaply and only a
                 page is ever serialized/rendered. Default stays 50k (a broad scan
                 shouldn't collect a million by default; the truncation note tells
                 the user to raise it). -->
            <NumericUpDown Value="{Binding MaxResultsValue}"
                           Minimum="100" Maximum="1000000" ClipValueToMinMax="True" Increment="10000"
                           ToolTip.Tip="{StaticResource str.Tip.VS.MaxResults}"
                           Width="170" FontSize="12"
                           VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <!-- User-adjustable scan deadline (was a hard 15s). 10–90s, default 25.
                 Threaded to the DLL as deadline_ms; shared by Single + Group modes. -->
            <TextBlock Text="{StaticResource str.VS.Timeout}"
                       Foreground="#CCCCCC" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       ToolTip.Tip="{StaticResource str.Tip.VS.Timeout}"/>
            <Slider Value="{Binding ScanTimeoutSeconds}"
                    Minimum="10" Maximum="90"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    Width="110" VerticalAlignment="Center"
                    ToolTip.Tip="{StaticResource str.Tip.VS.Timeout}"/>
            <TextBlock Text="{Binding ScanTimeoutSeconds, StringFormat='{}{0}s'}"
                       Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                       VerticalAlignment="Center" MinWidth="28"/>
          </StackPanel>

          <!-- Row 2: action buttons -->
          <StackPanel Grid.Row="2" Grid.Column="1"
                      Orientation="Horizontal" Spacing="8" Margin="0,2,0,4">
            <Button Content="{StaticResource str.VS.FirstScan}"
                    Command="{Binding FirstScanCommand}"
                    IsEnabled="{Binding !IsScanning}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.FirstScan}"
                    Classes="accent" Padding="12,4"/>
            <Button Content="{StaticResource str.VS.NextScan}"
                    Command="{Binding NextScanCommand}"
                    IsEnabled="{Binding HasSession}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.NextScan}"
                    Padding="12,4"/>
            <Button Content="{StaticResource str.VS.NewScan}"
                    Command="{Binding NewScanCommand}"
                    IsEnabled="{Binding HasSession}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.NewScan}"
                    Padding="12,4"/>
            <Button Content="{StaticResource str.VS.Cancel}"
                    Command="{Binding CancelScanCommand}"
                    IsVisible="{Binding IsScanning}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.Cancel}"
                    Foreground="#F44747" BorderBrush="#F44747" BorderThickness="1"
                    Background="Transparent" Padding="12,4"/>
            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsScanning}"
                         Width="80" Height="4"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>

        <!-- Rounding-mode hint: explains how the chosen mode reduces a fractional
             target. Visible only when the rounding picker is shown. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding RoundingModeHint}"
                   Foreground="#9CA8B4" FontSize="11" FontStyle="Italic"
                   Margin="0,0,0,4" TextWrapping="Wrap"
                   IsVisible="{Binding SupportsRoundingMode}"/>

        <!-- DataType caution row: result-volume warning for NumericAll
             (1-byte fields flood on small values). Empty for every other
             DataType so the row collapses. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding DataTypeWarning}"
                   Foreground="#E0A050" FontSize="11" FontStyle="Italic"
                   Margin="0,0,0,4" TextWrapping="Wrap"
                   IsVisible="{Binding DataTypeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Filter + sort row. Both run SERVER-SIDE over the full session set
             (V3-C): the DLL owns the candidates and the grid shows one window at a
             time, so a loaded-window-only filter/sort would be untrustworthy. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
              ToolTip.Tip="{StaticResource str.Tip.VS.Sort}">
          <TextBlock Grid.Column="0" Text="{StaticResource str.VS.Filter}"
                     Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <AutoCompleteBox Grid.Column="1" Text="{Binding FilterText, Mode=TwoWay}"
                   ItemsSource="{Binding FilterHistory}" FilterMode="Contains"
                   PlaceholderText="{StaticResource str.VS.FilterWatermark}"
                   Padding="4,2" FontSize="12"/>
          <TextBlock Grid.Column="2" Text="{StaticResource str.VS.Sort}"
                     Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <ComboBox Grid.Column="3" MinWidth="110"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}"
                    FontSize="12" VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ValueSortOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton Grid.Column="4" Content="{StaticResource str.VS.SortDesc}"
                        IsChecked="{Binding SortDescending}"
                        Margin="6,0,0,0" Padding="8,2" FontSize="11"
                        VerticalAlignment="Center" Cursor="Hand"/>
          <views:ClassFacetFilterButton Grid.Column="5" Margin="6,0,0,0"
                                        Filter="{Binding ClassFilter}"/>
        </Grid>

        <!-- Window paging bar: "showing N of M" + Load More (V3-C). -->
        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding WindowStatus}"
                     Foreground="#AAB8D0" FontSize="11" VerticalAlignment="Center"
                     FontFamily="Consolas, Menlo, monospace"
                     TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="1" Content="{StaticResource str.VS.LoadMore}"
                  Command="{Binding LoadMoreCommand}"
                  IsVisible="{Binding HasMore}"
                  Foreground="#4EC9B0" Background="Transparent"
                  BorderThickness="1" BorderBrush="#4EC9B0"
                  Padding="10,3" FontSize="11" Cursor="Hand"/>
        </Grid>

        <!-- Results DataGrid -->
        <DataGrid x:Name="ResultsGrid"
                  ItemsSource="{Binding Candidates}"
                  SelectedItem="{Binding SelectedCandidate}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Sorting="ResultsGrid_Sorting"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="#1E1E1E"
                  Foreground="#D4D4D4"
                  FontSize="12"
                  FontFamily="Consolas, Menlo, monospace">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Class.Field" Binding="{Binding LocationLabel}" SortMemberPath="LocationLabel" Width="320"/>
            <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" SortMemberPath="FieldType" Width="120"/>
            <!-- Native-C (P1): "Reflected" vs "Native-C (Int32)". Client-computed,
                 so NOT server-sortable (the windowed session has no Origin key). -->
            <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" CanUserSort="False" Width="130"/>
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" SortMemberPath="Value" Width="120"/>
            <DataGridTextColumn Header="Offset" Binding="{Binding OffsetHex}" SortMemberPath="FieldOffset" Width="80"/>
            <DataGridTextColumn Header="Address" Binding="{Binding Addr}" SortMemberPath="Addr" Width="160"/>
            <DataGridTextColumn Header="Instance" Binding="{Binding InstanceName}" SortMemberPath="InstanceName" Width="200"/>
            <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="m:ValueCandidate">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="{StaticResource str.VS.OpenLive}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).OpenInLiveWalkerCommand}"
                            CommandParameter="{Binding}"
                            Foreground="#4EC9B0" Background="Transparent"
                            BorderThickness="1" BorderBrush="#4EC9B0"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                    <!-- Open the hit's owning class in the Instance Finder tab
                         (pre-fill class + auto-run search). -->
                    <Button Content="{StaticResource str.VS.OpenInst}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).OpenInInstanceFinderCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{StaticResource str.Tip.VS.OpenInst}"
                            Foreground="#7FB6E8" Background="Transparent"
                            BorderThickness="1" BorderBrush="#7FB6E8"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                    <Button Content="{StaticResource str.VS.CopyAddr}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).CopyAddressCommand}"
                            CommandParameter="{Binding}"
                            Foreground="#DCDCAA" Background="Transparent"
                            BorderThickness="1" BorderBrush="#DCDCAA"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                    <!-- Show the hit's owning object's related objects
                         (components, GAS ASC → AttributeSets, counterpart). -->
                    <Button Content="{StaticResource str.Related.IconButton}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).ShowRelatedObjectsCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{StaticResource str.Tip.Related.Show}"
                            Foreground="#CE9178" Background="Transparent"
                            BorderThickness="1" BorderBrush="#CE9178"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                    <!-- Value-locator -> pivot handoff. Only shown when the experimental
                         Class Pivot tab is available (PivotEnabled). -->
                    <Button Content="{StaticResource str.VS.PivotThis}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).PivotThisCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).PivotEnabled}"
                            Foreground="#9CDCFE" Background="Transparent"
                            BorderThickness="1" BorderBrush="#9CDCFE"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                    <!-- Locate in GWorld: reach the owning object via the shortest
                         pointer path from GWorld. Always clickable — the DLL's path
                         search is the source of truth and reports if GWorld is
                         unavailable (gating on the C# flag wrongly disabled it on
                         games where GWorld was actually resolved, e.g. TQ2). -->
                    <Button Content="{StaticResource str.VS.LocateGWorld}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).LocateCandidateInGWorldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{StaticResource str.Tip.VS.LocateGWorld}"
                            Foreground="#C586C0" Background="Transparent"
                            BorderThickness="1" BorderBrush="#C586C0"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                    <Button Content="{StaticResource str.VS.LocateGameEngine}"
                            Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).LocateCandidateInGameEngineCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{StaticResource str.Tip.VS.LocateGameEngine}"
                            Foreground="#C586C0" Background="Transparent"
                            BorderThickness="1" BorderBrush="#C586C0"
                            Padding="6,2" FontSize="11"
                            Cursor="Hand"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- ============================ GROUP MODE ============================ -->
      <DockPanel IsVisible="{Binding IsGroupMode}">

        <!-- Hint -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{StaticResource str.VS.Group.Hint}"
                   Foreground="#AAB8D0" FontSize="11" FontStyle="Italic"
                   Margin="0,0,0,6" TextWrapping="Wrap"/>

        <!-- Group input rows (2..4): per-row width scope + value -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding GroupInputs}" Margin="0,0,0,2">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:GroupSlotInput">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).GroupDataTypeOptions}"
                          SelectedItem="{Binding DataType}"
                          MinWidth="120" Padding="4,2" FontSize="12"/>
                <!-- Per-slot predicate (P2). Prev-value types (Changed/Increased/...)
                     compare against the previous round; the value box hides for them. -->
                <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).GroupScanTypeOptions}"
                          SelectedItem="{Binding ScanType}"
                          ToolTip.Tip="{StaticResource str.Tip.VS.Group.ScanType}"
                          MinWidth="100" Padding="4,2" FontSize="12"/>
                <TextBox Text="{Binding Value}" PlaceholderText="value"
                         IsVisible="{Binding RequiresValueInput}"
                         Width="160" Padding="4,2" FontSize="12"/>
                <!-- Between upper bound — only shown when scan type is Between. -->
                <TextBlock Text=".." Foreground="#888888" VerticalAlignment="Center"
                           IsVisible="{Binding RequiresValue2Input}"/>
                <TextBox Text="{Binding Value2}" PlaceholderText="to"
                         IsVisible="{Binding RequiresValue2Input}"
                         Width="120" Padding="4,2" FontSize="12"/>
                <!-- Live coerced-range preview for this Between row (mixed numeric →
                     both int and float interpretations), under the panel rounding mode. -->
                <TextBlock Text="{Binding BetweenPreview}"
                           Foreground="#4EC9B0" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="12"
                           IsVisible="{Binding BetweenPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add / remove input rows -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
          <Button Content="{StaticResource str.VS.Group.AddRow}"
                  Command="{Binding AddGroupRowCommand}"
                  IsEnabled="{Binding CanAddGroupRow}"
                  Padding="8,3" FontSize="11"/>
          <Button Content="{StaticResource str.VS.Group.RemoveRow}"
                  Command="{Binding RemoveGroupRowCommand}"
                  IsEnabled="{Binding CanRemoveGroupRow}"
                  Padding="8,3" FontSize="11"/>
          <!-- Deep mode: match groups hidden inside deeply-nested numeric arrays
               (each array / struct-array element becomes its own match block). -->
          <CheckBox Content="{StaticResource str.VS.Deep}"
                    IsChecked="{Binding DeepScan}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.Deep}"
                    Foreground="#CCCCCC" FontSize="12"
                    VerticalAlignment="Center" Margin="12,0,0,0"/>
          <!-- Cross-object (P4): also match groups whose values are spread across an
               actor and the sub-objects it owns (components + GAS AttributeSets). -->
          <CheckBox Content="{StaticResource str.VS.CrossObject}"
                    IsChecked="{Binding CrossObjectScan}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.CrossObject}"
                    Foreground="#CCCCCC" FontSize="12"
                    VerticalAlignment="Center" Margin="8,0,0,0"/>
          <!-- Native-C (P2): also fold each object's unmanaged-hole leaves into its
               group block, so a group including a native (non-UPROPERTY) value matches.
               Shares NativeCScan with single mode. -->
          <CheckBox Content="{StaticResource str.VS.NativeC}"
                    IsChecked="{Binding NativeCScan}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.NativeC.Group}"
                    Foreground="#E0A050" FontSize="12"
                    VerticalAlignment="Center" Margin="8,0,0,0"/>
          <!-- Newest-first (P2): visible opt-in here too (shares NewestFirst with single
               mode). Auto-checked when Native-C is enabled; the user can uncheck it — e.g.
               for an operated-character value created early at game start (low index), as
               opposed to a late-spawned UI/menu panel (high index, needs newest-first). -->
          <CheckBox Content="{StaticResource str.VS.NewestFirst}"
                    IsChecked="{Binding NewestFirst}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.NewestFirst}"
                    Foreground="#CCCCCC" FontSize="12"
                    VerticalAlignment="Center" Margin="8,0,0,0"/>
          <!-- "Auto detect Engine/System noise" PRE-filter (opt-in, default off):
               same source-level skip + gameplay guardrail as single mode. Shares
               PreFilterNoise with single mode. -->
          <CheckBox Content="{StaticResource str.VS.AutoSkipNoise}"
                    IsChecked="{Binding PreFilterNoise}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.AutoSkipNoise}"
                    Foreground="#CCCCCC" FontSize="12"
                    VerticalAlignment="Center" Margin="8,0,0,0"/>
          <!-- Rounding mode: shared with single mode (SelectedRoundingMode). Always
               shown here (group scans operate on numerics). -->
          <TextBlock Text="{StaticResource str.VS.Rounding}"
                     Foreground="#CCCCCC" FontSize="12"
                     VerticalAlignment="Center" Margin="12,0,0,0"
                     ToolTip.Tip="{StaticResource str.Tip.VS.Rounding}"/>
          <ComboBox ItemsSource="{Binding RoundingModeOptions}"
                    SelectedItem="{Binding SelectedRoundingMode}"
                    ToolTip.Tip="{StaticResource str.Tip.VS.Rounding}"
                    MinWidth="90" Padding="4,2" FontSize="12"
                    VerticalAlignment="Center"/>
          <!-- User-adjustable scan deadline (was a hard 15s). Shares ScanTimeoutSeconds
               with single mode (10–90s, default 25; threaded as deadline_ms). -->
          <TextBlock Text="{StaticResource str.VS.Timeout}"
                     Foreground="#CCCCCC" FontSize="12"
                     VerticalAlignment="Center" Margin="12,0,0,0"
                     ToolTip.Tip="{StaticResource str.Tip.VS.Timeout}"/>
          <Slider Value="{Binding ScanTimeoutSeconds}"
                  Minimum="10" Maximum="90"
                  TickFrequency="5" IsSnapToTickEnabled="True"
                  Width="110" VerticalAlignment="Center"
                  ToolTip.Tip="{StaticResource str.Tip.VS.Timeout}"/>
          <TextBlock Text="{Binding ScanTimeoutSeconds, StringFormat='{}{0}s'}"
                     Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"
                     VerticalAlignment="Center" MinWidth="28"/>
                     <!-- Group-only leaf budget. Powers of two, not a spinner: nothing between
                          8/16/.../4096 changes behaviour, so free entry only invites a clamp.
                          Lives in the GROUP options row - the first attempt put it in the
                          SINGLE-mode row, where group mode never renders it. -->
                     <TextBlock Text="{StaticResource str.VS.PerSlotCap}"
                                Foreground="#CCCCCC" FontSize="12"
                                VerticalAlignment="Center" Margin="12,0,4,0"
                                ToolTip.Tip="{StaticResource str.Tip.VS.PerSlotCap}"/>
                     <ComboBox ItemsSource="{Binding PerSlotCapChoices}"
                               SelectedItem="{Binding GroupPerSlotCap}"
                               Width="86" FontSize="12"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{StaticResource str.Tip.VS.PerSlotCap}"/>
        </StackPanel>

        <!-- Rounding-mode hint for group mode. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding RoundingModeHint}"
                   Foreground="#9CA8B4" FontSize="11" FontStyle="Italic"
                   Margin="0,0,0,4" TextWrapping="Wrap"/>

        <!-- Group action buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,2,0,4">
          <Button Content="{StaticResource str.VS.Group.FirstScan}"
                  Command="{Binding GroupFirstScanCommand}"
                  IsEnabled="{Binding !IsScanning}"
                  ToolTip.Tip="{StaticResource str.Tip.VS.Group.FirstScan}"
                  Classes="accent" Padding="12,4"/>
          <Button Content="{StaticResource str.VS.Group.NextScan}"
                  Command="{Binding GroupNextScanCommand}"
                  IsEnabled="{Binding HasGroupSession}"
                  Padding="12,4"/>
          <Button Content="{StaticResource str.VS.Group.NewScan}"
                  Command="{Binding GroupNewScanCommand}"
                  IsEnabled="{Binding HasGroupSession}"
                  Padding="12,4"/>
          <Button Content="{StaticResource str.VS.Cancel}"
                  Command="{Binding CancelScanCommand}"
                  IsVisible="{Binding IsScanning}"
                  ToolTip.Tip="{StaticResource str.Tip.VS.Cancel}"
                  Foreground="#F44747" BorderBrush="#F44747" BorderThickness="1"
                  Background="Transparent" Padding="12,4"/>
          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsScanning}"
                       Width="80" Height="4"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Group filter + sort (server-side over the matched-object set) -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{StaticResource str.VS.Filter}"
                     Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <AutoCompleteBox Grid.Column="1" Text="{Binding GroupFilterText, Mode=TwoWay}"
                   ItemsSource="{Binding GroupFilterHistory}" FilterMode="Contains"
                   PlaceholderText="{StaticResource str.VS.Group.FilterWatermark}"
                   ToolTip.Tip="{StaticResource str.Tip.VS.Group.Filter}"
                   Padding="4,2" FontSize="12"/>
          <TextBlock Grid.Column="2" Text="{StaticResource str.VS.Sort}"
                     Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <ComboBox Grid.Column="3" MinWidth="110"
                    ItemsSource="{Binding GroupSortOptions}"
                    SelectedItem="{Binding SelectedGroupSortOption}"
                    FontSize="12" VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ValueSortOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton Grid.Column="4" Content="{StaticResource str.VS.SortDesc}"
                        IsChecked="{Binding GroupSortDescending}"
                        Margin="6,0,0,0" Padding="8,2" FontSize="11"
                        VerticalAlignment="Center" Cursor="Hand"/>
          <views:ClassFacetFilterButton Grid.Column="5" Margin="6,0,0,0"
                                        Filter="{Binding GroupClassFilter}"/>
        </Grid>

        <!-- Group window paging bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding GroupWindowStatus}"
                     Foreground="#AAB8D0" FontSize="11" VerticalAlignment="Center"
                     FontFamily="Consolas, Menlo, monospace"
                     TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="1" Content="{StaticResource str.VS.LoadMore}"
                  Command="{Binding GroupLoadMoreCommand}"
                  IsVisible="{Binding GroupHasMore}"
                  Foreground="#4EC9B0" Background="Transparent"
                  BorderThickness="1" BorderBrush="#4EC9B0"
                  Padding="10,3" FontSize="11" Cursor="Hand"/>
        </Grid>

        <!-- Group results: one row per matched object; select a row to expand
             its located per-slot fields (master-detail). -->
        <DataGrid x:Name="GroupResultsGrid"
                  ItemsSource="{Binding GroupCandidates}"
                  SelectedItem="{Binding SelectedGroupCandidate}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="#1E1E1E"
                  Foreground="#D4D4D4"
                  FontSize="12"
                  FontFamily="Consolas, Menlo, monospace"
                  HorizontalScrollBarVisibility="Auto"
                  ToolTip.Tip="{StaticResource str.Tip.VS.Group.Matched}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Class" Binding="{Binding LocationLabel}" Width="280"/>
            <DataGridTextColumn Header="Instance" Binding="{Binding InstanceName}" Width="180"/>
            <DataGridTextColumn Header="Matched values" Binding="{Binding SlotSummary}" Width="440" MinWidth="240"/>
            <DataGridTemplateColumn Header="" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="m:GroupCandidate">
                  <Button Content="{StaticResource str.VS.OpenInst}"
                          Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).OpenGroupInInstanceFinderCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{StaticResource str.Tip.VS.OpenInst}"
                          Foreground="#7FB6E8" Background="Transparent"
                          BorderThickness="1" BorderBrush="#7FB6E8"
                          Padding="6,2" FontSize="11" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate x:DataType="m:GroupCandidate">
              <Border Background="#252526" Padding="8,4" Margin="20,2,0,6">
                <StackPanel>
                  <!-- Locked-offset table (P2): the actionable summary once every
                       slot has converged to a single offset — class + each value's
                       byte offset. Export the chain itself from Live Walker. -->
                  <Border IsVisible="{Binding HasOffsetTable}"
                          Background="#16302A" BorderBrush="#2E5E50" BorderThickness="1"
                          CornerRadius="3" Padding="6,3" Margin="0,0,0,6">
                    <TextBlock Text="{Binding OffsetTableLabel}"
                               Foreground="#4EC9B0" FontSize="12"
                               FontFamily="Consolas, Menlo, monospace"
                               TextWrapping="Wrap"/>
                  </Border>
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:GroupSlotMatch">
                     <!-- Vertical: the slot's own row, then (on demand) EVERY field
                          that slot matched. The row can show only one assignment, so
                          without the list a matched field reads as a missed one. -->
                     <StackPanel Margin="0,2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LockLabel}" Width="36"
                                   Foreground="#4EC9B0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayLabel}" Width="520"
                                   Foreground="#D4D4D4" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LeafValue}" Width="80"
                                   Foreground="#CE9178" VerticalAlignment="Center"/>
                        <!-- FIRST of the buttons, not last: it is the answer to
                             "why isn't my field here?", so it must be visible
                             without scrolling the row sideways. Only shown when
                             this slot stands in for more than one field. -->
                        <Button Content="{StaticResource str.VS.Group.AllFields}"
                                Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).LoadGroupSlotLeavesCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding HasHiddenLeaves}"
                                ToolTip.Tip="{StaticResource str.Tip.VS.Group.AllFields}"
                                Foreground="#DCDCAA" Background="Transparent"
                                BorderThickness="1" BorderBrush="#DCDCAA"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.VS.OpenLive}"
                                Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).OpenGroupSlotInLiveWalkerCommand}"
                                CommandParameter="{Binding}"
                                Foreground="#4EC9B0" Background="Transparent"
                                BorderThickness="1" BorderBrush="#4EC9B0"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.VS.CopyAddr}"
                                Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).CopyGroupSlotAddressCommand}"
                                CommandParameter="{Binding}"
                                Foreground="#DCDCAA" Background="Transparent"
                                BorderThickness="1" BorderBrush="#DCDCAA"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.VS.PivotThis}"
                                Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).PivotGroupSlotCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).PivotEnabled}"
                                Foreground="#9CDCFE" Background="Transparent"
                                BorderThickness="1" BorderBrush="#9CDCFE"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.VS.LocateGWorld}"
                                Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).LocateGroupSlotInGWorldCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{StaticResource str.Tip.VS.LocateGWorld}"
                                Foreground="#C586C0" Background="Transparent"
                                BorderThickness="1" BorderBrush="#C586C0"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                        <Button Content="{StaticResource str.VS.LocateGameEngine}"
                                Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).LocateGroupSlotInGameEngineCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{StaticResource str.Tip.VS.LocateGameEngine}"
                                Foreground="#C586C0" Background="Transparent"
                                BorderThickness="1" BorderBrush="#C586C0"
                                Padding="6,2" FontSize="11" Cursor="Hand"/>
                      </StackPanel>
                      <!-- Every field this slot matched, by name. Empty until the
                           "All fields" button fetches it (query_group_slot_leaves).
                           Each entry is a full slot match, so the same handoffs apply.
                           Height-capped and scrolled: per_slot_cap allows up to 4096
                           leaves, and an uncapped list would make one expanded row
                           thousands of pixels tall. -->
                      <ScrollViewer MaxHeight="220" Margin="44,2,0,4"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Leaves}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="m:GroupSlotMatch">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                              <TextBlock Text="{Binding DisplayLabel}" Width="520"
                                         Foreground="#9CDCFE" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding LeafValue}" Width="80"
                                         Foreground="#CE9178" VerticalAlignment="Center"/>
                              <Button Content="{StaticResource str.VS.OpenLive}"
                                      Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).OpenGroupSlotInLiveWalkerCommand}"
                                      CommandParameter="{Binding}"
                                      Foreground="#4EC9B0" Background="Transparent"
                                      BorderThickness="1" BorderBrush="#4EC9B0"
                                      Padding="6,1" FontSize="11" Cursor="Hand"/>
                              <Button Content="{StaticResource str.VS.CopyAddr}"
                                      Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).CopyGroupSlotAddressCommand}"
                                      CommandParameter="{Binding}"
                                      Foreground="#DCDCAA" Background="Transparent"
                                      BorderThickness="1" BorderBrush="#DCDCAA"
                                      Padding="6,1" FontSize="11" Cursor="Hand"/>
                              <Button Content="{StaticResource str.VS.PivotThis}"
                                      Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).PivotGroupSlotCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).PivotEnabled}"
                                      Foreground="#9CDCFE" Background="Transparent"
                                      BorderThickness="1" BorderBrush="#9CDCFE"
                                      Padding="6,1" FontSize="11" Cursor="Hand"/>
                              <Button Content="{StaticResource str.VS.LocateGWorld}"
                                      Command="{Binding $parent[UserControl].((vm:ValueSearchViewModel)DataContext).LocateGroupSlotInGWorldCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="{StaticResource str.Tip.VS.LocateGWorld}"
                                      Foreground="#C586C0" Background="Transparent"
                                      BorderThickness="1" BorderBrush="#C586C0"
                                      Padding="6,1" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </ScrollViewer>
                     </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
      </DockPanel>

    </Grid>
  </DockPanel>
</UserControl>
