<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             xmlns:views="using:UE5DumpUI.Views"
             x:Class="UE5DumpUI.Views.PropertySearchPanel"
             x:DataType="vm:PropertySearchViewModel">

  <DockPanel Margin="8">
    <!-- Top: Search bar (issues a DLL roundtrip on Search click / Enter).
         [FORCESTATUSCLIP-2026-08-22] The row is a DockPanel, not one horizontal StackPanel,
         for one reason: a StackPanel gives every child its DESIRED width, so a long
         StatusText is hard-cut at the panel edge with no ellipsis and no way to read the
         tail. TextTrimming cannot help there — nothing ever constrains the TextBlock. The
         fixed-width controls stay in a Left-docked StackPanel; StatusText is the fill child,
         so it gets exactly the leftover width and trims honestly at any window size. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
      <TextBox PlaceholderText="{StaticResource str.PropertySearch.QueryHint}"
               Text="{Binding SearchQuery}"
               x:Name="SearchQueryInput"
               KeyDown="SearchQueryInput_KeyDown"
               ToolTip.Tip="{StaticResource str.Tip.PropertySearch.Query}"
               Width="260" Padding="4,2"/>
      <AutoCompleteBox PlaceholderText="{StaticResource str.PropertySearch.TypeHint}"
                       Text="{Binding TypeFilter}"
                       ItemsSource="{Binding PropertyTypeSuggestions}"
                       FilterMode="Contains"
                       MinimumPrefixLength="0"
                       MinimumPopulateDelay="0:0:0.05"
                       ToolTip.Tip="{StaticResource str.Tip.PropertySearch.TypeFilter}"
                       x:Name="TypeFilterInput"
                       KeyDown="SearchQueryInput_KeyDown"
                       Width="280" Padding="4,2"/>
      <CheckBox Content="{StaticResource str.PropertySearch.GameOnly}"
                IsChecked="{Binding GameClassesOnly}"
                ToolTip.Tip="{StaticResource str.Tip.PropertySearch.GameOnly}"
                Foreground="#CCCCCC" FontSize="12"
                VerticalAlignment="Center"/>
      <CheckBox Content="{StaticResource str.PropertySearch.Deep}"
                IsChecked="{Binding DeepSearch}"
                ToolTip.Tip="{StaticResource str.Tip.PropertySearch.Deep}"
                Foreground="#CCCCCC" FontSize="12"
                VerticalAlignment="Center"/>
      <!-- Configurable result cap. The class walk is always exhaustive; this only caps
           the returned list. Clamped 100-50000 here and again DLL-side. Default 200
           (NOT Instance Finder's 5000 — these rows carry a resolved preview value each).
           [PROPSEARCHCAP-2026-08-19] -->
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                  ToolTip.Tip="{StaticResource str.Tip.PropertySearch.MaxResults}">
        <TextBlock Text="{StaticResource str.PropertySearch.MaxResults}"
                   Foreground="#888" VerticalAlignment="Center"/>
        <NumericUpDown Value="{Binding PropertySearchCapValue}"
                       Minimum="100" Maximum="50000" ClipValueToMinMax="True" Increment="100"
                       FormatString="0" Width="120" FontSize="12"
                       VerticalAlignment="Center"/>
      </StackPanel>
      <Button Content="{StaticResource str.PropertySearch.Search}"
              Command="{Binding SearchCommand}"
              ToolTip.Tip="{StaticResource str.Tip.PropertySearch.Search}"
              Classes="accent" Padding="12,4"/>
      </StackPanel>

      <!-- Docked Right so it keeps its full width; it is short and never the clipped one. -->
      <TextBlock Text="{Binding ClassFilterNote}" DockPanel.Dock="Right"
                 IsVisible="{Binding ClassFilterNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#E0A050" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
      <!-- Fill child. ToolTip carries the FULL text: trimming makes the truncation visible,
           the tooltip makes the tail readable. Both matter — the clipped tail is the part
           that says "cap reached, more exist unheld", i.e. the honesty clause. -->
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#AAB8D0" FontSize="13" FontFamily="Consolas, Menlo, monospace"
                 VerticalAlignment="Center" Margin="8,0"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding StatusText}"/>
    </DockPanel>

    <!-- Result filter (client-side; no DLL roundtrip) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{StaticResource str.PropertySearch.ResultFilterLabel}"
                 Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
      <AutoCompleteBox Text="{Binding ResultFilter, Mode=TwoWay}"
                       ItemsSource="{Binding ResultFilterHistory}"
                       FilterMode="Contains"
                       PlaceholderText="{StaticResource str.PropertySearch.ResultFilterHint}"
                       ToolTip.Tip="{StaticResource str.Tip.PropertySearch.ResultFilter}"
                       Width="320" Padding="4,2" FontSize="12"/>
      <views:ClassFacetFilterButton Filter="{Binding ClassFilter}"/>
      <Button Content="{StaticResource str.Common.BatchFuncs}"
              Click="OnBatchFindFuncsClick"
              IsEnabled="{Binding !IsXrefBatchRunning}"
              ToolTip.Tip="{StaticResource str.Tip.Common.BatchFuncs}"
              Foreground="#C586C0" Background="Transparent"
              BorderThickness="1" BorderBrush="#C586C0"
              Padding="6,2" FontSize="11"
              VerticalAlignment="Center" Cursor="Hand"/>
      <Button Content="{StaticResource str.Common.CancelBatch}"
              Command="{Binding CancelXrefBatchCommand}"
              IsVisible="{Binding IsXrefBatchRunning}"
              Foreground="#E06C75" Background="Transparent"
              BorderThickness="1" BorderBrush="#E06C75"
              Padding="6,2" FontSize="11"
              VerticalAlignment="Center" Cursor="Hand"/>
    </StackPanel>

    <!-- Loading indicator -->
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsSearching}" Height="2" Margin="0,0,0,4"/>

    <!-- Error display -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding ErrorMessage}"
               Foreground="#F44747" Margin="0,0,0,4"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Forced fields (Solide) — active DLL holds with the "N held" honesty count.
         Docked bottom; only visible while at least one field is being held. -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasForcedFields}"
            Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
            Padding="6,4" Margin="0,4,0,0">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{StaticResource str.PropertySearch.ForcedHeader}"
                     Foreground="#CCCCCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="{StaticResource str.PropertySearch.ForcedClearAll}"
                  Command="{Binding ClearAllForcedFieldsCommand}"
                  ToolTip.Tip="{StaticResource str.Tip.PropertySearch.ForcedClearAll}"
                  Padding="6,2" FontSize="11"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ForcedFields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:ForcedFieldInfo">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                <Button Content="✕"
                        Command="{Binding $parent[ItemsControl].((vm:PropertySearchViewModel)DataContext).RemoveForcedFieldCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.PropertySearch.ForcedRemove}"
                        Padding="5,0" FontSize="11"/>
                <TextBlock Foreground="#D4D4D4" FontFamily="Consolas, monospace" FontSize="11"
                           VerticalAlignment="Center" Text="{Binding ClassName}"/>
                <TextBlock Foreground="#808080" FontSize="11" VerticalAlignment="Center" Text="::"/>
                <TextBlock Foreground="#D4D4D4" FontFamily="Consolas, monospace" FontSize="11"
                           VerticalAlignment="Center" Text="{Binding FieldName}"/>
                <TextBlock Foreground="#4EC9B0" FontSize="11" VerticalAlignment="Center"
                           Text="{Binding Held, StringFormat='({0} held)'}"/>
                <!-- Held is a floor when the pool was capped — say so, or "(256 held)"
                     reads as "all of them". -->
                <TextBlock Foreground="#D7BA7D" FontSize="11" VerticalAlignment="Center"
                           IsVisible="{Binding Truncated}"
                           Text="{StaticResource str.PropertySearch.ForcedCapped}"
                           ToolTip.Tip="{StaticResource str.Tip.PropertySearch.ForcedCapped}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Results DataGrid -->
    <DataGrid x:Name="ResultsGrid"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedResult}"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              Background="#1E1E1E"
              Foreground="#D4D4D4"
              FontSize="12"
              FontFamily="Consolas, Menlo, monospace">
      <DataGrid.ContextMenu>
        <ContextMenu x:DataType="vm:PropertySearchViewModel">
          <MenuItem Header="{StaticResource str.Xref.FindFunctions}"
                    Command="{Binding FindFieldXrefsCommand}"
                    CommandParameter="{Binding SelectedResult}"/>
          <MenuItem Header="{StaticResource str.Pivot.ThisProperty}"
                    Command="{Binding PivotThisCommand}"
                    CommandParameter="{Binding SelectedResult}"
                    IsVisible="{Binding PivotEnabled}"/>
          <!-- Force field (Solide) — hold the field across live instances.
               Gated behind the shared Experimental toggle (combat-affecting writes). -->
          <Separator IsVisible="{Binding ForceEnabled}"/>
          <!-- B36: without FallbackValue the child IsVisible bindings resolve to
               nothing when SelectedResult is null and Avalonia treats that as VISIBLE, so
               right-clicking an unselected row showed Force ON + OFF + ->null + value...
               together. ApplyResultFilter nulls SelectedResult on every search AND every
               filter change, and the DataGrid only updates selection on left-press, so
               "nothing selected" is the common state, not an edge one. The submenu itself
               is gated on CanForceAny, which the model already exposed and nothing used. -->
          <MenuItem Header="{StaticResource str.PropertySearch.ForceMenu}"
                    IsVisible="{Binding ForceMenuVisible}">
            <MenuItem Header="{StaticResource str.PropertySearch.ForceOn}"
                      Command="{Binding ForceBoolOnCommand}"
                      CommandParameter="{Binding SelectedResult}"
                      IsVisible="{Binding SelectedResult.CanForceBool, FallbackValue=False}"/>
            <MenuItem Header="{StaticResource str.PropertySearch.ForceOff}"
                      Command="{Binding ForceBoolOffCommand}"
                      CommandParameter="{Binding SelectedResult}"
                      IsVisible="{Binding SelectedResult.CanForceBool, FallbackValue=False}"/>
            <MenuItem Header="{StaticResource str.PropertySearch.ForceNull}"
                      Command="{Binding ForceNullCommand}"
                      CommandParameter="{Binding SelectedResult}"
                      IsVisible="{Binding SelectedResult.CanForceNull, FallbackValue=False}"/>
            <MenuItem Header="{StaticResource str.PropertySearch.ForceValue}"
                      Command="{Binding ForceNumericCommand}"
                      CommandParameter="{Binding SelectedResult}"
                      IsVisible="{Binding SelectedResult.CanForceNumeric, FallbackValue=False}"/>
          </MenuItem>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Class"
                            Binding="{Binding ClassName}"
                            SortMemberPath="ClassName"
                            Width="200"/>
        <!-- Inheritance badge: '+N inheritors' when the field is shared
             across N subclasses. Empty when the property is unique to
             this class (a strong hint that it's a game-specific addition
             rather than an engine-inherited field). Tooltip explains
             the relationship + shows the defining class path. -->
        <DataGridTemplateColumn Header="Scope" Width="120" SortMemberPath="InheritedByCount" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PropertySearchMatch">
              <TextBlock Text="{Binding InheritanceBadge}"
                         Foreground="#888"
                         FontSize="11"
                         FontStyle="Italic"
                         VerticalAlignment="Center"
                         Margin="4,0"
                         ToolTip.Tip="{Binding InheritanceTooltip}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Super"
                            Binding="{Binding SuperName}"
                            SortMemberPath="SuperName"
                            Width="120"/>
        <!-- Property column: for a normal field this is the plain name; for a
             deep (nested) match it's a synthetic dotted path
             (e.g. SaveSlotList[].MsTuneData.GP). The tooltip explains the path
             is a drill route, not a directly-addressable field. -->
        <DataGridTemplateColumn Header="Property" Width="220" SortMemberPath="PropName" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PropertySearchMatch">
              <TextBlock Text="{Binding PropName}"
                         VerticalAlignment="Center"
                         Margin="4,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding PropNameTooltip}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Type"
                            Binding="{Binding TypeDisplay}"
                            SortMemberPath="TypeDisplay"
                            Width="200"/>
        <DataGridTextColumn Header="Offset"
                            Binding="{Binding OffsetHex}"
                            SortMemberPath="PropOffset"
                            CanUserSort="True"
                            Width="80"/>
        <DataGridTextColumn Header="Size"
                            Binding="{Binding PropSize}"
                            SortMemberPath="PropSize"
                            Width="50"/>
        <DataGridTemplateColumn Header="Preview" Width="200" SortMemberPath="Preview" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PropertySearchMatch">
              <TextBlock Text="{Binding Preview}"
                         Foreground="#E5C07B"
                         VerticalAlignment="Center"
                         Margin="4,0"
                         TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.Common.FuncsCol}" Width="190" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PropertySearchMatch">
              <TextBlock Text="{Binding XrefInfo}"
                         Foreground="#C586C0"
                         VerticalAlignment="Center" Margin="4,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding XrefInfo}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="m:PropertySearchMatch">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{StaticResource str.Xref.FindFuncsButton}"
                        Command="{Binding $parent[UserControl].((vm:PropertySearchViewModel)DataContext).FindFieldXrefsCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Xref.FindFunctions}"
                        Foreground="#C586C0" Background="Transparent"
                        BorderThickness="1" BorderBrush="#C586C0"
                        Padding="6,2" FontSize="11" Cursor="Hand"/>
                <Button Content="{StaticResource str.PropertySearch.FindInstances}"
                        Command="{Binding $parent[UserControl].((vm:PropertySearchViewModel)DataContext).FindInstancesCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{StaticResource str.Tip.PropertySearch.FindInstances}"
                        Padding="6,2" FontSize="11"/>
                <!-- Copy Offset + Freeze are hidden for nested (deep) matches:
                     a dotted path has no single class-absolute offset, so
                     neither action applies. finder + Find Funcs stay visible. -->
                <Button Content="{StaticResource str.PropertySearch.CopyOffset}"
                        Command="{Binding $parent[UserControl].((vm:PropertySearchViewModel)DataContext).CopyOffsetCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding ShowScalarActions}"
                        ToolTip.Tip="{StaticResource str.Tip.PropertySearch.CopyOffset}"
                        Padding="6,2" FontSize="11"/>
                <!-- Freeze button: enabled only when AOBMaker plugin is reachable.
                     Tooltip swaps between the action description and the
                     setup hint via FreezeUnavailableTooltip (matches the
                     LiveWalker AobMakerNote pattern from build 608). Hidden
                     entirely for nested matches (no class-absolute offset). -->
                <Button Content="{StaticResource str.PropertySearch.Freeze}"
                        Command="{Binding $parent[UserControl].((vm:PropertySearchViewModel)DataContext).CopyFreezeScriptCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding ShowScalarActions}"
                        IsEnabled="{Binding $parent[UserControl].((vm:PropertySearchViewModel)DataContext).IsAobMakerAvailable}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:PropertySearchViewModel)DataContext).FreezeUnavailableTooltip}"
                        Padding="6,2" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
