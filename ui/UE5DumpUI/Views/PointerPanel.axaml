<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:views="using:UE5DumpUI.Views"
             xmlns:models="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.PointerPanel"
             x:DataType="vm:PointerPanelViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="16" Spacing="16">
    <!-- Failure surface — see the note in LiveWalkerPanel.axaml (audit #5 V7).
         First in the StackPanel so it is visible with or without HasData: a
         failed pointer refresh leaves the cards showing the PREVIOUS scan. -->
    <TextBlock Text="{Binding ErrorMessage}"
               Foreground="#F48771" FontSize="12.5" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- "Register symbol" success. Its FAILURE goes to ErrorMessage above; before
         audit #5 V11 neither state was bound at all and the bool only picked a log
         level, so a symbol CE never created looked exactly like one it did. -->
    <TextBlock Text="{Binding SymbolStatusText}"
               Foreground="#4EC9B0" FontSize="12.5" TextWrapping="Wrap"
               IsVisible="{Binding SymbolStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Not connected message -->
    <TextBlock Text="{StaticResource str.Pointers.NotConnected}"
               Foreground="#666" FontSize="14"
               IsVisible="{Binding !HasData}"
               HorizontalAlignment="Center" Margin="0,40,0,0"/>

    <!-- Pointer info cards -->
    <StackPanel Spacing="12" IsVisible="{Binding HasData}">

      <!-- UE Version -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{StaticResource str.Pointers.UEVersion}"
                         Foreground="#888" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding UeVersion}" FontSize="20"
                           Foreground="#4EC9B0" FontWeight="SemiBold"/>
                <!-- Detected (high confidence) — quiet green tick -->
                <TextBlock Text="{StaticResource str.Pointers.VersionDetectedBadge}"
                           Foreground="#7EC97A" FontSize="11" VerticalAlignment="Center"
                           IsVisible="{Binding ShowVersionDetectedBadge}"/>
                <!-- User Override — blue wrench badge -->
                <TextBlock Text="{StaticResource str.Pointers.VersionUserOverrideBadge}"
                           Foreground="#569CD6" FontSize="11" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           IsVisible="{Binding ShowUserOverrideBadge}"
                           ToolTip.Tip="{StaticResource str.Pointers.VersionUserOverrideTooltip}"/>
                <!-- Low confidence — amber warning -->
                <TextBlock Text="{StaticResource str.Pointers.VersionLowConfidenceBadge}"
                           Foreground="#E6A817" FontSize="11" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           IsVisible="{Binding ShowLowConfidenceWarning}"/>
              </StackPanel>
            </StackPanel>
            <!-- Override ComboBox — to the right of the version number -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{StaticResource str.Pointers.VersionOverrideLabel}"
                         Foreground="#888" FontSize="10"/>
              <ComboBox ItemsSource="{Binding UeVersionOverrideOptions}"
                        SelectedItem="{Binding SelectedUeVersionOverride, Mode=TwoWay}"
                        IsEnabled="{Binding !IsApplyingOverride}"
                        MinWidth="120" FontSize="11" Padding="6,2"
                        ToolTip.Tip="{StaticResource str.Pointers.VersionOverrideTooltip}"/>
            </StackPanel>
          </Grid>
          <!-- Warning text body — only shown for low-confidence path -->
          <TextBlock Text="{StaticResource str.Pointers.VersionLowConfidenceText}"
                     Foreground="#E6A817" FontSize="11" TextWrapping="Wrap"
                     Margin="0,6,0,0"
                     IsVisible="{Binding ShowLowConfidenceWarning}"/>
          <!-- Publisher hint (Square Enix detected, etc.) -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                      IsVisible="{Binding ShowPublisherHint}">
            <TextBlock Text="{StaticResource str.Pointers.PublisherLabel}"
                       Foreground="#888" FontSize="10"/>
            <TextBlock Text="{Binding PublisherLabel}"
                       Foreground="#C586C0" FontSize="10" FontWeight="SemiBold"/>
          </StackPanel>
          <!-- Engine older than UE 4.11: the scan was SKIPPED, not failed. Red rather than
               amber, because unlike every other warning here there is nothing the user can
               tune to make it work — the only actionable path is "the detection is wrong,
               set an override". -->
          <Border Background="#3A2226" BorderBrush="#E05252" BorderThickness="1"
                  CornerRadius="4" Padding="10,8" Margin="0,6,0,0"
                  IsVisible="{Binding ShowVersionTooOldWarning}">
            <TextBlock Text="{StaticResource str.Pointers.VersionTooOld}"
                       Foreground="#E88" FontSize="11" TextWrapping="Wrap"/>
          </Border>
          <!-- Pre-UE4 (UE3) positively identified. Mutually exclusive with the banner above:
               both are driven by IsVersionTooOld and split on the sentinel version, because the
               two refusals have different reasons AND different remedies. -->
          <Border Background="#3A2226" BorderBrush="#E05252" BorderThickness="1"
                  CornerRadius="4" Padding="10,8" Margin="0,6,0,0"
                  IsVisible="{Binding ShowPreUE4Warning}">
            <TextBlock Text="{StaticResource str.Pointers.EnginePreUE4}"
                       Foreground="#E88" FontSize="11" TextWrapping="Wrap"/>
          </Border>

          <!-- Dynamic offsets not fully MEASURED. Amber, not red: unlike the two refusals
               above the dumper still works, but every value it shows and every export it
               writes is derived from at least one UE-version guess. The text is built in the
               VM because it names WHICH probe fell back. (audit #5 U3/X3) -->
          <Border Background="#3A3323" BorderBrush="#E6A817" BorderThickness="1"
                  CornerRadius="4" Padding="10,8" Margin="0,6,0,0"
                  IsVisible="{Binding ShowOffsetsUnvalidatedWarning}">
            <TextBlock Text="{Binding OffsetsUnvalidatedText}"
                       Foreground="#E6C877" FontSize="11" TextWrapping="Wrap"/>
          </Border>

          <!-- Legacy "version not detected" warning, kept for backward compat -->
          <TextBlock Text="{StaticResource str.Pointers.VersionWarning}"
                     Foreground="#E6A817" FontSize="11" TextWrapping="Wrap"
                     Margin="0,4,0,0"
                     IsVisible="{Binding ShowVersionWarning}"/>

          <!-- Invoke timeout: per-game override for GameThreadDispatch UFunction wait. -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Grid.Column="0"
                       Text="{StaticResource str.Pointers.InvokeTimeoutLabel}"
                       Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding InvokeTimeoutMsValue, Mode=TwoWay}"
                           Minimum="1000" Maximum="60000" ClipValueToMinMax="True" Increment="1000"
                           FormatString="0"
                           IsEnabled="{Binding !IsApplyingInvokeTimeout}"
                           MinWidth="110" Margin="6,0,0,0"
                           ToolTip.Tip="{StaticResource str.Pointers.InvokeTimeoutTooltip}"/>
            <TextBlock Grid.Column="3"
                       Text="{StaticResource str.Pointers.InvokeTimeoutOverrideBadge}"
                       Foreground="#569CD6" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowInvokeTimeoutOverrideBadge}"
                       ToolTip.Tip="{StaticResource str.Pointers.InvokeTimeoutOverrideTooltip}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- GObjects -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.GObjects}"
                       Foreground="#888" FontSize="12"/>
            <TextBlock Text="{Binding GObjectsAddress}" FontSize="16"
                       Foreground="#569CD6" FontFamily="Consolas"/>
            <TextBlock Text="{Binding GObjectsPatternId}" FontSize="10"
                       Foreground="#666" FontFamily="Consolas" Margin="0,2,0,0"
                       IsVisible="{Binding HasGObjectsPatternId}"
                       ToolTip.Tip="{StaticResource str.Pointers.PatternIdTooltip}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                        IsVisible="{Binding HasGObjectsScanAddr}">
              <TextBlock Text="{StaticResource str.Pointers.AobLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Text="{Binding GObjectsScanAddr}" FontSize="10"
                         Foreground="#E5C07B" FontFamily="Consolas"/>
              <Button Content="{StaticResource str.Pointers.AobMakerAsm}"
                      Command="{Binding AsmGObjectsScanCommand}"
                      IsEnabled="{Binding CanAsmGObjectsScan}"
                      ToolTip.Tip="{StaticResource str.Pointers.AobMakerScanAsmTip}"
                      Padding="4,1" FontSize="9" FontFamily="Consolas"
                      Foreground="#E5C07B" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
              <Button Content="{StaticResource str.Pointers.CopyScanAddr}" Command="{Binding CopyGObjectsScanAddrCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.Pointers.CopyScan}"
                      Padding="4,1" FontSize="9" Foreground="#AAA" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.AobAllFailed}"
                       Foreground="#E05252" FontSize="11" Margin="0,3,0,0"
                       IsVisible="{Binding GObjectsAobAllFailed}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0"
                        IsVisible="{Binding ShowGObjectsWarning}">
              <TextBlock Text="{StaticResource str.Pointers.AobFailed}"
                         Foreground="#E6A817" FontSize="11"/>
              <TextBlock Text="{Binding GObjectsMethodLabel}"
                         Foreground="#E6A817" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                    Command="{Binding HexGObjectsCommand}"
                    IsEnabled="{Binding CanHexGObjects}"
                    ToolTip.Tip="{StaticResource str.Pointers.AobMakerHexTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#569CD6" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.Copy}"
                    Command="{Binding CopyGObjectsCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.Copy}"
                    Padding="8,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- GNames -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.GNames}"
                       Foreground="#888" FontSize="12"/>
            <TextBlock Text="{Binding GNamesAddress}" FontSize="16"
                       Foreground="#569CD6" FontFamily="Consolas"/>
            <TextBlock Text="{Binding GNamesPatternId}" FontSize="10"
                       Foreground="#666" FontFamily="Consolas" Margin="0,2,0,0"
                       IsVisible="{Binding HasGNamesPatternId}"
                       ToolTip.Tip="{StaticResource str.Pointers.PatternIdTooltip}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                        IsVisible="{Binding HasGNamesScanAddr}">
              <TextBlock Text="{StaticResource str.Pointers.AobLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Text="{Binding GNamesScanAddr}" FontSize="10"
                         Foreground="#E5C07B" FontFamily="Consolas"/>
              <Button Content="{StaticResource str.Pointers.AobMakerAsm}"
                      Command="{Binding AsmGNamesScanCommand}"
                      IsEnabled="{Binding CanAsmGNamesScan}"
                      ToolTip.Tip="{StaticResource str.Pointers.AobMakerScanAsmTip}"
                      Padding="4,1" FontSize="9" FontFamily="Consolas"
                      Foreground="#E5C07B" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
              <Button Content="{StaticResource str.Pointers.CopyScanAddr}" Command="{Binding CopyGNamesScanAddrCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.Pointers.CopyScan}"
                      Padding="4,1" FontSize="9" Foreground="#AAA" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.AobAllFailed}"
                       Foreground="#E05252" FontSize="11" Margin="0,3,0,0"
                       IsVisible="{Binding GNamesAobAllFailed}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0"
                        IsVisible="{Binding ShowGNamesWarning}">
              <TextBlock Text="{StaticResource str.Pointers.AobFailed}"
                         Foreground="#E6A817" FontSize="11"/>
              <TextBlock Text="{Binding GNamesMethodLabel}"
                         Foreground="#E6A817" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                    Command="{Binding HexGNamesCommand}"
                    IsEnabled="{Binding CanHexGNames}"
                    ToolTip.Tip="{StaticResource str.Pointers.AobMakerHexTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#569CD6" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.Copy}"
                    Command="{Binding CopyGNamesCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.Copy}"
                    Padding="8,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- GWorld -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.GWorld}"
                       Foreground="#888" FontSize="12"/>
            <TextBlock Text="{Binding GWorldAddress}" FontSize="16"
                       Foreground="#569CD6" FontFamily="Consolas"/>
            <TextBlock Text="{Binding GWorldPatternId}" FontSize="10"
                       Foreground="#666" FontFamily="Consolas" Margin="0,2,0,0"
                       IsVisible="{Binding HasGWorldPatternId}"
                       ToolTip.Tip="{StaticResource str.Pointers.PatternIdTooltip}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                        IsVisible="{Binding HasGWorldScanAddr}">
              <TextBlock Text="{StaticResource str.Pointers.AobLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Text="{Binding GWorldScanAddr}" FontSize="10"
                         Foreground="#E5C07B" FontFamily="Consolas"/>
              <Button Content="{StaticResource str.Pointers.AobMakerAsm}"
                      Command="{Binding AsmGWorldScanCommand}"
                      IsEnabled="{Binding CanAsmGWorldScan}"
                      ToolTip.Tip="{StaticResource str.Pointers.AobMakerScanAsmTip}"
                      Padding="4,1" FontSize="9" FontFamily="Consolas"
                      Foreground="#E5C07B" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
              <Button Content="{StaticResource str.Pointers.CopyScanAddr}" Command="{Binding CopyGWorldScanAddrCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.Pointers.CopyScan}"
                      Padding="4,1" FontSize="9" Foreground="#AAA" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.AobAllFailed}"
                       Foreground="#E05252" FontSize="11" Margin="0,3,0,0"
                       IsVisible="{Binding GWorldAobAllFailed}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0"
                        IsVisible="{Binding ShowGWorldRecovered}">
              <TextBlock Text="{StaticResource str.Pointers.AobFailed}"
                         Foreground="#E6A817" FontSize="11"/>
              <TextBlock Text="{Binding GWorldMethodLabel}"
                         Foreground="#E6A817" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.GWorldNotFound}"
                       Foreground="#888" FontSize="11" Margin="0,3,0,0"
                       IsVisible="{Binding ShowGWorldWarning}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Content="{StaticResource str.Pointers.RegisterSymbol}"
                    Command="{Binding RegisterGWorldSymbolCommand}"
                    IsEnabled="{Binding CanRegisterGWorldSymbol}"
                    ToolTip.Tip="{StaticResource str.Pointers.RegisterSymbolTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#C586C0" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                    Command="{Binding HexGWorldCommand}"
                    IsEnabled="{Binding CanHexGWorld}"
                    ToolTip.Tip="{StaticResource str.Pointers.AobMakerHexTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#569CD6" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.Copy}"
                    Command="{Binding CopyGWorldCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.Copy}"
                    Padding="8,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- FSparseDelegateStorage::SparseDelegates (Optional, UE 4.23+ — matches IsSparseDelegatesUnsupported's < 423 gate) -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.SparseDelegates}"
                       Foreground="#888" FontSize="12"/>
            <TextBlock Text="{Binding SparseDelegatesAddress}" FontSize="16"
                       Foreground="#569CD6" FontFamily="Consolas"
                       IsVisible="{Binding IsSparseDelegatesFound}"/>
            <TextBlock Text="{Binding SparseDelegatesPatternId}" FontSize="10"
                       Foreground="#666" FontFamily="Consolas" Margin="0,2,0,0"
                       IsVisible="{Binding HasSparseDelegatesPatternId}"
                       ToolTip.Tip="{StaticResource str.Pointers.PatternIdTooltip}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                        IsVisible="{Binding HasSparseDelegatesScanAddr}">
              <TextBlock Text="{StaticResource str.Pointers.AobLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Text="{Binding SparseDelegatesScanAddr}" FontSize="10"
                         Foreground="#E5C07B" FontFamily="Consolas"/>
              <Button Content="{StaticResource str.Pointers.CopyScanAddr}"
                      Command="{Binding CopySparseDelegatesScanAddrCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.Pointers.CopyScan}"
                      Padding="4,1" FontSize="9" Foreground="#AAA" Background="Transparent"
                      BorderThickness="1" BorderBrush="#555" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.SparseDelegatesOptional}"
                       Foreground="#666" FontSize="10" Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{StaticResource str.Pointers.SparseDelegatesNotFound}"
                       Foreground="#E5C07B" FontSize="11" Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsSparseDelegatesNotFound}"/>
            <TextBlock Text="{StaticResource str.Pointers.SparseDelegatesUnsupported}"
                       Foreground="#888" FontSize="11" Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsSparseDelegatesUnsupported}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                    Command="{Binding HexSparseDelegatesCommand}"
                    IsEnabled="{Binding CanHexSparseDelegates}"
                    ToolTip.Tip="{StaticResource str.Pointers.AobMakerHexTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#569CD6" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.Copy}"
                    Command="{Binding CopySparseDelegatesCommand}"
                    IsEnabled="{Binding IsSparseDelegatesFound}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.Copy}"
                    Padding="8,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- &GEngine (Optional) — the static slot, not the UEngine object -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.GEngine}"
                       Foreground="#888" FontSize="12"/>
            <TextBlock Text="{Binding GEngineAddress}" FontSize="16"
                       Foreground="#569CD6" FontFamily="Consolas"
                       IsVisible="{Binding IsGEngineFound}"/>
            <TextBlock Text="{Binding GEnginePatternId}" FontSize="10"
                       Foreground="#666" FontFamily="Consolas" Margin="0,2,0,0"
                       IsVisible="{Binding HasGEnginePatternId}"
                       ToolTip.Tip="{StaticResource str.Pointers.PatternIdTooltip}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                        IsVisible="{Binding HasGEngineScanAddr}">
              <TextBlock Text="{StaticResource str.Pointers.AobLabel}" Foreground="#888" FontSize="10"/>
              <TextBlock Text="{Binding GEngineScanAddr}" FontSize="10"
                         Foreground="#E5C07B" FontFamily="Consolas"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.Pointers.GEngineOptional}"
                       Foreground="#666" FontSize="10" Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{StaticResource str.Pointers.GEngineNotFound}"
                       Foreground="#888" FontSize="11" Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsGEngineNotFound}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Content="{StaticResource str.Pointers.RegisterSymbol}"
                    Command="{Binding RegisterGEngineSymbolCommand}"
                    IsEnabled="{Binding CanRegisterGEngineSymbol}"
                    ToolTip.Tip="{StaticResource str.Pointers.RegisterGEngineSymbolTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#C586C0" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.AobMakerHex}"
                    Command="{Binding HexGEngineCommand}"
                    IsEnabled="{Binding CanHexGEngine}"
                    ToolTip.Tip="{StaticResource str.Pointers.AobMakerHexTip}"
                    Padding="6,4" FontSize="11" FontFamily="Consolas"
                    Foreground="#569CD6" Background="Transparent"
                    BorderThickness="1" BorderBrush="#555"/>
            <Button Content="{StaticResource str.Pointers.Copy}"
                    Command="{Binding CopyGEngineCommand}"
                    IsEnabled="{Binding IsGEngineFound}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.Copy}"
                    Padding="8,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Total Objects -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12">
        <StackPanel>
          <TextBlock Text="{StaticResource str.Pointers.TotalObjects}"
                     Foreground="#888" FontSize="12"/>
          <TextBlock Text="{Binding TotalObjects}" FontSize="20"
                     Foreground="#B5CEA8" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <!-- Extra Scan — visible only when some pointers are missing -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
              IsVisible="{Binding CanExtraScan}">
        <StackPanel Spacing="8">
          <TextBlock Text="{StaticResource str.Pointers.ExtraScanHint}"
                     Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.Pointers.ExtraScan}"
                    Command="{Binding ExtraScanCommand}"
                    IsEnabled="{Binding !IsScanning}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.ExtraScan}"
                    Padding="12,6"/>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsScanning}" Orientation="Horizontal" Spacing="8">
            <ProgressBar IsIndeterminate="True" Width="120" Height="8"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ScanStatusText}" Foreground="#4EC9B0"
                       FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding ScanResultText}" Foreground="#4EC9B0"
                     FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding ScanComplete}"/>
        </StackPanel>
      </Border>

      <!-- Test Extra Scan — always visible for development testing -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
              BorderBrush="#555" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Text="{StaticResource str.Pointers.TestExtraScanHint}"
                     Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
          <Button Content="{StaticResource str.Pointers.TestExtraScan}"
                  Command="{Binding TestExtraScanCommand}"
                  IsEnabled="{Binding !IsScanning}"
                  ToolTip.Tip="{StaticResource str.Tip.Pointers.TestExtraScan}"
                  Padding="8,4" FontSize="11" Foreground="#AAA"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"/>
          <StackPanel IsVisible="{Binding IsScanning}" Orientation="Horizontal" Spacing="8">
            <ProgressBar IsIndeterminate="True" Width="100" Height="6"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ScanStatusText}" Foreground="#888"
                       FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Cache Management — visible when connected and AobUsageService is available -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
              BorderBrush="#555" BorderThickness="1"
              IsVisible="{Binding CanManageCache}">
        <StackPanel Spacing="6">
          <TextBlock Text="{StaticResource str.Pointers.CacheHint}"
                     Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.Pointers.ClearGameCache}"
                    Command="{Binding ClearGameCacheCommand}"
                    IsEnabled="{Binding CanClearGameCache}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.ClearGameCache}"
                    Padding="8,4" FontSize="11" Foreground="#E6A817"
                    Background="Transparent" BorderThickness="1" BorderBrush="#555"
                    Cursor="Hand"/>
            <Button Content="{StaticResource str.Pointers.ResetAllCache}"
                    Command="{Binding ResetAllCacheCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.Pointers.ResetAllCache}"
                    Padding="8,4" FontSize="11" Foreground="#E05252"
                    Background="Transparent" BorderThickness="1" BorderBrush="#555"
                    Cursor="Hand"/>
          </StackPanel>
          <TextBlock Text="{Binding CacheStatusText}" Foreground="#4EC9B0"
                     FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding CacheStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <!-- Diagnostics section: build version comparison + AOBMaker status + Self-Test -->
      <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
              BorderBrush="#555" BorderThickness="1"
              IsVisible="{Binding HasData}">
        <StackPanel Spacing="10">
          <TextBlock Text="{StaticResource str.System.Header}"
                     Foreground="#9CDCFE" FontSize="13" FontWeight="SemiBold"/>

          <!-- Build version row: UI vs DLL -->
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="{StaticResource str.System.UiBuild}"
                       Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding UiBuildNumber}"
                       Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12"
                       VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="120,Auto,*">
            <TextBlock Grid.Column="0" Text="{StaticResource str.System.DllBuild}"
                       Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding DllBuildNumber}"
                       Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" Text="{StaticResource str.System.BuildMatch}"
                       Foreground="#4EC9B0" FontSize="11" VerticalAlignment="Center"
                       IsVisible="{Binding BuildVersionsMatch}"/>
            <TextBlock Grid.Column="2" Text="{StaticResource str.System.BuildMismatch}"
                       Foreground="#E6A817" FontSize="11" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BuildVersionMismatch}"/>
            <TextBlock Grid.Column="2" Text="{StaticResource str.System.BuildUnknown}"
                       Foreground="#E6A817" FontSize="11" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BuildVersionUnknown}"/>
          </Grid>

          <!-- AOBMaker plugin status -->
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="{StaticResource str.System.AobMakerStatus}"
                       Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{StaticResource str.System.AobMakerConnected}"
                       Foreground="#4EC9B0" FontSize="12" VerticalAlignment="Center"
                       IsVisible="{Binding IsAobMakerAvailable}"/>
            <TextBlock Grid.Column="1" Text="{StaticResource str.System.AobMakerOffline}"
                       Foreground="#888" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap">
              <TextBlock.IsVisible>
                <Binding Path="IsAobMakerAvailable" Converter="{x:Static BoolConverters.Not}"/>
              </TextBlock.IsVisible>
            </TextBlock>
          </Grid>

          <!-- Self-Test: button + hint + result line (color-coded by pass/fail) -->
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Content="{StaticResource str.System.SelfTest.Button}"
                      Command="{Binding SelfTestCommand}"
                      IsEnabled="{Binding CanSelfTest}"
                      Padding="10,5" FontSize="12" Foreground="#9CDCFE"
                      Background="Transparent" BorderThickness="1" BorderBrush="#555"
                      Cursor="Hand"/>
              <TextBlock Text="..." Foreground="#888" FontSize="11"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsSelfTesting}"/>
            </StackPanel>
            <TextBlock Text="{StaticResource str.System.SelfTest.Hint}"
                       Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
            <!-- Pass (green) and fail (red) variants — switching by IsVisible
                 avoids needing a multi-binding color converter. Both bind the
                 same SelfTestResultText, only one is visible at a time. -->
            <TextBlock Text="{Binding SelfTestResultText}"
                       Foreground="#4EC9B0" FontSize="11"
                       TextWrapping="Wrap" FontFamily="Consolas"
                       IsVisible="{Binding SelfTestPassed}"/>
            <TextBlock Text="{Binding SelfTestResultText}"
                       Foreground="#E05252" FontSize="11"
                       TextWrapping="Wrap" FontFamily="Consolas"
                       IsVisible="{Binding SelfTestFailed}"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- Maintenance: always-visible (no live connection needed) so it sits OUTSIDE
         the HasData card stack. Open Log Folder is always shown; Remove All Snapshot
         Data is gated on the experimental opt-in (it wipes the snapshot DB files). -->
    <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
            BorderBrush="#555" BorderThickness="1" Margin="0,0,0,4">
      <StackPanel Spacing="8">
        <TextBlock Text="{StaticResource str.System.Maintenance.Header}"
                   Foreground="#9CDCFE" FontSize="13" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{StaticResource str.System.OpenLogFolder}"
                  Command="{Binding OpenLogFolderCommand}"
                  ToolTip.Tip="{StaticResource str.System.OpenLogFolderTip}"
                  Padding="8,4" FontSize="11" Foreground="#AAA"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand"/>
          <Button Content="{StaticResource str.System.CompressLogs}"
                  Command="{Binding CompressLogsCommand}"
                  IsVisible="{Binding LogCompressionSupported}"
                  IsEnabled="{Binding !IsCompressingLogs}"
                  ToolTip.Tip="{StaticResource str.System.CompressLogsTip}"
                  Padding="8,4" FontSize="11" Foreground="#AAA"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand"/>
          <Button Content="{StaticResource str.System.RemoveAllSnapshots}"
                  Command="{Binding RemoveAllSnapshotsCommand}"
                  IsVisible="{Binding ExperimentalEnabled}"
                  ToolTip.Tip="{StaticResource str.System.RemoveAllSnapshotsTip}"
                  Padding="8,4" FontSize="11" Foreground="#E05252"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand"/>
        </StackPanel>
        <CheckBox Content="{StaticResource str.System.AutoCompressLogs}"
                  IsChecked="{Binding AutoCompressLogs}"
                  IsVisible="{Binding LogCompressionSupported}"
                  ToolTip.Tip="{StaticResource str.System.AutoCompressLogsTip}"
                  Foreground="#AAA" FontSize="11"/>
        <TextBlock Text="{Binding MaintenanceStatusText}" Foreground="#4EC9B0"
                   FontSize="11" TextWrapping="Wrap"
                   IsVisible="{Binding MaintenanceStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <!-- Diagnostics: what the pipe traffic COSTS. Sits immediately above Pipe
         Activity, which shows what crossed the pipe — same concern, two halves.
         Exists to settle multipipe-eval.md's open question: is DLL-side
         serial-dispatch head-of-line blocking actually what makes the UI lag?
         "Dispatcher busy" plus the per-command ranking is that evidence. -->
    <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
            BorderBrush="#555" BorderThickness="1" Margin="0,0,0,4">
      <StackPanel Spacing="8">
        <TextBlock Text="{StaticResource str.System.Diag.Header}"
                   Foreground="#9CDCFE" FontSize="13" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{StaticResource str.System.Diag.Refresh}"
                  Command="{Binding RefreshDiagnosticsCommand}"
                  IsEnabled="{Binding !DiagBusy}"
                  ToolTip.Tip="{StaticResource str.System.Diag.RefreshTip}"
                  Padding="8,4" FontSize="11" Foreground="#AAA"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand"/>
          <Button Content="{StaticResource str.System.Diag.Reset}"
                  Command="{Binding ResetDiagnosticsCommand}"
                  IsEnabled="{Binding !DiagBusy}"
                  ToolTip.Tip="{StaticResource str.System.Diag.ResetTip}"
                  Padding="8,4" FontSize="11" Foreground="#AAA"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand"/>
          <CheckBox Content="{StaticResource str.System.Diag.Auto}"
                    IsChecked="{Binding DiagAutoRefresh, Mode=TwoWay}"
                    ToolTip.Tip="{StaticResource str.System.Diag.AutoTip}"
                    Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <TextBlock Text="{Binding DiagSummary}" Foreground="#D4D4D4" FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding DiagSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding DiagProcess}" Foreground="#AAA" FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding DiagProcess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding DiagGameThread}" Foreground="#AAA" FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding DiagGameThread, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- CanUserResizeColumns is set EXPLICITLY: the numeric columns were sized
             to their content and clipped their own headers ("Cou", "% bu"), with no
             way to widen them. Sorting stays OFF here on purpose — Avalonia's
             DataGrid sort is reflection-based (an AOT hazard, see
             ui-avalonia12-pinvoke-gotchas) and the rows already arrive ranked by
             total time, which is the ordering that answers the question. Turning it
             off also reclaims the header space the sort glyph was reserving, which
             is part of why the headers fit now.
             MinWidth keeps a dragged column from collapsing to nothing. -->
        <DataGrid ItemsSource="{Binding DiagCommands}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MaxHeight="220" FontSize="11"
                  IsVisible="{Binding DiagCommands.Count}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Command" Binding="{Binding Cmd}" Width="*" MinWidth="120"/>
            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80" MinWidth="50"/>
            <DataGridTextColumn Header="Total ms" Binding="{Binding TotalMs}" Width="95" MinWidth="50"/>
            <DataGridTextColumn Header="Avg ms" Binding="{Binding AvgMs, StringFormat='{}{0:N1}'}" Width="90" MinWidth="50"/>
            <DataGridTextColumn Header="Max ms" Binding="{Binding MaxMs}" Width="90" MinWidth="50"/>
            <DataGridTextColumn Header="% busy" Binding="{Binding SharePercent, StringFormat='{}{0:N1}'}" Width="85" MinWidth="50"/>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="{Binding DiagStatus}" Foreground="#E05252" FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding DiagStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <!-- Pipe Activity: live tail of UI<->DLL pipe traffic (newest first). A
         convenience mirror of the pipe log file so the user can watch light
         commands stay responsive while a heavy scan runs (Phase 1 lane split)
         without opening %LOCALAPPDATA% logs. Always visible (no live connection
         needed); fed from PipeClient.Activity via a coalesced UI-thread flush. -->
    <Border Background="#2D2D30" CornerRadius="4" Padding="16,12"
            BorderBrush="#555" BorderThickness="1" Margin="0,0,0,4">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{StaticResource str.System.PipeLog.Header}"
                     Foreground="#9CDCFE" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <CheckBox Grid.Column="1" Content="{StaticResource str.System.PipeLog.Pause}"
                    IsChecked="{Binding PipeLogPaused}"
                    Foreground="#AAA" FontSize="11" Margin="0,0,10,0"
                    VerticalAlignment="Center"/>
          <Button Grid.Column="2" Content="{StaticResource str.System.PipeLog.Clear}"
                  Command="{Binding ClearPipeLogCommand}"
                  Padding="8,4" FontSize="11" Foreground="#AAA"
                  Background="Transparent" BorderThickness="1" BorderBrush="#555"
                  Cursor="Hand"/>
        </Grid>
        <TextBlock Text="{StaticResource str.System.PipeLog.Hint}"
                   Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
        <Border Background="#1E1E1E" CornerRadius="3"
                BorderBrush="#3F3F46" BorderThickness="1" Height="170">
          <Panel>
            <TextBlock Text="{StaticResource str.System.PipeLog.Empty}"
                       Foreground="#555" FontSize="11" Margin="8,6"
                       TextWrapping="Wrap" VerticalAlignment="Top"
                       IsVisible="{Binding PipeLogIsEmpty}"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PipeLog}" Padding="8,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PipeLogEntry">
                    <TextBlock Text="{Binding Display}" FontFamily="Consolas"
                               FontSize="11" Foreground="#C8C8C8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Credit footer + experimental gate. The author/repo credit is a plain
         label + clickable URL link (full opacity). The experimental opt-in is a
         SEPARATE, title-less checkbox beside the author line, kept deliberately
         faint (Opacity 0.2) so it stays low-key; its tooltip states the effect
         (enables the Snapshot / SPC Query / Class Pivot tabs). Always visible on
         the System tab so the attribution doesn't depend on a live DLL connection. -->
    <StackPanel Spacing="3" HorizontalAlignment="Center" Margin="0,8,0,4">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <!-- Bare, faint experimental opt-in checkbox (no label of its own). -->
        <CheckBox IsChecked="{Binding ExperimentalEnabled}"
                  IsEnabled="{Binding CanToggleExperimental}"
                  Opacity="0.1"
                  Padding="0" MinWidth="0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{StaticResource str.Experimental.EnableHint}"/>
        <!-- AOBMaker link: plain label + clickable link, full opacity. -->
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
          <TextBlock Text="{StaticResource str.Credit.AobMakerPrefix}"
                     Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="AobMakerUrlText"
                     Text="{StaticResource str.Credit.AobMakerUrl}"
                     Foreground="#569CD6" FontSize="11" VerticalAlignment="Center"
                     TextDecorations="Underline" Cursor="Hand"
                     PointerPressed="OnUrlPressed"
                     ToolTip.Tip="{StaticResource str.Credit.OpenInBrowserTip}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center">
        <TextBlock Text="{StaticResource str.Credit.RepoPrefix}"
                   Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock x:Name="RepoUrlText"
                   Text="{StaticResource str.Credit.RepoUrl}"
                   Foreground="#569CD6" FontSize="11" VerticalAlignment="Center"
                   TextDecorations="Underline" Cursor="Hand"
                   PointerPressed="OnUrlPressed"
                   ToolTip.Tip="{StaticResource str.Credit.OpenInBrowserTip}"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
