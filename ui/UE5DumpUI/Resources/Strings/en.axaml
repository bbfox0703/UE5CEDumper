    <sys:String x:Key="str.Noise.Reset">Reset ticks</sys:String>
    <sys:String x:Key="str.Noise.RemoveTip">Remove from denylist</sys:String>

    <!-- Client-side class-noise filter (Instance / Interesting Funcs+Props / Property Search) -->
    <sys:String x:Key="str.ClassFilter.Button">Class filter</sys:String>
    <sys:String x:Key="str.Tip.ClassFilter">Group these results by class and hide noise classes (UI widgets, sound, system components) from the list. Hiding is display-only — untick or Clear to restore.</sys:String>
    <sys:String x:Key="str.ClassFilter.Hint">Tick a class to hide its rows from the results below (e.g. UI widgets, sound, system components). This only hides them from view — the underlying data is unchanged. Untick or Clear to restore.</sys:String>
    <sys:String x:Key="str.ClassFilter.Partial">⚠ Counts are partial — the result list was capped, so these are a lower bound.</sys:String>
    <sys:String x:Key="str.ClassFilter.Clear">Clear (show all)</sys:String>
    <sys:String x:Key="str.ClassFilter.AutoDetect">Auto-detect</sys:String>
    <sys:String x:Key="str.Tip.ClassFilter.AutoDetect">Pre-tick classes that are provably engine/system noise — UI widgets, sound, textures, materials, particles, anim instances, or classes in an engine package. Safe by construction (never your gameplay classes); the picks are reversible — untick any you want to keep.</sys:String>

    <!-- Class Pivot: right-click hide + hidden-class chips -->
    <sys:String x:Key="str.Pivot.HideClass">Hide selected class from picker</sys:String>
    <sys:String x:Key="str.Pivot.HiddenHeader">Hidden classes (Pivot only):</sys:String>

    <!-- Class Pivot (experimental) -->
    <sys:String x:Key="str.Pivot.Intro">Group one class's instances by a key field's value (e.g. inventory by ItemID) or by object identity, and project the value fields per group. The best key field is auto-suggested (type + name + cardinality). Differing values inside a group render as a collision ⟨N: v1,v2,+M⟩. Snapshot capture is all-numeric, so keys are int/enum IDs. Tip: for transient inventory objects (whose object path is identical, e.g. //Engine/Transient/Item) use a Field key like ItemID — Identity mode would merge them into one group. Switch Source to Snapshot Array to pivot a captured struct array (e.g. Cargo) by its inner-key value (e.g. ItemID) — reorder- and session-immune. Or DataTable for a zero-config pivot of a live DataTable (RowName is the key — no discovery needed).</sys:String>
    <sys:String x:Key="str.Pivot.SourceHeader">⚙ Pivot target — Source · Snapshot · Class</sys:String>
    <sys:String x:Key="str.Pivot.Source">Source:</sys:String>
    <sys:String x:Key="str.Pivot.Snapshot">Snapshot:</sys:String>
    <sys:String x:Key="str.Pivot.DataTable">DataTable:</sys:String>
    <sys:String x:Key="str.Pivot.ArrayField">Array field:</sys:String>
    <sys:String x:Key="str.Pivot.RefreshDataTables">🔄 Find DataTables</sys:String>
    <sys:String x:Key="str.Pivot.KeyRowName">Key = RowName (zero-config)</sys:String>
    <sys:String x:Key="str.Pivot.KeyInnerKey">Key = inner-key value (reorder-immune)</sys:String>
    <sys:String x:Key="str.Pivot.ThisProperty">Pivot this property…</sys:String>
    <sys:String x:Key="str.Pivot.ClassFilter">Class:</sys:String>
    <sys:String x:Key="str.Pivot.ClassFilterHint">type to filter, then pick…</sys:String>
    <sys:String x:Key="str.Pivot.Run">Run Pivot</sys:String>
    <sys:String x:Key="str.Pivot.OpenWalker">Open in Live Walker</sys:String>
    <sys:String x:Key="str.Pivot.CopyAddr">Copy Address</sys:String>
    <sys:String x:Key="str.Pivot.LocateGWorld">🌍</sys:String>
    <sys:String x:Key="str.Tip.Pivot.LocateGWorld">Locate in GWorld: find the shortest pointer path from GWorld down to the selected group's representative object and show it in Live Walker</sys:String>
    <sys:String x:Key="str.Pivot.LocateGameEngine">⚙</sys:String>
    <sys:String x:Key="str.Tip.Pivot.LocateGameEngine">Locate in GameEngine: shortest pointer path from the live UGameEngine down to the selected group's representative object. Reaches engine-layer objects the GWorld graph can't — for most world actors, use Locate in GWorld.</sys:String>
    <sys:String x:Key="str.Pivot.ResultFilterHint">filter results…</sys:String>
    <sys:String x:Key="str.Pivot.GroupBy">Group by:</sys:String>
    <sys:String x:Key="str.Pivot.KeyField">Key field:</sys:String>
    <sys:String x:Key="str.Pivot.Col.Key">Key</sys:String>
    <sys:String x:Key="str.Pivot.Col.KeyTip">Add this field to the group key (Field mode). The key becomes the tuple of the Key field above + every ticked field, so e.g. (Team · Slot) groups by the combination. A single key = a plain group key.</sys:String>
    <sys:String x:Key="str.Pivot.Col.Project">Value</sys:String>
    <sys:String x:Key="str.Pivot.Col.Field">Field</sys:String>
    <sys:String x:Key="str.Pivot.Col.Type">Type</sys:String>
    <sys:String x:Key="str.Pivot.Col.Distinct">Distinct</sys:String>
    <sys:String x:Key="str.Pivot.Col.Insts">Instances</sys:String>
    <sys:String x:Key="str.Pivot.Col.KeyScore">Key score</sys:String>
    <sys:String x:Key="str.Pivot.ResultsHint">Tick the value fields above to project them; tick Key to build a composite key (e.g. Team · Slot) — Field mode only. Identity mode groups spawn-normalised siblings (BP_Enemy_C_0/_1/…) together. Select a group → Open in Live Walker / Copy Address hands its representative instance to CE.</sys:String>
    <sys:String x:Key="str.Pivot.Res.Count">Count</sys:String>
    <sys:String x:Key="str.Pivot.Res.Key">Key</sys:String>
    <sys:String x:Key="str.Pivot.Res.Values">Projected values</sys:String>

    <!-- Class Pivot: change-driven discovery (the automatic front-door) -->
    <sys:String x:Key="str.Pivot.Discover.Header">🔍 Suggest targets — find what changed</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Intro">Don't know which class to pivot? Capture 2-4 snapshots around an in-game action (e.g. spend gold, take damage), tick them below, and Discover ranks the (class, property) targets that MOVED — by how much each looks like game state (named fields, specific changes, low noise). Pick one and Use → to pivot it. No class/key guessing.</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Pick">Snapshots (tick 2-4, oldest → newest = Before … After):</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Run">🔍 Discover</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Use">Use → (pivot this)</sys:String>
    <!-- Usage limits, shown on the tab so expectations are clear up front. -->
    <sys:String x:Key="str.Pivot.Discover.Limits">How it works &amp; limits:&#10;• Capture 2-4 snapshots around the action you want to isolate (Before … After).&#10;• Use 3-4 to separate a one-time change from constant per-frame noise (rotation, timers, positions); with only 2, both just look "changed".&#10;• Only fields that MOVED appear — a value that never changed between your captures will not show.&#10;• Across a game restart, only objects that re-appear with a stable identity (GameInstance / PlayerState / Pawn / components / GAS) re-join reliably; randomly-spawned actors may not.&#10;• The scan covers the numeric fields captured in the snapshot and runs server-side; on a large capture it can take several seconds (cancellable).</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Class">Class</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Prop">Property</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Changed">Changed</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Dir">Δ</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Cat">Category</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Shape">Shape</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Seq">Sample (oldest → newest)</sys:String>
    <sys:String x:Key="str.Pivot.Discover.Col.Score">Score</sys:String>

    <!-- Proxy Deploy -->
    <sys:String x:Key="str.ProxyDeploy.ProxyType">Proxy DLL:</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Type.Version">version.dll</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Type.Dinput8">dinput8.dll</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Type.Dxgi">dxgi.dll</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Type.Winmm">winmm.dll</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Scan">Scan Steam</sys:String>
    <sys:String x:Key="str.ProxyDeploy.RouteOrder">How the DLL gets into the game — best route first:  ① Deploy a proxy DLL (below) — loads with the game, survives restarts, no Cheat Engine involved.  ② Inject into a running game (button above) — nothing to install, but repeat every launch.  ③ Working in Cheat Engine? Tools ▸ Install CE autorun Helper gives every table an ue5_inject(), permanently; Tools ▸ Add "Inject DLL" Record pushes a one-off record into the table you have open.  ④ dist\UE5CEDumper.CT — a standalone table; developer fallback.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Inject">Inject into running game…</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Refresh">Refresh</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Deploy">Deploy</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Undeploy">Undeploy</sys:String>
    <sys:String x:Key="str.ProxyDeploy.UpdateAll">Update All</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Force">Force Overwrite</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ForeignOverwrite">Replace other tools' DLLs</sys:String>
    <sys:String x:Key="str.ProxyDeploy.SelectAll">All</sys:String>
    <sys:String x:Key="str.ProxyDeploy.UnselectAll">None</sys:String>
    <sys:String x:Key="str.ProxyDeploy.InvertSel">Invert</sys:String>
    <sys:String x:Key="str.ProxyDeploy.SourceDll">Source DLL:</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColName">Game</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColPath">Binaries Path</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColStatus">Status</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColLoad">Loaded?</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColSuggested">Suggested proxy</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColVersion">Version</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ColError">Error</sys:String>
    <sys:String x:Key="str.ProxyDeploy.SuggestToggle">Suggest proxy</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Source">Source:</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Source.Steam">Steam</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Source.Drives">Scan Drives</sys:String>
    <sys:String x:Key="str.ProxyDeploy.DriveHint">Select drive(s):</sys:String>
    <sys:String x:Key="str.ProxyDeploy.ScanDrives">Scan Drives</sys:String>
    <sys:String x:Key="str.ProxyDeploy.RefreshDrives">Refresh Drives</sys:String>
    <sys:String x:Key="str.ProxyDeploy.CancelScan">Cancel</sys:String>
    <sys:String x:Key="str.ProxyDeploy.CancelOperation">Cancel operation</sys:String>

    <!-- Leftover ("orphan") proxy cleanup. Uninstalling a game leaves its folder behind BECAUSE our
         proxy DLL is a file Steam does not own, so an empty shell survives with our DLL inside it. -->
    <sys:String x:Key="str.ProxyDeploy.Orphans.Header">Leftover proxy DLLs</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.Intro">Uninstalling a game leaves its folder behind when our proxy DLL is still in it — Steam will not delete a file it does not own. This finds those leftovers. Nothing is removed until you check a row and confirm.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.Scan">Find leftovers</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ScanTip">Scans your Steam libraries for folders that hold only our proxy DLL, plus any location our own logs show a proxy was deployed to. Reports only — it never deletes.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.Report">Report…</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ReportTip">Writes a dry-run text file listing exactly what would be removed and what would be left alone, then opens it. Changes nothing on disk.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.Delete">Delete checked ({0})</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.DeleteTip">Moves the checked DLLs to the Recycle Bin, then removes the folders they leave empty. You will see the exact paths first.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.OpenFolder">Open folder</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.NoneFound">No leftover proxy DLLs found.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.FileOnlyNote">Only the DLL is removed — no folders are touched for this row. (See the note below for why.)</sys:String>

    <!-- Confirmation window -->
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmTitle">Remove leftover proxy DLLs?</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmLead">Our DLLs below are moved to the Recycle Bin, so this can be undone from there. Folders are then removed one level at a time and only while each is left completely empty — the moment a folder still holds anything, that folder and everything above it are kept.</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmFilesHeader">Files moved to the Recycle Bin</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmDirsHeader">Folders tried, in this order — each only if it is left empty</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmWhyHeader">Why this is judged a leftover</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmKeptNote">Not touched: {0}</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmYes">Move to Recycle Bin</sys:String>
    <sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmNo">Cancel</sys:String>

