    <!-- Pointer Panel -->
    <sys:String x:Key="str.Pointers.GObjects">GObjects Address</sys:String>
    <sys:String x:Key="str.Pointers.GNames">GNames Address</sys:String>
    <sys:String x:Key="str.Pointers.GWorld">GWorld Address</sys:String>
    <sys:String x:Key="str.Pointers.UEVersion">UE Version</sys:String>
    <sys:String x:Key="str.Pointers.TotalObjects">Total Objects</sys:String>
    <sys:String x:Key="str.Pointers.Copy">Copy</sys:String>
    <sys:String x:Key="str.Pointers.NotConnected">Not connected — connect to view pointers</sys:String>
    <sys:String x:Key="str.Pointers.VersionTooOld">Unsupported engine — UE 4.11 is the oldest this tool can read. UE 4.10 and earlier have no FUObjectItem: the object array holds raw UObjectBase* pointers in an inline chunk table, a layout the dumper cannot express, so the scan was skipped rather than run and fail. If this version was detected wrongly, set a UE version override above and reconnect.</sys:String>
    <!-- Separate from VersionTooOld on purpose: that message's remedy line ("set a UE version
         override") is actively WRONG here. The override list has no value below UE 4.18, and no
         value at any version would help, because the structures being looked for do not exist in
         a pre-UE4 binary at all. Keeping two strings also keeps the 4.10 explanation truthful —
         4.10 is still a live case, with two reference builds in the AOB corpus. -->
    <sys:String x:Key="str.Pointers.EnginePreUE4">Unsupported engine — this game is built on Unreal Engine 3, not UE4/UE5. UE3 has no FUObjectArray and no FUObjectItem at all: its objects live in an UnrealScript-era reflection system whose UObject and FName layouts differ fundamentally, so there is no global object array for this tool to walk. The scan was skipped deliberately rather than run and fail — every pointer being empty is by design here. Extra Scan is disabled because it probes for the same UE4/UE5 structures and cannot find what is absent. Identified from Unreal Engine 3 markers in the executable, with no UE4 or UE5 build tag anywhere in it. If that identification is wrong and this really is UE4/UE5, set a UE version override above and reconnect — an override forces the scan to run anyway.</sys:String>
    <sys:String x:Key="str.Pointers.VersionWarning">&#x26A0; Version not detected — inferred from engine analysis (custom UE build?)</sys:String>
    <sys:String x:Key="str.Pointers.VersionDetectedBadge">&#x2713; Detected</sys:String>
    <sys:String x:Key="str.Pointers.VersionUserOverrideBadge">&#x1F527; User Override</sys:String>
    <sys:String x:Key="str.Pointers.VersionUserOverrideTooltip">UE version was set manually. The override is saved per-game and reapplied on every launch.</sys:String>
    <sys:String x:Key="str.Pointers.VersionLowConfidenceBadge">&#x26A0; Low Confidence</sys:String>
    <sys:String x:Key="str.Pointers.VersionLowConfidenceText">Detected via fragile fallback path — bare pattern match or publisher bias. If exports look wrong, set the correct UE version using the Override ComboBox below.</sys:String>
    <sys:String x:Key="str.Pointers.VersionOverrideLabel">Override:</sys:String>
    <sys:String x:Key="str.Pointers.VersionOverrideTooltip">Force a specific UE version for this game. Saved per-game and reapplied on every launch. Choose Auto to revert to auto-detection.</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutLabel">Invoke timeout (ms):</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutTooltip">UFunction call wait time. Default 5000 = 5s. Increase if "GameThreadDispatch: invoke timeout" appears in logs (Blueprint widget delegates often need 10-30s). Saved per-game; reset to 5000 to clear.</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutOverrideBadge">&#x23F1; Custom</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutOverrideTooltip">Per-game timeout override is active (differs from the 5000ms default).</sys:String>
    <sys:String x:Key="str.Pointers.PublisherLabel">Publisher:</sys:String>
    <sys:String x:Key="str.Pointers.AobFailed">&#x26A0; AOB failed — found via</sys:String>
    <sys:String x:Key="str.Pointers.GWorldNotFound">GWorld not found (non-critical)</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegates">FSparseDelegateStorage</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegatesOptional">Optional (UE 4.23+) &#x2014; powers MulticastSparseDelegateProperty drill-down + Find Refs sparse coverage</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegatesNotFound">AOB not found &#x2014; sparse delegate drill-down disabled. Bound flag still surfaces; full bindings unavailable.</sys:String>
    <sys:String x:Key="str.Pointers.GEngine">&amp;GEngine (engine slot)</sys:String>
    <sys:String x:Key="str.Pointers.GEngineOptional">Optional &#x2014; the static slot holding UEngine*. Lets engine lookups skip the object-pool walk, and lets a GameEngine-rooted CE record survive a restart.</sys:String>
    <sys:String x:Key="str.Pointers.GEngineNotFound">AOB not found &#x2014; engine lookups fall back to scanning GObjects (slower), and GameEngine-rooted CE exports stay address-only.</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegatesUnsupported">UE &#x003C; 4.23 &#x2014; sparse delegates do not exist in this engine version (introduced in 4.23), so there is nothing to find. Not a limitation of this tool.</sys:String>
    <sys:String x:Key="str.Pointers.PatternIdTooltip">AOB pattern ID that matched this pointer</sys:String>
    <sys:String x:Key="str.Pointers.AobAllFailed">&#x1F534; All AOB patterns failed</sys:String>
    <sys:String x:Key="str.Pointers.ExtraScan">Extra Scan</sys:String>
    <sys:String x:Key="str.Pointers.ExtraScanHint">Some pointers not found. Try aggressive scanning techniques (5-20 seconds).</sys:String>
    <sys:String x:Key="str.Pointers.AobMakerHex">HEX</sys:String>
    <sys:String x:Key="str.Pointers.AobMakerHexTip">Navigate CE hex view to pointer address (via AOBMaker CE Plugin)</sys:String>
    <sys:String x:Key="str.Pointers.AobMakerAsm">ASM</sys:String>
    <sys:String x:Key="str.Pointers.AobMakerScanAsmTip">Navigate CE disassembler to AOB scan hit instruction (via AOBMaker CE Plugin)</sys:String>
    <sys:String x:Key="str.Pointers.RegisterSymbol">SYM</sys:String>
    <sys:String x:Key="str.Pointers.RegisterSymbolTip">Create CE AA Script that registers GWorld address as 'gworld_addr' symbol (via AOBMaker CE Plugin)</sys:String>
    <sys:String x:Key="str.Pointers.RegisterGEngineSymbolTip">Create CE AA Script that registers the &amp;GEngine SLOT as 'gengine_addr' symbol — the slot is restart-stable, so a GameEngine-rooted record auto-follows engine recreation (via AOBMaker CE Plugin)</sys:String>
