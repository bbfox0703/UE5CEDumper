    <sys:String x:Key="str.IF.GameplayActions">Gameplay Actions</sys:String>
    <sys:String x:Key="str.IF.CallableOnly">BP/Exec only</sys:String>
    <sys:String x:Key="str.IF.ClearFilters">Clear</sys:String>
    <sys:String x:Key="str.IF.OpenInst">inst</sys:String>
    <sys:String x:Key="str.IF.Props">Props</sys:String>
