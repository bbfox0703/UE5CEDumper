    <!-- N1: per-game class denylist (noise picker) — shared by SPC + Diff -->
    <sys:String x:Key="str.Noise.PanelHeader">Noise picker — top classes in this result</sys:String>
    <sys:String x:Key="str.Noise.PanelHint">Tick classes whose hits you consider noise (UI widgets, animation, tick state). Apply adds them to this game's denylist and re-runs the query. The denylist also filters Snapshot Diff and the Class Pivot picker.</sys:String>
