<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UE5DumpUI"
             x:Class="UE5DumpUI.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Global density: the Fluent Expander header defaults to a tall 48px bar that
             wastes vertical space above every collapsible panel (Snapshot / SPC / Pivot /
             Value Search / Teleport …). The header ToggleButton TemplateBinds its MinHeight
             to the Expander's own MinHeight (default resource ExpanderMinHeight = 48), so an
             app-level Expander style overrides the Fluent control-theme setter and compacts
             ALL expander headers consistently. Also trim the header's left padding (16 → 10). -->
        <Style Selector="Expander">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Padding" Value="10,0,0,0"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Strings/en.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- [AOBM-UI-FUNC-VISUAL] The AOBMaker app's colour. The toolbar's "UI" label and the controls that call
                 AOBMaker.UI share it, so a user can tell them from the ones that need only the CE plugin. Pink because
                 no other colour in the app means anything by it. -->
            <SolidColorBrush x:Key="AobMakerUiAccent" Color="#F78FB3"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
